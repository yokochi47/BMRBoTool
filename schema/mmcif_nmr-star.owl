   <owl:DatatypeProperty rdf:ID="chem_shift_anisotropy.val_units">
      <rdfs:subPropertyOf rdf:resource="#chem_shift_anisotropyItem"/>
      <rdfs:domain rdf:resource="#chem_shift_anisotropy"/>
      <rdfs:range>
         <owl:DataRange>
            <owl:oneOf>
               <rdf:List>
                  <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ppm</rdf:first>
                  <rdf:rest>
                     <rdf:List>
                        <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ppb</rdf:first>
                        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                     </rdf:List>
                  </rdf:rest>
               </rdf:List>
            </owl:oneOf>
         </owl:DataRange>
      </rdfs:range>
      <rdfs:comment xml:lang="en">

Provide the units used for the chemical shift anisotropy values reported.

ppm
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Chem_shift_anisotropy.Val_units"/>
   </owl:DatatypeProperty>
