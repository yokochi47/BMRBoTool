      <rdfs:subPropertyOf rdf:resource="#constraint_stat_listItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>constraint_stat_list.text_data</rdfs:label>
      <rdfs:comment xml:lang="en">

A set of constraint statistics data formatted as ASCII text.
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Constraint_stat_list.Text_data"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="constraint_stat_list.text_data_format">
      <rdfs:subPropertyOf rdf:resource="#constraint_stat_listItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>constraint_stat_list.text_data_format</rdfs:label>
      <rdfs:comment xml:lang="en">

The data format used to represent the constraint statistical data as ASCII
