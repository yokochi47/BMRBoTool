   <owl:DatatypeProperty rdf:ID="auto_relaxation_list.sf_category">
      <rdfs:subPropertyOf rdf:resource="#auto_relaxation_listItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>auto_relaxation_list.sf_category</rdfs:label>
      <rdfs:comment xml:lang="en">

Category definition for the information content of the saveframe
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Auto_relaxation_list.Sf_category"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="auto_relaxation_list.sf_framecode">
      <rdfs:subPropertyOf rdf:resource="#auto_relaxation_listItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>auto_relaxation_list.sf_framecode</rdfs:label>
      <rdfs:comment xml:lang="en">

A label for the saveframe that describes in very brief terms the information
contained in the saveframe.
                        </rdfs:comment>
