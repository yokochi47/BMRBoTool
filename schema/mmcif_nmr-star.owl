Pointer to '_Conformer_family_coord_set.ID'
                     </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Atom_sites_footnote.Conformer_family_coord_set_ID"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="atom_sites_footnote.entry_id">
      <rdfs:subPropertyOf rdf:resource="#atom_sites_footnoteItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>atom_sites_footnote.entry_id</rdfs:label>
      <rdfs:comment xml:lang="en">

Pointer to '_Entry.ID'
                     </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Atom_sites_footnote.Entry_ID"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="atom_sites_footnote.footnote_id">
      <rdfs:subPropertyOf rdf:resource="#atom_sites_footnoteItem"/>
