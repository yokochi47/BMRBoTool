   <owl:DatatypeProperty rdf:ID="chem_comp.vendor">
      <rdfs:subPropertyOf rdf:resource="#chem_compItem"/>
      <rdfs:domain rdf:resource="#chem_comp"/>
      <rdfs:range>
         <owl:DataRange>
            <owl:oneOf>
               <rdf:List>
                  <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Sigma</rdf:first>
                  <rdf:rest>
                     <rdf:List>
                        <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Aldrich</rdf:first>
                        <rdf:rest>
