               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#theoretical_heteronucl_t2_software.software_label"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#theoretical_heteronucl_t2_software.entry_id"/>
