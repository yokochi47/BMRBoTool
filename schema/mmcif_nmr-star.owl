                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Atom_sites_footnote.Text"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="atom_sites_footnote.conformer_family_coord_set_id">
