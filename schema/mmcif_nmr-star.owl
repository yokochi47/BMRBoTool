      <rdfs:comment xml:lang="en">

Name for a solid-state recoupling pulse sequence.
                     </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Recoupling_pulse_sequence.Name"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="recoupling_pulse_sequence.nmr_spec_expt_id">
      <rdfs:subPropertyOf rdf:resource="#recoupling_pulse_sequenceItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
      <rdfs:label>recoupling_pulse_sequence.nmr_spec_expt_id</rdfs:label>
      <rdfs:comment xml:lang="en">

Pointer to '_NMR_spec_expt.ID'
                     </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Recoupling_pulse_sequence.NMR_spec_expt_ID"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="recoupling_pulse_sequence.time_period">
      <rdfs:subPropertyOf rdf:resource="#recoupling_pulse_sequenceItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>recoupling_pulse_sequence.time_period</rdfs:label>
      <rdfs:comment xml:lang="en">

Specific time period during the full pulse sequence where the recoupling
pulse sequence is applied.
                     </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Recoupling_pulse_sequence.Time_period"/>
   </owl:DatatypeProperty>
   <owl:Class rdf:ID="related_entriesCategory">
      <rdfs:subClassOf>
         <owl:Class>
            <owl:intersectionOf rdf:parseType="Collection">
               <owl:Class rdf:about="#Category"/>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#has_related_entries"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
            </owl:intersectionOf>
         </owl:Class>
      </rdfs:subClassOf>
   </owl:Class>
   <owl:Class rdf:ID="related_entries">
      <rdfs:label>related_entries</rdfs:label>
      <rdfs:comment xml:lang="en">

Items in the related_entries category provide a list of entries that are related to the present entry. The related entries may or may not be members of a study that includes the present entry.

         </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tag.php?tagcat=Related_entries"/>
      <rdfs:subClassOf>
         <owl:Class>
            <owl:intersectionOf rdf:parseType="Collection">
               <owl:Class rdf:about="#CategoryElement"/>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#related_entries.relationship"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#related_entries.relationship"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#related_entries.database_accession_code"/>
                  <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#related_entries.database_name"/>
                  <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#related_entries.entry_id"/>
                  <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
               </owl:Restriction>
            </owl:intersectionOf>
         </owl:Class>
      </rdfs:subClassOf>
   </owl:Class>
   <owl:InverseFunctionalProperty rdf:ID="has_related_entriesCategory">
      <rdfs:label>related_entriesCategory</rdfs:label>
      <rdfs:comment xml:lang="en">
	This property indicates that datablock
	has a category holder related_entriesCategory.
      </rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#hasCategory"/>
      <rdfs:seeAlso rdf:resource="#related_entries"/>
   </owl:InverseFunctionalProperty>
   <owl:InverseFunctionalProperty rdf:ID="has_related_entries">
      <rdfs:label>related_entriesCategory</rdfs:label>
      <rdfs:comment xml:lang="en">
	This property indicates that related_entriesCategory.
	has a category related_entries.
      </rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#hasCategoryElement"/>
      <rdfs:seeAlso rdf:resource="#related_entries"/>
      <rdfs:domain rdf:resource="#related_entriesCategory"/>
      <rdfs:range rdf:resource="#related_entries"/>
   </owl:InverseFunctionalProperty>
   <owl:DatatypeProperty rdf:ID="related_entriesItem">
      <rdfs:label>related_entriesItem</rdfs:label>
      <rdfs:comment xml:lang="en">Abstract datatype property for related_entries items.</rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#categoryItem"/>
      <rdfs:domain rdf:resource="#related_entries"/>
   </owl:DatatypeProperty>
   <owl:ObjectProperty rdf:ID="reference_to_related_entries">
      <rdfs:label>reference_to_related_entries</rdfs:label>
      <rdfs:comment xml:lang="en">cross-reference to related_entries.</rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#reference_to"/>
      <rdfs:domain rdf:resource="#related_entries"/>
   </owl:ObjectProperty>
   <owl:ObjectProperty rdf:ID="referenced_by_related_entries">
      <rdfs:label>referenced_by_related_entries</rdfs:label>
      <rdfs:comment xml:lang="en">cross-reference from related_entries.</rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#referenced_by"/>
      <rdfs:range rdf:resource="#related_entries"/>
   </owl:ObjectProperty>
   <owl:DatatypeProperty rdf:ID="related_entries.relationship">
      <rdfs:subPropertyOf rdf:resource="#related_entriesItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>related_entries.relationship</rdfs:label>
      <rdfs:comment xml:lang="en">

Text describing the relationship between the current BMRB entry and the
entry with the corresponding BMRB accession number given as a value to the tag
'_Related_BMRB_accession_number.'

Entry containing coupling constants for this molecular system.
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Related_entries.Relationship"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="related_entries.database_accession_code">
      <rdfs:subPropertyOf rdf:resource="#related_entriesItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>related_entries.database_accession_code</rdfs:label>
      <rdfs:comment xml:lang="en">

Entry code for an existing entry from the database defined by the tag '_Related_entry.Database_name'
that is related to the current BMRB entry.

4038; 1brv
                     </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Related_entries.Database_accession_code"/>
      <owl:equivalentProperty rdf:resource="PDBo:database_2.database_code"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="related_entries.database_name">
      <rdfs:subPropertyOf rdf:resource="#related_entriesItem"/>
      <rdfs:domain rdf:resource="#related_entries"/>
      <rdfs:range>
         <owl:DataRange>
            <owl:oneOf>
               <rdf:List>
                  <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">BMRB</rdf:first>
                  <rdf:rest>
                     <rdf:List>
                        <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">BMRB(withdrawn)</rdf:first>
                        <rdf:rest>
                           <rdf:List>
                              <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PDB</rdf:first>
                              <rdf:rest>
                                 <rdf:List>
                                    <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TargetDB</rdf:first>
                                    <rdf:rest>
                                       <rdf:List>
                                          <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EMDB</rdf:first>
                                          <rdf:rest>
                                             <rdf:List>
                                                <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">BMCD</rdf:first>
                                                <rdf:rest>
                                                   <rdf:List>
                                                      <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">GB</rdf:first>
                                                      <rdf:rest>
                                                         <rdf:List>
                                                            <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DBJ</rdf:first>
                                                            <rdf:rest>
                                                               <rdf:List>
                                                                  <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EMBL</rdf:first>
                                                                  <rdf:rest>
                                                                     <rdf:List>
                                                                        <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NCBI</rdf:first>
                                                                        <rdf:rest>
                                                                           <rdf:List>
                                                                              <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PIR</rdf:first>
                                                                              <rdf:rest>
                                                                                 <rdf:List>
                                                                                    <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">REF</rdf:first>
                                                                                    <rdf:rest>
                                                                                       <rdf:List>
                                                                                          <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SGD</rdf:first>
                                                                                          <rdf:rest>
                                                                                             <rdf:List>
                                                                                                <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SP</rdf:first>
                                                                                                <rdf:rest>
                                                                                                   <rdf:List>
                                                                                                      <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Pfam</rdf:first>
                                                                                                      <rdf:rest>
                                                                                                         <rdf:List>
                                                                                                            <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">InterPro</rdf:first>
                                                                                                            <rdf:rest>
                                                                                                               <rdf:List>
                                                                                                                  <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Taxonomy</rdf:first>
                                                                                                                  <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                                                                                               </rdf:List>
                                                                                                            </rdf:rest>
                                                                                                         </rdf:List>
                                                                                                      </rdf:rest>
                                                                                                   </rdf:List>
                                                                                                </rdf:rest>
                                                                                             </rdf:List>
                                                                                          </rdf:rest>
                                                                                       </rdf:List>
                                                                                    </rdf:rest>
                                                                                 </rdf:List>
                                                                              </rdf:rest>
                                                                           </rdf:List>
                                                                        </rdf:rest>
                                                                     </rdf:List>
                                                                  </rdf:rest>
                                                               </rdf:List>
                                                            </rdf:rest>
                                                         </rdf:List>
                                                      </rdf:rest>
                                                   </rdf:List>
                                                </rdf:rest>
                                             </rdf:List>
                                          </rdf:rest>
                                       </rdf:List>
                                    </rdf:rest>
                                 </rdf:List>
                              </rdf:rest>
                           </rdf:List>
                        </rdf:rest>
                     </rdf:List>
                  </rdf:rest>
               </rdf:List>
            </owl:oneOf>
         </owl:DataRange>
      </rdfs:range>
      <rdfs:comment xml:lang="en">

Name or acronym for a database that has an entry related to the current
BMRB entry.

BMRB; PDB
                     </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Related_entries.Database_name"/>
      <owl:equivalentProperty rdf:resource="PDBo:database_2.database_id"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="related_entries.entry_id">
      <rdfs:subPropertyOf rdf:resource="#related_entriesItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>related_entries.entry_id</rdfs:label>
      <rdfs:comment xml:lang="en">

Pointer to '_Entry.ID'
                     </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Related_entries.Entry_ID"/>
   </owl:DatatypeProperty>
   <owl:Class rdf:ID="releaseCategory">
      <rdfs:subClassOf>
         <owl:Class>
