   <owl:DatatypeProperty rdf:ID="chem_shifts_calc_type.calculation_level">
      <rdfs:subPropertyOf rdf:resource="#chem_shifts_calc_typeItem"/>
      <rdfs:domain rdf:resource="#chem_shifts_calc_type"/>
      <rdfs:range>
         <owl:DataRange>
            <owl:oneOf>
               <rdf:List>
                  <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">empirical</rdf:first>
                  <rdf:rest>
                     <rdf:List>
                        <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ab initio</rdf:first>
                        <rdf:rest>
                           <rdf:List>
                              <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">semi-empirical</rdf:first>
                              <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                           </rdf:List>
                        </rdf:rest>
                     </rdf:List>
                  </rdf:rest>
               </rdf:List>
            </owl:oneOf>
         </owl:DataRange>
      </rdfs:range>
      <rdfs:comment xml:lang="en">

The level of theory applied in calculating theoretical chemical shifts
or chemical shift tensors (not shielding tensors).

empirical; ab initio; semi-empirical
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Chem_shifts_calc_type.Calculation_level"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="chem_shifts_calc_type.chem_shift_nucleus">
      <rdfs:subPropertyOf rdf:resource="#chem_shifts_calc_typeItem"/>
      <rdfs:domain rdf:resource="#chem_shifts_calc_type"/>
      <rdfs:range>
         <owl:DataRange>
            <owl:oneOf>
               <rdf:List>
                  <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1H</rdf:first>
                  <rdf:rest>
                     <rdf:List>
                        <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">13C</rdf:first>
                        <rdf:rest>
                           <rdf:List>
                              <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">15N</rdf:first>
                              <rdf:rest>
                                 <rdf:List>
                                    <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">31P</rdf:first>
                                    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                 </rdf:List>
                              </rdf:rest>
                           </rdf:List>
                        </rdf:rest>
                     </rdf:List>
                  </rdf:rest>
               </rdf:List>
            </owl:oneOf>
         </owl:DataRange>
      </rdfs:range>
      <rdfs:comment xml:lang="en">

The nucleus for which the chemical shifts were calaculated.

13C
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Chem_shifts_calc_type.Chem_shift_nucleus"/>
   </owl:DatatypeProperty>
