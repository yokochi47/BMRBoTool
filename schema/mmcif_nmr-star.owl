   <owl:DatatypeProperty rdf:ID="tertiary_struct.assembly_atom_id">
      <rdfs:subPropertyOf rdf:resource="#tertiary_structItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
