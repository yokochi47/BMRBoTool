      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
      <rdfs:label>chem_comp.number_atoms_all</rdfs:label>
      <rdfs:comment xml:lang="en">

The total number of atoms in the component.
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Chem_comp.Number_atoms_all"/>
      <owl:equivalentProperty rdf:resource="PDBo:chem_comp.number_atoms_all"/>
   </owl:DatatypeProperty>
