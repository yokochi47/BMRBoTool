      <rdfs:comment xml:lang="en">
	This property indicates that historyCategory.
	has a category history.
      </rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#hasCategoryElement"/>
      <rdfs:seeAlso rdf:resource="#history"/>
      <rdfs:domain rdf:resource="#historyCategory"/>
      <rdfs:range rdf:resource="#history"/>
   </owl:InverseFunctionalProperty>
   <owl:DatatypeProperty rdf:ID="historyItem">
      <rdfs:label>historyItem</rdfs:label>
      <rdfs:comment xml:lang="en">Abstract datatype property for history items.</rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#categoryItem"/>
      <rdfs:domain rdf:resource="#history"/>
   </owl:DatatypeProperty>
   <owl:ObjectProperty rdf:ID="reference_to_history">
      <rdfs:label>reference_to_history</rdfs:label>
      <rdfs:comment xml:lang="en">cross-reference to history.</rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#reference_to"/>
      <rdfs:domain rdf:resource="#history"/>
   </owl:ObjectProperty>
   <owl:ObjectProperty rdf:ID="referenced_by_history">
      <rdfs:label>referenced_by_history</rdfs:label>
      <rdfs:comment xml:lang="en">cross-reference from history.</rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#referenced_by"/>
      <rdfs:range rdf:resource="#history"/>
   </owl:ObjectProperty>
   <owl:DatatypeProperty rdf:ID="history.method_id">
