   <owl:InverseFunctionalProperty rdf:ID="has_sampleCategory">
      <rdfs:label>sampleCategory</rdfs:label>
      <rdfs:comment xml:lang="en">
	This property indicates that datablock
	has a category holder sampleCategory.
      </rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#hasCategory"/>
      <rdfs:seeAlso rdf:resource="#sample"/>
   </owl:InverseFunctionalProperty>
   <owl:InverseFunctionalProperty rdf:ID="has_sample">
      <rdfs:label>sampleCategory</rdfs:label>
      <rdfs:comment xml:lang="en">
	This property indicates that sampleCategory.
	has a category sample.
      </rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#hasCategoryElement"/>
      <rdfs:seeAlso rdf:resource="#sample"/>
      <rdfs:domain rdf:resource="#sampleCategory"/>
      <rdfs:range rdf:resource="#sample"/>
   </owl:InverseFunctionalProperty>
