               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#release.date"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#release.date"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#release.detail"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#release.detail"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#release.format_type"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#release.format_type"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#release.format_version"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#release.format_version"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#release.submission_date"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#release.submission_date"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#release.type"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#release.type"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#release.entry_id"/>
                  <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#release.release_number"/>
                  <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
               </owl:Restriction>
            </owl:intersectionOf>
         </owl:Class>
      </rdfs:subClassOf>
   </owl:Class>
   <owl:InverseFunctionalProperty rdf:ID="has_releaseCategory">
      <rdfs:label>releaseCategory</rdfs:label>
      <rdfs:comment xml:lang="en">
	This property indicates that datablock
	has a category holder releaseCategory.
      </rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#hasCategory"/>
      <rdfs:seeAlso rdf:resource="#release"/>
   </owl:InverseFunctionalProperty>
   <owl:InverseFunctionalProperty rdf:ID="has_release">
      <rdfs:label>releaseCategory</rdfs:label>
      <rdfs:comment xml:lang="en">
	This property indicates that releaseCategory.
	has a category release.
      </rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#hasCategoryElement"/>
      <rdfs:seeAlso rdf:resource="#release"/>
      <rdfs:domain rdf:resource="#releaseCategory"/>
      <rdfs:range rdf:resource="#release"/>
   </owl:InverseFunctionalProperty>
   <owl:DatatypeProperty rdf:ID="releaseItem">
      <rdfs:label>releaseItem</rdfs:label>
      <rdfs:comment xml:lang="en">Abstract datatype property for release items.</rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#categoryItem"/>
      <rdfs:domain rdf:resource="#release"/>
   </owl:DatatypeProperty>
   <owl:ObjectProperty rdf:ID="reference_to_release">
      <rdfs:label>reference_to_release</rdfs:label>
      <rdfs:comment xml:lang="en">cross-reference to release.</rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#reference_to"/>
      <rdfs:domain rdf:resource="#release"/>
   </owl:ObjectProperty>
   <owl:ObjectProperty rdf:ID="referenced_by_release">
      <rdfs:label>referenced_by_release</rdfs:label>
      <rdfs:comment xml:lang="en">cross-reference from release.</rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#referenced_by"/>
      <rdfs:range rdf:resource="#release"/>
   </owl:ObjectProperty>
   <owl:DatatypeProperty rdf:ID="release.author">
      <rdfs:subPropertyOf rdf:resource="#releaseItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>release.author</rdfs:label>
      <rdfs:comment xml:lang="en">

A keyword indicating the type of author of the release.

author
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Release.Author"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="release.date">
      <rdfs:subPropertyOf rdf:resource="#releaseItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
      <rdfs:label>release.date</rdfs:label>
      <rdfs:comment xml:lang="en">

Date entry was released.

2004-02-29
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Release.Date"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="release.detail">
      <rdfs:subPropertyOf rdf:resource="#releaseItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>release.detail</rdfs:label>
      <rdfs:comment xml:lang="en">

Text describing the changes made to the entry.

Oringinal entry release
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Release.Detail"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="release.format_type">
      <rdfs:subPropertyOf rdf:resource="#releaseItem"/>
      <rdfs:domain rdf:resource="#release"/>
      <rdfs:range>
         <owl:DataRange>
            <owl:oneOf>
               <rdf:List>
                  <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NMR-STAR</rdf:first>
                  <rdf:rest>
                     <rdf:List>
                        <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">XML</rdf:first>
                        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                     </rdf:List>
                  </rdf:rest>
               </rdf:List>
            </owl:oneOf>
         </owl:DataRange>
      </rdfs:range>
      <rdfs:comment xml:lang="en">

The format of the file that the entry is in when released.
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Release.Format_type"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="release.format_version">
      <rdfs:subPropertyOf rdf:resource="#releaseItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>release.format_version</rdfs:label>
      <rdfs:comment xml:lang="en">

The version assigned to the format of the file that the entry is in at
the tiem of release.
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Release.Format_version"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="release.submission_date">
      <rdfs:subPropertyOf rdf:resource="#releaseItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
      <rdfs:label>release.submission_date</rdfs:label>
      <rdfs:comment xml:lang="en">

Date the entry or an update to the entry was submitted to BMRB.

2004-02-29
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Release.Submission_date"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="release.type">
      <rdfs:subPropertyOf rdf:resource="#releaseItem"/>
      <rdfs:domain rdf:resource="#release"/>
      <rdfs:range>
         <owl:DataRange>
            <owl:oneOf>
               <rdf:List>
                  <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">original</rdf:first>
                  <rdf:rest>
                     <rdf:List>
                        <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">na</rdf:first>
                        <rdf:rest>
                           <rdf:List>
                              <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">update</rdf:first>
                              <rdf:rest>
                                 <rdf:List>
                                    <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">revision</rdf:first>
                                    <rdf:rest>
                                       <rdf:List>
                                          <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">reformat</rdf:first>
                                          <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                       </rdf:List>
                                    </rdf:rest>
                                 </rdf:List>
                              </rdf:rest>
                           </rdf:List>
                        </rdf:rest>
                     </rdf:List>
                  </rdf:rest>
               </rdf:List>
            </owl:oneOf>
         </owl:DataRange>
      </rdfs:range>
      <rdfs:comment xml:lang="en">

Value describing with a key word the type of entry that was released.

original
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Release.Type"/>
