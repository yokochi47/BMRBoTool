   <owl:DatatypeProperty rdf:ID="theoretical_auto_relaxation_list.exact_field_strength">
      <rdfs:subPropertyOf rdf:resource="#theoretical_auto_relaxation_listItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
      <rdfs:label>theoretical_auto_relaxation_list.exact_field_strength</rdfs:label>
      <rdfs:comment xml:lang="en">

The actual spectrometer frequency of the nucleus observed expressed at
a high level of precision.

60.777824
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Theoretical_auto_relaxation_list.Exact_field_strength"/>
   </owl:DatatypeProperty>
