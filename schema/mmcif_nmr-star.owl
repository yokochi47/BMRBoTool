   <owl:DatatypeProperty rdf:ID="sample_component.concentration_val_units">
      <rdfs:subPropertyOf rdf:resource="#sample_componentItem"/>
      <rdfs:domain rdf:resource="#sample_component"/>
      <rdfs:range>
         <owl:DataRange>
            <owl:oneOf>
               <rdf:List>
                  <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">M</rdf:first>
                  <rdf:rest>
                     <rdf:List>
                        <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">mM</rdf:first>
                        <rdf:rest>
                           <rdf:List>
                              <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">uM</rdf:first>
                              <rdf:rest>
                                 <rdf:List>
                                    <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">nM</rdf:first>
                                    <rdf:rest>
                                       <rdf:List>
                                          <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">%</rdf:first>
                                          <rdf:rest>
                                             <rdf:List>
                                                <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">v/v</rdf:first>
                                                <rdf:rest>
                                                   <rdf:List>
                                                      <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">w/v</rdf:first>
                                                      <rdf:rest>
                                                         <rdf:List>
                                                            <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">mg</rdf:first>
                                                            <rdf:rest>
                                                               <rdf:List>
                                                                  <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ug</rdf:first>
                                                                  <rdf:rest>
                                                                     <rdf:List>
                                                                        <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">mg/mL</rdf:first>
                                                                        <rdf:rest>
                                                                           <rdf:List>
                                                                              <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">g/L</rdf:first>
                                                                              <rdf:rest>
                                                                                 <rdf:List>
                                                                                    <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">pM</rdf:first>
                                                                                    <rdf:rest>
                                                                                       <rdf:List>
                                                                                          <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">w/w</rdf:first>
                                                                                          <rdf:rest>
                                                                                             <rdf:List>
                                                                                                <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">% v/v</rdf:first>
                                                                                                <rdf:rest>
                                                                                                   <rdf:List>
                                                                                                      <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">% w/v</rdf:first>
                                                                                                      <rdf:rest>
                                                                                                         <rdf:List>
                                                                                                            <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">% w/w</rdf:first>
                                                                                                            <rdf:rest>
                                                                                                               <rdf:List>
                                                                                                                  <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">mg/L</rdf:first>
                                                                                                                  <rdf:rest>
                                                                                                                     <rdf:List>
                                                                                                                        <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">mg/uL</rdf:first>
                                                                                                                        <rdf:rest>
                                                                                                                           <rdf:List>
                                                                                                                              <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ug/mL</rdf:first>
                                                                                                                              <rdf:rest>
                                                                                                                                 <rdf:List>
                                                                                                                                    <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ug/uL</rdf:first>
                                                                                                                                    <rdf:rest>
                                                                                                                                       <rdf:List>
                                                                                                                                          <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">mL</rdf:first>
                                                                                                                                          <rdf:rest>
                                                                                                                                             <rdf:List>
                                                                                                                                                <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">uL</rdf:first>
                                                                                                                                                <rdf:rest>
                                                                                                                                                   <rdf:List>
                                                                                                                                                      <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A260</rdf:first>
                                                                                                                                                      <rdf:rest>
                                                                                                                                                         <rdf:List>
                                                                                                                                                            <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">eq</rdf:first>
                                                                                                                                                            <rdf:rest>
                                                                                                                                                               <rdf:List>
                                                                                                                                                                  <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ratio</rdf:first>
                                                                                                                                                                  <rdf:rest>
                                                                                                                                                                     <rdf:List>
                                                                                                                                                                        <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">saturated</rdf:first>
                                                                                                                                                                        <rdf:rest>
                                                                                                                                                                           <rdf:List>
                                                                                                                                                                              <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">tablet/100mL</rdf:first>
                                                                                                                                                                              <rdf:rest>
                                                                                                                                                                                 <rdf:List>
                                                                                                                                                                                    <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">na</rdf:first>
                                                                                                                                                                                    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                                                                                                                                                                 </rdf:List>
                                                                                                                                                                              </rdf:rest>
                                                                                                                                                                           </rdf:List>
                                                                                                                                                                        </rdf:rest>
                                                                                                                                                                     </rdf:List>
                                                                                                                                                                  </rdf:rest>
                                                                                                                                                               </rdf:List>
                                                                                                                                                            </rdf:rest>
                                                                                                                                                         </rdf:List>
                                                                                                                                                      </rdf:rest>
                                                                                                                                                   </rdf:List>
                                                                                                                                                </rdf:rest>
                                                                                                                                             </rdf:List>
                                                                                                                                          </rdf:rest>
                                                                                                                                       </rdf:List>
                                                                                                                                    </rdf:rest>
                                                                                                                                 </rdf:List>
                                                                                                                              </rdf:rest>
                                                                                                                           </rdf:List>
                                                                                                                        </rdf:rest>
                                                                                                                     </rdf:List>
                                                                                                                  </rdf:rest>
                                                                                                               </rdf:List>
                                                                                                            </rdf:rest>
                                                                                                         </rdf:List>
                                                                                                      </rdf:rest>
                                                                                                   </rdf:List>
                                                                                                </rdf:rest>
                                                                                             </rdf:List>
                                                                                          </rdf:rest>
                                                                                       </rdf:List>
                                                                                    </rdf:rest>
                                                                                 </rdf:List>
                                                                              </rdf:rest>
                                                                           </rdf:List>
                                                                        </rdf:rest>
                                                                     </rdf:List>
                                                                  </rdf:rest>
                                                               </rdf:List>
                                                            </rdf:rest>
                                                         </rdf:List>
                                                      </rdf:rest>
                                                   </rdf:List>
                                                </rdf:rest>
                                             </rdf:List>
                                          </rdf:rest>
                                       </rdf:List>
                                    </rdf:rest>
                                 </rdf:List>
                              </rdf:rest>
                           </rdf:List>
                        </rdf:rest>
                     </rdf:List>
                  </rdf:rest>
               </rdf:List>
            </owl:oneOf>
         </owl:DataRange>
      </rdfs:range>
      <rdfs:comment xml:lang="en">

Units used to express the concentration of the sample component.

millimolar
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Sample_component.Concentration_val_units"/>
      <owl:equivalentProperty rdf:resource="PDBo:pdbx_nmr_exptl_sample.concentration_units"/>
   </owl:DatatypeProperty>
