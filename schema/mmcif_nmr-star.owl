   <owl:InverseFunctionalProperty rdf:ID="has_dist_constraintCategory">
      <rdfs:label>dist_constraintCategory</rdfs:label>
      <rdfs:comment xml:lang="en">
	This property indicates that datablock
	has a category holder dist_constraintCategory.
      </rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#hasCategory"/>
      <rdfs:seeAlso rdf:resource="#dist_constraint"/>
   </owl:InverseFunctionalProperty>
   <owl:InverseFunctionalProperty rdf:ID="has_dist_constraint">
      <rdfs:label>dist_constraintCategory</rdfs:label>
      <rdfs:comment xml:lang="en">
	This property indicates that dist_constraintCategory.
	has a category dist_constraint.
      </rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#hasCategoryElement"/>
      <rdfs:seeAlso rdf:resource="#dist_constraint"/>
      <rdfs:domain rdf:resource="#dist_constraintCategory"/>
      <rdfs:range rdf:resource="#dist_constraint"/>
   </owl:InverseFunctionalProperty>
   <owl:DatatypeProperty rdf:ID="dist_constraintItem">
      <rdfs:label>dist_constraintItem</rdfs:label>
      <rdfs:comment xml:lang="en">Abstract datatype property for dist_constraint items.</rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#categoryItem"/>
      <rdfs:domain rdf:resource="#dist_constraint"/>
   </owl:DatatypeProperty>
