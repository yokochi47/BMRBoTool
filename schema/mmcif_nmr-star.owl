The number of the spectral dimension where the parameter value is applied.
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Spectral_acq_param.Spectral_dim"/>
   </owl:DatatypeProperty>
