   <owl:DatatypeProperty rdf:ID="chem_comp_systematic_name.name">
      <rdfs:subPropertyOf rdf:resource="#chem_comp_systematic_nameItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>chem_comp_systematic_name.name</rdfs:label>
      <rdfs:comment xml:lang="en">

A name for the chemical compound that has been defined by an official body
or is derived from rules defined by an official organization recognized by the
scientific community.
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Chem_comp_systematic_name.Name"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="chem_comp_systematic_name.comp_id">
      <rdfs:subPropertyOf rdf:resource="#chem_comp_systematic_nameItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>chem_comp_systematic_name.comp_id</rdfs:label>
      <rdfs:comment xml:lang="en">

Pointer to '_Chem_comp.ID'
                     </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Chem_comp_systematic_name.Comp_ID"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="chem_comp_systematic_name.entry_id">
      <rdfs:subPropertyOf rdf:resource="#chem_comp_systematic_nameItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>chem_comp_systematic_name.entry_id</rdfs:label>
      <rdfs:comment xml:lang="en">

Pointer to '_Entry.ID'
                     </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Chem_comp_systematic_name.Entry_ID"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="chem_comp_systematic_name.naming_system">
      <rdfs:subPropertyOf rdf:resource="#chem_comp_systematic_nameItem"/>
      <rdfs:domain rdf:resource="#chem_comp_systematic_name"/>
      <rdfs:range>
         <owl:DataRange>
            <owl:oneOf>
               <rdf:List>
                  <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IUPAC</rdf:first>
                  <rdf:rest>
                     <rdf:List>
                        <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CAS name</rdf:first>
                        <rdf:rest>
                           <rdf:List>
                              <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CAS registry number</rdf:first>
                              <rdf:rest>
                                 <rdf:List>
                                    <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">BMRB</rdf:first>
                                    <rdf:rest>
                                       <rdf:List>
                                          <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">One letter code</rdf:first>
                                          <rdf:rest>
                                             <rdf:List>
                                                <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Three letter code</rdf:first>
                                                <rdf:rest>
                                                   <rdf:List>
                                                      <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Beilstein</rdf:first>
                                                      <rdf:rest>
                                                         <rdf:List>
                                                            <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Lignin abbreviation</rdf:first>
                                                            <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                                         </rdf:List>
                                                      </rdf:rest>
                                                   </rdf:List>
                                                </rdf:rest>
                                             </rdf:List>
                                          </rdf:rest>
                                       </rdf:List>
                                    </rdf:rest>
                                 </rdf:List>
                              </rdf:rest>
                           </rdf:List>
                        </rdf:rest>
                     </rdf:List>
                  </rdf:rest>
               </rdf:List>
            </owl:oneOf>
         </owl:DataRange>
      </rdfs:range>
      <rdfs:comment xml:lang="en">

An official method of nomenclature or defined set of nomenclature for chemical
compounds recognized by the scientific community.

IUPAC
                     </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Chem_comp_systematic_name.Naming_system"/>
   </owl:DatatypeProperty>
   <owl:Class rdf:ID="chem_comp_torCategory">
      <rdfs:subClassOf>
