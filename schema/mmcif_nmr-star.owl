         </owl:Class>
      </rdfs:subClassOf>
   </owl:Class>
   <owl:Class rdf:ID="study_entry_list">
      <rdfs:label>study_entry_list</rdfs:label>
      <rdfs:comment xml:lang="en">

Items in the study_entry_list category define a list of entries that together represent a study of a biomolecular system.

         </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tag.php?tagcat=Study_entry_list"/>
      <rdfs:subClassOf>
         <owl:Class>
            <owl:intersectionOf rdf:parseType="Collection">
               <owl:Class rdf:about="#CategoryElement"/>
