The theoretical isoelectric point for the entity.
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Entity.Calc_isoelectric_point"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="entity.db_query_date">
      <rdfs:subPropertyOf rdf:resource="#entityItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
      <rdfs:label>entity.db_query_date</rdfs:label>
