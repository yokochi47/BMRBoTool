   <owl:DatatypeProperty rdf:ID="conformer_stat_list.conf_family_coord_set_id">
      <rdfs:subPropertyOf rdf:resource="#conformer_stat_listItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
      <rdfs:label>conformer_stat_list.conf_family_coord_set_id</rdfs:label>
