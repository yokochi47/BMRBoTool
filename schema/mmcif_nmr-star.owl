Backbone 1H, 13C, and 15N Chemical Shift Assignments for Lysozyme
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Entry.Title"/>
      <owl:equivalentProperty rdf:resource="PDBo:struct.title"/>
