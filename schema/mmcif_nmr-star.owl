   <owl:ObjectProperty rdf:ID="referenced_by_sample_citation">
      <rdfs:label>referenced_by_sample_citation</rdfs:label>
      <rdfs:comment xml:lang="en">cross-reference from sample_citation.</rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#referenced_by"/>
      <rdfs:range rdf:resource="#sample_citation"/>
