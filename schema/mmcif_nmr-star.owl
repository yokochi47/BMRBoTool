   <owl:DatatypeProperty rdf:ID="heteronucl_noe_list.details">
      <rdfs:subPropertyOf rdf:resource="#heteronucl_noe_listItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>heteronucl_noe_list.details</rdfs:label>
      <rdfs:comment xml:lang="en">

Text providing additional information about the data reported.
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Heteronucl_NOE_list.Details"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="heteronucl_noe_list.heteronuclear_noe_val_type">
      <rdfs:subPropertyOf rdf:resource="#heteronucl_noe_listItem"/>
      <rdfs:domain rdf:resource="#heteronucl_noe_list"/>
      <rdfs:range>
         <owl:DataRange>
            <owl:oneOf>
               <rdf:List>
                  <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">peak height</rdf:first>
                  <rdf:rest>
                     <rdf:List>
                        <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">peak integral</rdf:first>
                        <rdf:rest>
                           <rdf:List>
                              <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">contour count</rdf:first>
                              <rdf:rest>
                                 <rdf:List>
                                    <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">relative intensities</rdf:first>
                                    <rdf:rest>
                                       <rdf:List>
                                          <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">na</rdf:first>
                                          <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                       </rdf:List>
                                    </rdf:rest>
                                 </rdf:List>
                              </rdf:rest>
                           </rdf:List>
                        </rdf:rest>
                     </rdf:List>
                  </rdf:rest>
               </rdf:List>
            </owl:oneOf>
         </owl:DataRange>
      </rdfs:range>
      <rdfs:comment xml:lang="en">

A keyword that defines the type of value reported as the heteronuclear NOE.

peak height; peak integral; contour count; relative intensities
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Heteronucl_NOE_list.Heteronuclear_NOE_val_type"/>
   </owl:DatatypeProperty>
