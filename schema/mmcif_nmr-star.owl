The quantum mechanical basis set used to calculate the theoretical chemical
shifts or chemical shift tensors (not shielding tensors).

6-311++G(2D,2P)
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Chem_shifts_calc_type.Quantum_mechanical_basis_set"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="chem_shifts_calc_type.quantum_mechanical_method">
      <rdfs:subPropertyOf rdf:resource="#chem_shifts_calc_typeItem"/>
      <rdfs:domain rdf:resource="#chem_shifts_calc_type"/>
      <rdfs:range>
         <owl:DataRange>
            <owl:oneOf>
               <rdf:List>
                  <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">GIAO</rdf:first>
                  <rdf:rest>
                     <rdf:List>
                        <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IGLO</rdf:first>
                        <rdf:rest>
                           <rdf:List>
                              <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CSGT</rdf:first>
                              <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                           </rdf:List>
                        </rdf:rest>
                     </rdf:List>
                  </rdf:rest>
               </rdf:List>
            </owl:oneOf>
         </owl:DataRange>
      </rdfs:range>
      <rdfs:comment xml:lang="en">

The method used to calculate the chemical shifts or chemical shift tensors
(not shielding tensors).

GIAO; IGLO; CSGT
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Chem_shifts_calc_type.Quantum_mechanical_method"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="chem_shifts_calc_type.quantum_mechanical_theory_level">
