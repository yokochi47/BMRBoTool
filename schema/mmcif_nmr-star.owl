      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>atom_site.pdb_strand_id</rdfs:label>
      <rdfs:comment xml:lang="en">

PDB strand id.

A
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Atom_site.PDB_strand_ID"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="atom_site.pdbx_formal_charge">
      <rdfs:subPropertyOf rdf:resource="#atom_siteItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
