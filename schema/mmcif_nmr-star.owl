   <owl:InverseFunctionalProperty rdf:ID="has_spectral_dimCategory">
      <rdfs:label>spectral_dimCategory</rdfs:label>
      <rdfs:comment xml:lang="en">
	This property indicates that datablock
	has a category holder spectral_dimCategory.
      </rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#hasCategory"/>
      <rdfs:seeAlso rdf:resource="#spectral_dim"/>
   </owl:InverseFunctionalProperty>
   <owl:InverseFunctionalProperty rdf:ID="has_spectral_dim">
      <rdfs:label>spectral_dimCategory</rdfs:label>
      <rdfs:comment xml:lang="en">
	This property indicates that spectral_dimCategory.
	has a category spectral_dim.
      </rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#hasCategoryElement"/>
      <rdfs:seeAlso rdf:resource="#spectral_dim"/>
      <rdfs:domain rdf:resource="#spectral_dimCategory"/>
      <rdfs:range rdf:resource="#spectral_dim"/>
   </owl:InverseFunctionalProperty>
   <owl:DatatypeProperty rdf:ID="spectral_dimItem">
      <rdfs:label>spectral_dimItem</rdfs:label>
      <rdfs:comment xml:lang="en">Abstract datatype property for spectral_dim items.</rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#categoryItem"/>
      <rdfs:domain rdf:resource="#spectral_dim"/>
   </owl:DatatypeProperty>
   <owl:ObjectProperty rdf:ID="reference_to_spectral_dim">
      <rdfs:label>reference_to_spectral_dim</rdfs:label>
      <rdfs:comment xml:lang="en">cross-reference to spectral_dim.</rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#reference_to"/>
      <rdfs:domain rdf:resource="#spectral_dim"/>
   </owl:ObjectProperty>
   <owl:ObjectProperty rdf:ID="referenced_by_spectral_dim">
      <rdfs:label>referenced_by_spectral_dim</rdfs:label>
      <rdfs:comment xml:lang="en">cross-reference from spectral_dim.</rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#referenced_by"/>
      <rdfs:range rdf:resource="#spectral_dim"/>
   </owl:ObjectProperty>
   <owl:DatatypeProperty rdf:ID="spectral_dim.absolute_peak_positions">
      <rdfs:subPropertyOf rdf:resource="#spectral_dimItem"/>
      <rdfs:domain rdf:resource="#spectral_dim"/>
      <rdfs:range>
         <owl:DataRange>
            <owl:oneOf>
               <rdf:List>
                  <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">yes</rdf:first>
                  <rdf:rest>
                     <rdf:List>
                        <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">no</rdf:first>
                        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                     </rdf:List>
                  </rdf:rest>
               </rdf:List>
            </owl:oneOf>
         </owl:DataRange>
      </rdfs:range>
      <rdfs:comment xml:lang="en">

?
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Spectral_dim.Absolute_peak_positions"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="spectral_dim.acquisition">
      <rdfs:subPropertyOf rdf:resource="#spectral_dimItem"/>
      <rdfs:domain rdf:resource="#spectral_dim"/>
      <rdfs:range>
         <owl:DataRange>
            <owl:oneOf>
               <rdf:List>
                  <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">yes</rdf:first>
                  <rdf:rest>
                     <rdf:List>
                        <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">no</rdf:first>
                        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                     </rdf:List>
                  </rdf:rest>
               </rdf:List>
            </owl:oneOf>
         </owl:DataRange>
      </rdfs:range>
      <rdfs:comment xml:lang="en">

?
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Spectral_dim.Acquisition"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="spectral_dim.atom_isotope_number">
      <rdfs:subPropertyOf rdf:resource="#spectral_dimItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
      <rdfs:label>spectral_dim.atom_isotope_number</rdfs:label>
      <rdfs:comment xml:lang="en">

The mass number for the specified atom.

13
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Spectral_dim.Atom_isotope_number"/>
      <owl:equivalentProperty rdf:resource="PDBo:pdbx_nmr_spectral_dim.atom_isotope_number"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="spectral_dim.axis_code">
      <rdfs:subPropertyOf rdf:resource="#spectral_dimItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>spectral_dim.axis_code</rdfs:label>
      <rdfs:comment xml:lang="en">

?
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Spectral_dim.Axis_code"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="spectral_dim.center_frequency_offset">
      <rdfs:subPropertyOf rdf:resource="#spectral_dimItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
      <rdfs:label>spectral_dim.center_frequency_offset</rdfs:label>
      <rdfs:comment xml:lang="en">

?
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Spectral_dim.Center_frequency_offset"/>
      <owl:equivalentProperty rdf:resource="PDBo:pdbx_nmr_spectral_dim.center_frequency_offset"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="spectral_dim.encoded_reduced_dimension_id">
      <rdfs:subPropertyOf rdf:resource="#spectral_dimItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
      <rdfs:label>spectral_dim.encoded_reduced_dimension_id</rdfs:label>
      <rdfs:comment xml:lang="en">

The spectral dimension in a reduced dimensionality experiment that is the
source of the magnetization that has been encoded.

3
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Spectral_dim.Encoded_reduced_dimension_ID"/>
      <owl:equivalentProperty rdf:resource="PDBo:pdbx_nmr_spectral_dim.encoded_source_dimension_id"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="spectral_dim.encoding_code">
      <rdfs:subPropertyOf rdf:resource="#spectral_dimItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>spectral_dim.encoding_code</rdfs:label>
      <rdfs:comment xml:lang="en">

Code describing how information from one spectral dimension has been encoded
in another dimension in for example a reduced dimensionality experiment.

CO in CA
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Spectral_dim.Encoding_code"/>
      <owl:equivalentProperty rdf:resource="PDBo:pdbx_nmr_spectral_dim.encoding_code"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="spectral_dim.magnetization_linkage_id">
      <rdfs:subPropertyOf rdf:resource="#spectral_dimItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
      <rdfs:label>spectral_dim.magnetization_linkage_id</rdfs:label>
      <rdfs:comment xml:lang="en">

The magnetization linkage ID is used to designate dimensions of a multidimensional
NMR experiment where the nuclei observed in the dimensions are directly
linked by a one bond scalar coupling. For example, the amide proton and amide
nitrogen in an 1H-15N HSQC experiment.

1
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Spectral_dim.Magnetization_linkage_ID"/>
      <owl:equivalentProperty rdf:resource="PDBo:pdbx_nmr_spectral_dim.magnetization_linkage_id"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="spectral_dim.spectrometer_frequency">
      <rdfs:subPropertyOf rdf:resource="#spectral_dimItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
      <rdfs:label>spectral_dim.spectrometer_frequency</rdfs:label>
      <rdfs:comment xml:lang="en">

?
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Spectral_dim.Spectrometer_frequency"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="spectral_dim.sweep_width">
      <rdfs:subPropertyOf rdf:resource="#spectral_dimItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
      <rdfs:label>spectral_dim.sweep_width</rdfs:label>
      <rdfs:comment xml:lang="en">

The width of the spectral window observed in Hz or ppm.

6132.234
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Spectral_dim.Sweep_width"/>
      <owl:equivalentProperty rdf:resource="PDBo:pdbx_nmr_spectral_dim.sweep_width"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="spectral_dim.sweep_width_units">
      <rdfs:subPropertyOf rdf:resource="#spectral_dimItem"/>
      <rdfs:domain rdf:resource="#spectral_dim"/>
      <rdfs:range>
         <owl:DataRange>
            <owl:oneOf>
               <rdf:List>
                  <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Hz</rdf:first>
                  <rdf:rest>
                     <rdf:List>
                        <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ppm</rdf:first>
                        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                     </rdf:List>
                  </rdf:rest>
               </rdf:List>
            </owl:oneOf>
         </owl:DataRange>
      </rdfs:range>
      <rdfs:comment xml:lang="en">

The units for the sweep width value (Hz or ppm)

ppm
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Spectral_dim.Sweep_width_units"/>
      <owl:equivalentProperty rdf:resource="PDBo:pdbx_nmr_spectral_dim.sweep_width_units"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="spectral_dim.under_sampling_type">
      <rdfs:subPropertyOf rdf:resource="#spectral_dimItem"/>
      <rdfs:domain rdf:resource="#spectral_dim"/>
      <rdfs:range>
         <owl:DataRange>
            <owl:oneOf>
               <rdf:List>
                  <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">aliased</rdf:first>
                  <rdf:rest>
                     <rdf:List>
                        <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">folded</rdf:first>
                        <rdf:rest>
                           <rdf:List>
                              <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">not observed</rdf:first>
                              <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                           </rdf:List>
                        </rdf:rest>
                     </rdf:List>
                  </rdf:rest>
               </rdf:List>
            </owl:oneOf>
         </owl:DataRange>
      </rdfs:range>
      <rdfs:comment xml:lang="en">

The type of spectral folding caused by undersampling in the spectral dimension.

aliased
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Spectral_dim.Under_sampling_type"/>
      <owl:equivalentProperty rdf:resource="PDBo:pdbx_nmr_spectral_dim.under_sampling_type"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="spectral_dim.value_first_point">
      <rdfs:subPropertyOf rdf:resource="#spectral_dimItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
      <rdfs:label>spectral_dim.value_first_point</rdfs:label>
      <rdfs:comment xml:lang="en">

?
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Spectral_dim.Value_first_point"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="spectral_dim.atom_type">
      <rdfs:subPropertyOf rdf:resource="#spectral_dimItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>spectral_dim.atom_type</rdfs:label>
      <rdfs:comment xml:lang="en">

The value for this tag is a standard IUPAC abbreviation for an element
(i.e., H, C, P, etc).

