      <rdfs:label>chem_comp_db_link.entry_mol_name</rdfs:label>
      <rdfs:comment xml:lang="en">

Name given by the database to the molecule.
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Chem_comp_db_link.Entry_mol_name"/>
