   <owl:InverseFunctionalProperty rdf:ID="has_xray_instrumentCategory">
      <rdfs:label>xray_instrumentCategory</rdfs:label>
      <rdfs:comment xml:lang="en">
	This property indicates that datablock
	has a category holder xray_instrumentCategory.
      </rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#hasCategory"/>
      <rdfs:seeAlso rdf:resource="#xray_instrument"/>
   </owl:InverseFunctionalProperty>
   <owl:InverseFunctionalProperty rdf:ID="has_xray_instrument">
      <rdfs:label>xray_instrumentCategory</rdfs:label>
      <rdfs:comment xml:lang="en">
	This property indicates that xray_instrumentCategory.
	has a category xray_instrument.
      </rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#hasCategoryElement"/>
      <rdfs:seeAlso rdf:resource="#xray_instrument"/>
      <rdfs:domain rdf:resource="#xray_instrumentCategory"/>
      <rdfs:range rdf:resource="#xray_instrument"/>
   </owl:InverseFunctionalProperty>
