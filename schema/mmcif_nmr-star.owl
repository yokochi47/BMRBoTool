Details about any entity mutation(s).

C280S
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Entity.Mutation"/>
      <owl:equivalentProperty rdf:resource="PDBo:entity.pdbx_mutation"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="entity.name">
