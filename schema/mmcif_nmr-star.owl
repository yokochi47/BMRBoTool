      <rdfs:label>entity.formula_weight</rdfs:label>
      <rdfs:comment xml:lang="en">

Formula mass in daltons of the entity.
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Entity.Formula_weight"/>
      <owl:equivalentProperty rdf:resource="PDBo:entity.formula_weight"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="entity.formula_weight_exptl">
