   <owl:DatatypeProperty rdf:ID="sample_condition_variable.val">
      <rdfs:subPropertyOf rdf:resource="#sample_condition_variableItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>sample_condition_variable.val</rdfs:label>
      <rdfs:comment xml:lang="en">

Value for the variable (temperature pressure pH).  Units will be listed below.

308
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Sample_condition_variable.Val"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="sample_condition_variable.val_err">
      <rdfs:subPropertyOf rdf:resource="#sample_condition_variableItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>sample_condition_variable.val_err</rdfs:label>
      <rdfs:comment xml:lang="en">

Estimate the standard error on the value for the sample condition.

0.2
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Sample_condition_variable.Val_err"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="sample_condition_variable.val_units">
      <rdfs:subPropertyOf rdf:resource="#sample_condition_variableItem"/>
      <rdfs:domain rdf:resource="#sample_condition_variable"/>
      <rdfs:range>
         <owl:DataRange>
            <owl:oneOf>
               <rdf:List>
                  <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Pa</rdf:first>
                  <rdf:rest>
                     <rdf:List>
                        <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">bar</rdf:first>
                        <rdf:rest>
                           <rdf:List>
                              <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">atm</rdf:first>
                              <rdf:rest>
                                 <rdf:List>
                                    <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">mmHg</rdf:first>
                                    <rdf:rest>
                                       <rdf:List>
                                          <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Torr</rdf:first>
                                          <rdf:rest>
                                             <rdf:List>
                                                <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">mbar</rdf:first>
                                                <rdf:rest>
                                                   <rdf:List>
                                                      <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">K</rdf:first>
                                                      <rdf:rest>
                                                         <rdf:List>
                                                            <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C</rdf:first>
                                                            <rdf:rest>
                                                               <rdf:List>
                                                                  <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">pH</rdf:first>
                                                                  <rdf:rest>
                                                                     <rdf:List>
                                                                        <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">M</rdf:first>
                                                                        <rdf:rest>
                                                                           <rdf:List>
                                                                              <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">mM</rdf:first>
                                                                              <rdf:rest>
                                                                                 <rdf:List>
                                                                                    <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">P</rdf:first>
                                                                                    <rdf:rest>
                                                                                       <rdf:List>
                                                                                          <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">cP</rdf:first>
                                                                                          <rdf:rest>
                                                                                             <rdf:List>
                                                                                                <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">m^2/s</rdf:first>
                                                                                                <rdf:rest>
                                                                                                   <rdf:List>
                                                                                                      <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Pa.s</rdf:first>
                                                                                                      <rdf:rest>
                                                                                                         <rdf:List>
                                                                                                            <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Not defined</rdf:first>
                                                                                                            <rdf:rest>
                                                                                                               <rdf:List>
                                                                                                                  <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">hPa</rdf:first>
                                                                                                                  <rdf:rest>
                                                                                                                     <rdf:List>
                                                                                                                        <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">pD</rdf:first>
                                                                                                                        <rdf:rest>
                                                                                                                           <rdf:List>
                                                                                                                              <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">pH*</rdf:first>
                                                                                                                              <rdf:rest>
                                                                                                                                 <rdf:List>
                                                                                                                                    <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">%</rdf:first>
                                                                                                                                    <rdf:rest>
                                                                                                                                       <rdf:List>
                                                                                                                                          <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">s</rdf:first>
                                                                                                                                          <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                                                                                                                       </rdf:List>
                                                                                                                                    </rdf:rest>
                                                                                                                                 </rdf:List>
                                                                                                                              </rdf:rest>
                                                                                                                           </rdf:List>
                                                                                                                        </rdf:rest>
                                                                                                                     </rdf:List>
                                                                                                                  </rdf:rest>
                                                                                                               </rdf:List>
                                                                                                            </rdf:rest>
                                                                                                         </rdf:List>
                                                                                                      </rdf:rest>
                                                                                                   </rdf:List>
                                                                                                </rdf:rest>
                                                                                             </rdf:List>
                                                                                          </rdf:rest>
                                                                                       </rdf:List>
                                                                                    </rdf:rest>
                                                                                 </rdf:List>
                                                                              </rdf:rest>
                                                                           </rdf:List>
                                                                        </rdf:rest>
                                                                     </rdf:List>
                                                                  </rdf:rest>
                                                               </rdf:List>
                                                            </rdf:rest>
                                                         </rdf:List>
                                                      </rdf:rest>
                                                   </rdf:List>
                                                </rdf:rest>
                                             </rdf:List>
                                          </rdf:rest>
                                       </rdf:List>
                                    </rdf:rest>
                                 </rdf:List>
                              </rdf:rest>
                           </rdf:List>
                        </rdf:rest>
                     </rdf:List>
                  </rdf:rest>
               </rdf:List>
            </owl:oneOf>
         </owl:DataRange>
      </rdfs:range>
      <rdfs:comment xml:lang="en">

Units for the value of the sample condition (temperature pressure pH).

K
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Sample_condition_variable.Val_units"/>
   </owl:DatatypeProperty>
