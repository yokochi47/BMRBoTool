   <owl:DatatypeProperty rdf:ID="entity_systematic_name.name">
      <rdfs:subPropertyOf rdf:resource="#entity_systematic_nameItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>entity_systematic_name.name</rdfs:label>
      <rdfs:comment xml:lang="en">

A name for the biopolymer that has been defined by an official body or
is derived from rules defined by an official organization recognized by the scientific
community.
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Entity_systematic_name.Name"/>
      <owl:equivalentProperty rdf:resource="PDBo:entity_name_sys.name"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="entity_systematic_name.entity_id">
      <rdfs:subPropertyOf rdf:resource="#entity_systematic_nameItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
      <rdfs:label>entity_systematic_name.entity_id</rdfs:label>
      <rdfs:comment xml:lang="en">

Pointer to '_Entity.ID'
                     </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Entity_systematic_name.Entity_ID"/>
      <owl:equivalentProperty rdf:resource="PDBo:entity_name_sys.entity_id"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="entity_systematic_name.entry_id">
      <rdfs:subPropertyOf rdf:resource="#entity_systematic_nameItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>entity_systematic_name.entry_id</rdfs:label>
      <rdfs:comment xml:lang="en">

Pointer to '_Entry.ID'
                     </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Entity_systematic_name.Entry_ID"/>
