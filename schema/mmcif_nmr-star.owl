   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="decoupling_pulse_sequence.name">
      <rdfs:subPropertyOf rdf:resource="#decoupling_pulse_sequenceItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>decoupling_pulse_sequence.name</rdfs:label>
      <rdfs:comment xml:lang="en">

Name for a decoupling pulse sequence.
                     </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Decoupling_pulse_sequence.Name"/>
