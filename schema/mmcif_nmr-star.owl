	has a category entity_deleted_atom.
      </rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#hasCategoryElement"/>
      <rdfs:seeAlso rdf:resource="#entity_deleted_atom"/>
      <rdfs:domain rdf:resource="#entity_deleted_atomCategory"/>
      <rdfs:range rdf:resource="#entity_deleted_atom"/>
   </owl:InverseFunctionalProperty>
