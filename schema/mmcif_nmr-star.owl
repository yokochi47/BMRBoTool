      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
      <rdfs:label>assembly_subsystem.db_query_date</rdfs:label>
      <rdfs:comment xml:lang="en">

Date that the last query has been conducted to locate entries in external
databases that are related to the assembly subsystem.
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Assembly_subsystem.DB_query_date"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="assembly_subsystem.details">
      <rdfs:subPropertyOf rdf:resource="#assembly_subsystemItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>assembly_subsystem.details</rdfs:label>
      <rdfs:comment xml:lang="en">

Additional information relevant to the data in the current saveframe or
to a specific data item is entered as a value to this tag.  The information entered
must supplement information already present.  Whenever possible data should
associated with specific data tags and not included in the value to a '_Details' tag.
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Assembly_subsystem.Details"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="assembly_subsystem.enzyme_commission_number">
      <rdfs:subPropertyOf rdf:resource="#assembly_subsystemItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>assembly_subsystem.enzyme_commission_number</rdfs:label>
      <rdfs:comment xml:lang="en">

Identification number defined by the Enzyme Commission for the protein
molecular system, or biological molecular system described in the saveframe.

3.1.3.5.3
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Assembly_subsystem.Enzyme_commission_number"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="assembly_subsystem.molecular_mass">
      <rdfs:subPropertyOf rdf:resource="#assembly_subsystemItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
      <rdfs:label>assembly_subsystem.molecular_mass</rdfs:label>
      <rdfs:comment xml:lang="en">

The approximate mass of the system as defined by the authors and is intended
to approximate the sum of the masses of all of the atoms in the system.  No
attempt  is made to define the mass at a specific pH value, in terms of the protonation
state of any pH titratable groups, or according to the incorporation
of isotopes.

24000
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Assembly_subsystem.Molecular_mass"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="assembly_subsystem.name">
      <rdfs:subPropertyOf rdf:resource="#assembly_subsystemItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>assembly_subsystem.name</rdfs:label>
      <rdfs:comment xml:lang="en">

Author supplied name for the assembly subsystem.
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Assembly_subsystem.Name"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="assembly_subsystem.sf_category">
      <rdfs:subPropertyOf rdf:resource="#assembly_subsystemItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>assembly_subsystem.sf_category</rdfs:label>
      <rdfs:comment xml:lang="en">

Category assigned to the information in the saveframe.
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Assembly_subsystem.Sf_category"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="assembly_subsystem.sf_framecode">
      <rdfs:subPropertyOf rdf:resource="#assembly_subsystemItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>assembly_subsystem.sf_framecode</rdfs:label>
      <rdfs:comment xml:lang="en">

A descriptive label that uniquely identifies this molecular subsystem from
all other subsystems of the molecular assembly studied.
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Assembly_subsystem.Sf_framecode"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="assembly_subsystem.entry_id">
      <rdfs:subPropertyOf rdf:resource="#assembly_subsystemItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>assembly_subsystem.entry_id</rdfs:label>
      <rdfs:comment xml:lang="en">

Pointer to '_Entry.ID'
                     </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Assembly_subsystem.Entry_ID"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="assembly_subsystem.id">
      <rdfs:subPropertyOf rdf:resource="#assembly_subsystemItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
      <rdfs:label>assembly_subsystem.id</rdfs:label>
      <rdfs:comment xml:lang="en">

An integer value that uniquely defines the subsystem of the molecular assembly
described. An assembly subsystem contains a subset of the components of
the full molecular assembly, but does not consist of fragments of the molecular
assembly components.
                     </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Assembly_subsystem.ID"/>
   </owl:DatatypeProperty>
   <owl:Class rdf:ID="assembly_systematic_nameCategory">
      <rdfs:subClassOf>
         <owl:Class>
            <owl:intersectionOf rdf:parseType="Collection">
               <owl:Class rdf:about="#Category"/>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#has_assembly_systematic_name"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
            </owl:intersectionOf>
         </owl:Class>
      </rdfs:subClassOf>
   </owl:Class>
   <owl:Class rdf:ID="assembly_systematic_name">
      <rdfs:label>assembly_systematic_name</rdfs:label>
      <rdfs:comment xml:lang="en">

Items in the assembly_systematic_name category capture systematic naming systems and the systematic name for the molecular assembly.

         </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tag.php?tagcat=Assembly_systematic_name"/>
      <rdfs:subClassOf>
         <owl:Class>
            <owl:intersectionOf rdf:parseType="Collection">
               <owl:Class rdf:about="#CategoryElement"/>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#assembly_systematic_name.name"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#assembly_systematic_name.name"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#assembly_systematic_name.assembly_id"/>
                  <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#assembly_systematic_name.entry_id"/>
                  <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#assembly_systematic_name.naming_system"/>
                  <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
               </owl:Restriction>
            </owl:intersectionOf>
         </owl:Class>
      </rdfs:subClassOf>
   </owl:Class>
   <owl:InverseFunctionalProperty rdf:ID="has_assembly_systematic_nameCategory">
      <rdfs:label>assembly_systematic_nameCategory</rdfs:label>
      <rdfs:comment xml:lang="en">
	This property indicates that datablock
	has a category holder assembly_systematic_nameCategory.
      </rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#hasCategory"/>
      <rdfs:seeAlso rdf:resource="#assembly_systematic_name"/>
   </owl:InverseFunctionalProperty>
   <owl:InverseFunctionalProperty rdf:ID="has_assembly_systematic_name">
      <rdfs:label>assembly_systematic_nameCategory</rdfs:label>
      <rdfs:comment xml:lang="en">
	This property indicates that assembly_systematic_nameCategory.
	has a category assembly_systematic_name.
      </rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#hasCategoryElement"/>
      <rdfs:seeAlso rdf:resource="#assembly_systematic_name"/>
      <rdfs:domain rdf:resource="#assembly_systematic_nameCategory"/>
      <rdfs:range rdf:resource="#assembly_systematic_name"/>
   </owl:InverseFunctionalProperty>
   <owl:DatatypeProperty rdf:ID="assembly_systematic_nameItem">
      <rdfs:label>assembly_systematic_nameItem</rdfs:label>
      <rdfs:comment xml:lang="en">Abstract datatype property for assembly_systematic_name items.</rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#categoryItem"/>
      <rdfs:domain rdf:resource="#assembly_systematic_name"/>
   </owl:DatatypeProperty>
   <owl:ObjectProperty rdf:ID="reference_to_assembly_systematic_name">
      <rdfs:label>reference_to_assembly_systematic_name</rdfs:label>
      <rdfs:comment xml:lang="en">cross-reference to assembly_systematic_name.</rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#reference_to"/>
      <rdfs:domain rdf:resource="#assembly_systematic_name"/>
   </owl:ObjectProperty>
   <owl:ObjectProperty rdf:ID="referenced_by_assembly_systematic_name">
      <rdfs:label>referenced_by_assembly_systematic_name</rdfs:label>
      <rdfs:comment xml:lang="en">cross-reference from assembly_systematic_name.</rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#referenced_by"/>
      <rdfs:range rdf:resource="#assembly_systematic_name"/>
   </owl:ObjectProperty>
   <owl:DatatypeProperty rdf:ID="assembly_systematic_name.name">
      <rdfs:subPropertyOf rdf:resource="#assembly_systematic_nameItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>assembly_systematic_name.name</rdfs:label>
      <rdfs:comment xml:lang="en">

Name for the molecular assembly that has been assigned by an organization
or derived using rules defined by an organization recognized by the scientific
community.
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Assembly_systematic_name.Name"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="assembly_systematic_name.assembly_id">
      <rdfs:subPropertyOf rdf:resource="#assembly_systematic_nameItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
      <rdfs:label>assembly_systematic_name.assembly_id</rdfs:label>
      <rdfs:comment xml:lang="en">

Pointer to '_Assembly.ID'
                     </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Assembly_systematic_name.Assembly_ID"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="assembly_systematic_name.entry_id">
      <rdfs:subPropertyOf rdf:resource="#assembly_systematic_nameItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>assembly_systematic_name.entry_id</rdfs:label>
      <rdfs:comment xml:lang="en">

Pointer to '_Entry.ID'
                     </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Assembly_systematic_name.Entry_ID"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="assembly_systematic_name.naming_system">
      <rdfs:subPropertyOf rdf:resource="#assembly_systematic_nameItem"/>
      <rdfs:domain rdf:resource="#assembly_systematic_name"/>
      <rdfs:range>
         <owl:DataRange>
            <owl:oneOf>
               <rdf:List>
                  <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IUPAC</rdf:first>
                  <rdf:rest>
                     <rdf:List>
                        <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CAS name</rdf:first>
                        <rdf:rest>
                           <rdf:List>
                              <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CAS registry number</rdf:first>
                              <rdf:rest>
                                 <rdf:List>
                                    <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">BMRB</rdf:first>
                                    <rdf:rest>
                                       <rdf:List>
                                          <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Pfam</rdf:first>
                                          <rdf:rest>
                                             <rdf:List>
                                                <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Swiss-Prot</rdf:first>
                                                <rdf:rest>
                                                   <rdf:List>
                                                      <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MEROPS</rdf:first>
                                                      <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                                   </rdf:List>
                                                </rdf:rest>
                                             </rdf:List>
                                          </rdf:rest>
                                       </rdf:List>
                                    </rdf:rest>
                                 </rdf:List>
                              </rdf:rest>
                           </rdf:List>
                        </rdf:rest>
                     </rdf:List>
                  </rdf:rest>
               </rdf:List>
            </owl:oneOf>
         </owl:DataRange>
      </rdfs:range>
      <rdfs:comment xml:lang="en">

A recognized or common systematic method used to name molecules and molecular
systems.

CAS
                     </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Assembly_systematic_name.Naming_system"/>
   </owl:DatatypeProperty>
   <owl:Class rdf:ID="assembly_typeCategory">
      <rdfs:subClassOf>
         <owl:Class>
            <owl:intersectionOf rdf:parseType="Collection">
               <owl:Class rdf:about="#Category"/>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#has_assembly_type"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
            </owl:intersectionOf>
         </owl:Class>
      </rdfs:subClassOf>
   </owl:Class>
   <owl:Class rdf:ID="assembly_type">
      <rdfs:label>assembly_type</rdfs:label>
      <rdfs:comment xml:lang="en">

Items in the assembly_type category describe the kind of assembly studied. These are keywords that are specific to a description of the assembly in terms of the types and number of components that make up the assembly.

         </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tag.php?tagcat=Assembly_type"/>
      <rdfs:subClassOf>
         <owl:Class>
            <owl:intersectionOf rdf:parseType="Collection">
               <owl:Class rdf:about="#CategoryElement"/>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#assembly_type.assembly_id"/>
                  <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#assembly_type.entry_id"/>
                  <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#assembly_type.type"/>
                  <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
               </owl:Restriction>
            </owl:intersectionOf>
         </owl:Class>
      </rdfs:subClassOf>
   </owl:Class>
   <owl:InverseFunctionalProperty rdf:ID="has_assembly_typeCategory">
      <rdfs:label>assembly_typeCategory</rdfs:label>
      <rdfs:comment xml:lang="en">
	This property indicates that datablock
	has a category holder assembly_typeCategory.
      </rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#hasCategory"/>
      <rdfs:seeAlso rdf:resource="#assembly_type"/>
   </owl:InverseFunctionalProperty>
   <owl:InverseFunctionalProperty rdf:ID="has_assembly_type">
      <rdfs:label>assembly_typeCategory</rdfs:label>
      <rdfs:comment xml:lang="en">
	This property indicates that assembly_typeCategory.
	has a category assembly_type.
      </rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#hasCategoryElement"/>
      <rdfs:seeAlso rdf:resource="#assembly_type"/>
      <rdfs:domain rdf:resource="#assembly_typeCategory"/>
      <rdfs:range rdf:resource="#assembly_type"/>
   </owl:InverseFunctionalProperty>
   <owl:DatatypeProperty rdf:ID="assembly_typeItem">
      <rdfs:label>assembly_typeItem</rdfs:label>
      <rdfs:comment xml:lang="en">Abstract datatype property for assembly_type items.</rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#categoryItem"/>
      <rdfs:domain rdf:resource="#assembly_type"/>
   </owl:DatatypeProperty>
   <owl:ObjectProperty rdf:ID="reference_to_assembly_type">
      <rdfs:label>reference_to_assembly_type</rdfs:label>
      <rdfs:comment xml:lang="en">cross-reference to assembly_type.</rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#reference_to"/>
      <rdfs:domain rdf:resource="#assembly_type"/>
   </owl:ObjectProperty>
   <owl:ObjectProperty rdf:ID="referenced_by_assembly_type">
      <rdfs:label>referenced_by_assembly_type</rdfs:label>
      <rdfs:comment xml:lang="en">cross-reference from assembly_type.</rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#referenced_by"/>
      <rdfs:range rdf:resource="#assembly_type"/>
   </owl:ObjectProperty>
   <owl:DatatypeProperty rdf:ID="assembly_type.assembly_id">
      <rdfs:subPropertyOf rdf:resource="#assembly_typeItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
      <rdfs:label>assembly_type.assembly_id</rdfs:label>
      <rdfs:comment xml:lang="en">

Pointer to '_Assembly.ID'
                     </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Assembly_type.Assembly_ID"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="assembly_type.entry_id">
      <rdfs:subPropertyOf rdf:resource="#assembly_typeItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>assembly_type.entry_id</rdfs:label>
      <rdfs:comment xml:lang="en">

Pointer to '_Entry.ID'
                     </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Assembly_type.Entry_ID"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="assembly_type.type">
      <rdfs:subPropertyOf rdf:resource="#assembly_typeItem"/>
      <rdfs:domain rdf:resource="#assembly_type"/>
      <rdfs:range>
         <owl:DataRange>
            <owl:oneOf>
               <rdf:List>
                  <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">peptide</rdf:first>
                  <rdf:rest>
                     <rdf:List>
                        <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">protein monomer</rdf:first>
                        <rdf:rest>
                           <rdf:List>
                              <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">protein homo-multimer</rdf:first>
                              <rdf:rest>
                                 <rdf:List>
                                    <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">protein hetero-multimer</rdf:first>
                                    <rdf:rest>
                                       <rdf:List>
                                          <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">RNA single strand</rdf:first>
                                          <rdf:rest>
                                             <rdf:List>
                                                <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">RNA double strand</rdf:first>
                                                <rdf:rest>
                                                   <rdf:List>
                                                      <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DNA single strand</rdf:first>
                                                      <rdf:rest>
                                                         <rdf:List>
                                                            <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DNA double strand</rdf:first>
                                                            <rdf:rest>
                                                               <rdf:List>
                                                                  <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DNA-RNA hybrid</rdf:first>
                                                                  <rdf:rest>
                                                                     <rdf:List>
                                                                        <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">polysaccharide</rdf:first>
                                                                        <rdf:rest>
                                                                           <rdf:List>
                                                                              <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">protein-nucleic acid complex</rdf:first>
                                                                              <rdf:rest>
                                                                                 <rdf:List>
                                                                                    <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">protein-inhibitor complex</rdf:first>
                                                                                    <rdf:rest>
                                                                                       <rdf:List>
                                                                                          <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">protein-drug complex</rdf:first>
                                                                                          <rdf:rest>
                                                                                             <rdf:List>
                                                                                                <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">protein-ligand complex</rdf:first>
                                                                                                <rdf:rest>
                                                                                                   <rdf:List>
                                                                                                      <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">protein-protein complex</rdf:first>
                                                                                                      <rdf:rest>
                                                                                                         <rdf:List>
                                                                                                            <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">protein-DNA complex</rdf:first>
                                                                                                            <rdf:rest>
                                                                                                               <rdf:List>
                                                                                                                  <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">protein-DNA-ligand complex</rdf:first>
                                                                                                                  <rdf:rest>
                                                                                                                     <rdf:List>
                                                                                                                        <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">protein-DNA-inhibitor complex</rdf:first>
                                                                                                                        <rdf:rest>
                                                                                                                           <rdf:List>
                                                                                                                              <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">protein-RNA complex</rdf:first>
                                                                                                                              <rdf:rest>
                                                                                                                                 <rdf:List>
                                                                                                                                    <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">protein-RNA-ligand complex</rdf:first>
                                                                                                                                    <rdf:rest>
                                                                                                                                       <rdf:List>
                                                                                                                                          <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">protein-RNA-inhibitor complex</rdf:first>
                                                                                                                                          <rdf:rest>
                                                                                                                                             <rdf:List>
                                                                                                                                                <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">protein-carbohydrate complex</rdf:first>
                                                                                                                                                <rdf:rest>
                                                                                                                                                   <rdf:List>
                                                                                                                                                      <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DNA-drug complex</rdf:first>
                                                                                                                                                      <rdf:rest>
                                                                                                                                                         <rdf:List>
                                                                                                                                                            <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DNA-RNA complex</rdf:first>
                                                                                                                                                            <rdf:rest>
                                                                                                                                                               <rdf:List>
                                                                                                                                                                  <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">RNA-drug complex</rdf:first>
