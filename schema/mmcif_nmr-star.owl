A pointer to an external reference file from which the atomic
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Chem_comp.Model_erf"/>
      <owl:equivalentProperty rdf:resource="PDBo:chem_comp.model_erf"/>
