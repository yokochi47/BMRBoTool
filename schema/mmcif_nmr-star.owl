                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Entity.Formula_weight_exptl_meth"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="entity.fragment">
      <rdfs:subPropertyOf rdf:resource="#entityItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>entity.fragment</rdfs:label>
