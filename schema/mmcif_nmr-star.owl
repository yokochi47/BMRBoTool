   <owl:DatatypeProperty rdf:ID="gen_dist_constraint_list.constraint_type">
      <rdfs:subPropertyOf rdf:resource="#gen_dist_constraint_listItem"/>
      <rdfs:domain rdf:resource="#gen_dist_constraint_list"/>
      <rdfs:range>
         <owl:DataRange>
            <owl:oneOf>
               <rdf:List>
                  <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NOE</rdf:first>
                  <rdf:rest>
                     <rdf:List>
                        <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NOE build-up</rdf:first>
                        <rdf:rest>
                           <rdf:List>
                              <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NOE not seen</rdf:first>
                              <rdf:rest>
                                 <rdf:List>
                                    <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ROE</rdf:first>
                                    <rdf:rest>
                                       <rdf:List>
                                          <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ROE build-up</rdf:first>
                                          <rdf:rest>
                                             <rdf:List>
                                                <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">hydrogen bond</rdf:first>
                                                <rdf:rest>
                                                   <rdf:List>
                                                      <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">disulfide bond</rdf:first>
                                                      <rdf:rest>
                                                         <rdf:List>
                                                            <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">paramagnetic relaxation</rdf:first>
                                                            <rdf:rest>
                                                               <rdf:List>
                                                                  <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">symmetry</rdf:first>
                                                                  <rdf:rest>
                                                                     <rdf:List>
                                                                        <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">general distance</rdf:first>
                                                                        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                                                     </rdf:List>
                                                                  </rdf:rest>
                                                               </rdf:List>
                                                            </rdf:rest>
                                                         </rdf:List>
                                                      </rdf:rest>
                                                   </rdf:List>
                                                </rdf:rest>
                                             </rdf:List>
                                          </rdf:rest>
                                       </rdf:List>
                                    </rdf:rest>
                                 </rdf:List>
                              </rdf:rest>
                           </rdf:List>
                        </rdf:rest>
                     </rdf:List>
                  </rdf:rest>
               </rdf:List>
            </owl:oneOf>
         </owl:DataRange>
      </rdfs:range>
      <rdfs:comment xml:lang="en">

The type of reported distance constraint.

NOE
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Gen_dist_constraint_list.Constraint_type"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="gen_dist_constraint_list.details">
      <rdfs:subPropertyOf rdf:resource="#gen_dist_constraint_listItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>gen_dist_constraint_list.details</rdfs:label>
