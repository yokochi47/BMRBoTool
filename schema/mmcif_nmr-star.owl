	has a category atom.
      </rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#hasCategoryElement"/>
      <rdfs:seeAlso rdf:resource="#atom"/>
      <rdfs:domain rdf:resource="#atomCategory"/>
      <rdfs:range rdf:resource="#atom"/>
   </owl:InverseFunctionalProperty>
