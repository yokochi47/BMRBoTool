      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
      <rdfs:label>deduced_h_bond.h_atom_assembly_atom_id</rdfs:label>
      <rdfs:comment xml:lang="en">

Pointer to '_Atom.Assembly_atom_ID'
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Deduced_H_bond.H_atom_assembly_atom_ID"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="deduced_h_bond.h_atom_auth_atom_id">
      <rdfs:subPropertyOf rdf:resource="#deduced_h_bondItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>deduced_h_bond.h_atom_auth_atom_id</rdfs:label>
      <rdfs:comment xml:lang="en">

An alternative identifier for Atom_ID that may be provided by an author
in order to match that used in the publication that describes the experimental data.

HB1
                        </rdfs:comment>
