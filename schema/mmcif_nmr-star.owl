      <rdfs:seeAlso rdf:resource="#cs_anisotropy"/>
   </owl:InverseFunctionalProperty>
   <owl:InverseFunctionalProperty rdf:ID="has_cs_anisotropy">
      <rdfs:label>cs_anisotropyCategory</rdfs:label>
      <rdfs:comment xml:lang="en">
	This property indicates that cs_anisotropyCategory.
	has a category cs_anisotropy.
      </rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#hasCategoryElement"/>
      <rdfs:seeAlso rdf:resource="#cs_anisotropy"/>
      <rdfs:domain rdf:resource="#cs_anisotropyCategory"/>
      <rdfs:range rdf:resource="#cs_anisotropy"/>
   </owl:InverseFunctionalProperty>
