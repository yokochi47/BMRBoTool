      <rdfs:subPropertyOf rdf:resource="#ph_param_listItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
      <rdfs:label>ph_param_list.ph_titration_list_id</rdfs:label>
      <rdfs:comment xml:lang="en">

Pointer to 'PH_titration_list.ID'
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_PH_param_list.PH_titration_list_ID"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="ph_param_list.ph_titration_list_label">
