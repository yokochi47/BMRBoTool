      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>entity_db_link.accession_code</rdfs:label>
      <rdfs:comment xml:lang="en">

Accession code for the entry in the database.

P09020
                     </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Entity_db_link.Accession_code"/>
   </owl:DatatypeProperty>
