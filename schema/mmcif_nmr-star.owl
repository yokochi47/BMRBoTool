      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Entity_experimental_src.Host_org_cellular_location"/>
      <owl:equivalentProperty rdf:resource="PDBo:entity_src_gen.pdbx_host_org_cellular_location"/>
