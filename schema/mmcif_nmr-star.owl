      <rdfs:comment xml:lang="en">cross-reference to chem_comp_assembly.</rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#reference_to"/>
      <rdfs:domain rdf:resource="#chem_comp_assembly"/>
   </owl:ObjectProperty>
   <owl:ObjectProperty rdf:ID="referenced_by_chem_comp_assembly">
      <rdfs:label>referenced_by_chem_comp_assembly</rdfs:label>
      <rdfs:comment xml:lang="en">cross-reference from chem_comp_assembly.</rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#referenced_by"/>
      <rdfs:range rdf:resource="#chem_comp_assembly"/>
