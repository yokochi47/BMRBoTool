ASN
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Atom_site.PDBX_label_comp_ID"/>
      <owl:equivalentProperty rdf:resource="PDBo:atom_site.pdbx_pdb_residue_name"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="atom_site.pdbx_label_entity_id">
