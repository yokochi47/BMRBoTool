   <owl:DatatypeProperty rdf:ID="spectral_processing_param.name">
      <rdfs:subPropertyOf rdf:resource="#spectral_processing_paramItem"/>
      <rdfs:domain rdf:resource="#spectral_processing_param"/>
      <rdfs:range>
         <owl:DataRange>
            <owl:oneOf>
               <rdf:List>
                  <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Exponential factor</rdf:first>
                  <rdf:rest>
                     <rdf:List>
                        <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Gaussian factor</rdf:first>
                        <rdf:rest>
                           <rdf:List>
                              <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Zero filling</rdf:first>
                              <rdf:rest>
                                 <rdf:List>
                                    <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Lnear prediction</rdf:first>
                                    <rdf:rest>
                                       <rdf:List>
                                          <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Processed real points</rdf:first>
                                          <rdf:rest>
                                             <rdf:List>
                                                <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Submatrix block size</rdf:first>
                                                <rdf:rest>
                                                   <rdf:List>
                                                      <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Full spectrum width points</rdf:first>
                                                      <rdf:rest>
                                                         <rdf:List>
                                                            <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Spectrum offset</rdf:first>
                                                            <rdf:rest>
                                                               <rdf:List>
                                                                  <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Data type</rdf:first>
                                                                  <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                                               </rdf:List>
                                                            </rdf:rest>
                                                         </rdf:List>
                                                      </rdf:rest>
                                                   </rdf:List>
                                                </rdf:rest>
                                             </rdf:List>
                                          </rdf:rest>
                                       </rdf:List>
                                    </rdf:rest>
                                 </rdf:List>
                              </rdf:rest>
                           </rdf:List>
                        </rdf:rest>
                     </rdf:List>
                  </rdf:rest>
               </rdf:List>
            </owl:oneOf>
         </owl:DataRange>
      </rdfs:range>
      <rdfs:comment xml:lang="en">

Name for a NMR spectral processing parameter.
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Spectral_processing_param.Name"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="spectral_processing_param.operation_code">
      <rdfs:subPropertyOf rdf:resource="#spectral_processing_paramItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>spectral_processing_param.operation_code</rdfs:label>
      <rdfs:comment xml:lang="en">

A code that describes the spectral processing operation.
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Spectral_processing_param.Operation_code"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="spectral_processing_param.operation_id">
      <rdfs:subPropertyOf rdf:resource="#spectral_processing_paramItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
      <rdfs:label>spectral_processing_param.operation_id</rdfs:label>
      <rdfs:comment xml:lang="en">

An integer value that is a unique identifier for the operation within the
save frame.
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Spectral_processing_param.Operation_ID"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="spectral_processing_param.operation_ordinal">
      <rdfs:subPropertyOf rdf:resource="#spectral_processing_paramItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
      <rdfs:label>spectral_processing_param.operation_ordinal</rdfs:label>
      <rdfs:comment xml:lang="en">

An integer value that defines the order in which the operations  are carried
out.
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Spectral_processing_param.Operation_ordinal"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="spectral_processing_param.previous_operation_id">
      <rdfs:subPropertyOf rdf:resource="#spectral_processing_paramItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
      <rdfs:label>spectral_processing_param.previous_operation_id</rdfs:label>
      <rdfs:comment xml:lang="en">

The operation_ID for the operation carried out immediately prior to the
current operation.
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Spectral_processing_param.Previous_operation_ID"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="spectral_processing_param.processing_dimension_id">
      <rdfs:subPropertyOf rdf:resource="#spectral_processing_paramItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
      <rdfs:label>spectral_processing_param.processing_dimension_id</rdfs:label>
      <rdfs:comment xml:lang="en">

The spectral dimension in which the processing parameter was applied.
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Spectral_processing_param.Processing_dimension_ID"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="spectral_processing_param.spectral_dim">
      <rdfs:subPropertyOf rdf:resource="#spectral_processing_paramItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
      <rdfs:label>spectral_processing_param.spectral_dim</rdfs:label>
      <rdfs:comment xml:lang="en">

The number of the spectral dimension where the parameter value is applied.
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Spectral_processing_param.Spectral_dim"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="spectral_processing_param.val">
      <rdfs:subPropertyOf rdf:resource="#spectral_processing_paramItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>spectral_processing_param.val</rdfs:label>
      <rdfs:comment xml:lang="en">

Value for the NMR spectral processing parameter.
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Spectral_processing_param.Val"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="spectral_processing_param.val_units">
