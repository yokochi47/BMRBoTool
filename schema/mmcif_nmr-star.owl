      <rdfs:label>atom_site.model_site_id</rdfs:label>
      <rdfs:comment xml:lang="en">

The Model_site_ID item is an integer value that for each model in the table
has an initial value of 1 and increments in consecutive integer values for
each set of atomic coordinates reported in the model.
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Atom_site.Model_site_ID"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="atom_site.occupancy">
      <rdfs:subPropertyOf rdf:resource="#atom_siteItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
      <rdfs:label>atom_site.occupancy</rdfs:label>
      <rdfs:comment xml:lang="en">

The percent occupancy of the atom at the atom site defined by the listed
coordinates.
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Atom_site.Occupancy"/>
      <owl:equivalentProperty rdf:resource="PDBo:atom_site.occupancy"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="atom_site.occupancy_esd">
      <rdfs:subPropertyOf rdf:resource="#atom_siteItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
      <rdfs:label>atom_site.occupancy_esd</rdfs:label>
      <rdfs:comment xml:lang="en">

The standard uncertainty (estimated standard deviation) of '_Atom_site.Occupancy'.
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Atom_site.Occupancy_esd"/>
      <owl:equivalentProperty rdf:resource="PDBo:atom_site.occupancy_esd"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="atom_site.ordered_flag">
      <rdfs:subPropertyOf rdf:resource="#atom_siteItem"/>
      <rdfs:domain rdf:resource="#atom_site"/>
      <rdfs:range>
         <owl:DataRange>
            <owl:oneOf>
               <rdf:List>
                  <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</rdf:first>
                  <rdf:rest>
                     <rdf:List>
                        <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#int">0</rdf:first>
                        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                     </rdf:List>
                  </rdf:rest>
               </rdf:List>
            </owl:oneOf>
         </owl:DataRange>
      </rdfs:range>
      <rdfs:comment xml:lang="en">

A value indicating whether the atom at this site is considered in an ordered
conformation (1) or is in a disordered conformation (0) in the structure.

1;0
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Atom_site.Ordered_flag"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="atom_site.pdb_atom_name">
      <rdfs:subPropertyOf rdf:resource="#atom_siteItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>atom_site.pdb_atom_name</rdfs:label>
      <rdfs:comment xml:lang="en">

PDB atom name.

CD1
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Atom_site.PDB_atom_name"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="atom_site.pdb_ins_code">
      <rdfs:subPropertyOf rdf:resource="#atom_siteItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>atom_site.pdb_ins_code</rdfs:label>
      <rdfs:comment xml:lang="en">

PDB insertion code.
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Atom_site.PDB_ins_code"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="atom_site.pdb_model_num">
      <rdfs:subPropertyOf rdf:resource="#atom_siteItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
      <rdfs:label>atom_site.pdb_model_num</rdfs:label>
      <rdfs:comment xml:lang="en">

PDB model number.

1
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Atom_site.PDB_model_num"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="atom_site.pdb_record_id">
      <rdfs:subPropertyOf rdf:resource="#atom_siteItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>atom_site.pdb_record_id</rdfs:label>
      <rdfs:comment xml:lang="en">

The value is an integer that identifies a record in the atom_site list.
This is a place holder for the atom record number extracted from a PDB formatted file.

14034
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Atom_site.PDB_record_ID"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="atom_site.pdb_residue_name">
      <rdfs:subPropertyOf rdf:resource="#atom_siteItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>atom_site.pdb_residue_name</rdfs:label>
      <rdfs:comment xml:lang="en">

PDB residue name.

TYR
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Atom_site.PDB_residue_name"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="atom_site.pdb_residue_no">
      <rdfs:subPropertyOf rdf:resource="#atom_siteItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>atom_site.pdb_residue_no</rdfs:label>
      <rdfs:comment xml:lang="en">

PDB residue number.

6
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Atom_site.PDB_residue_no"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="atom_site.pdb_strand_id">
