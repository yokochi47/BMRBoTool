      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>chem_comp.std_deriv_pdb_code</rdfs:label>
      <rdfs:comment xml:lang="en">

The PDB code for the standard monomer from which the chemical component
is derived.
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Chem_comp.Std_deriv_PDB_code"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="chem_comp.std_deriv_three_letter_code">
      <rdfs:subPropertyOf rdf:resource="#chem_compItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>chem_comp.std_deriv_three_letter_code</rdfs:label>
      <rdfs:comment xml:lang="en">

The three letter code for the standard monomer from which the chemical
component is derived.

TYR
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Chem_comp.Std_deriv_three_letter_code"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="chem_comp.stereochem_param_file_format">
