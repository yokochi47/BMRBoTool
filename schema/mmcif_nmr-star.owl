      <rdfs:label>chem_comp.struct_file_format</rdfs:label>
      <rdfs:comment xml:lang="en">

File format for the attached structure file.
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Chem_comp.Struct_file_format"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="chem_comp.struct_file_name">
      <rdfs:subPropertyOf rdf:resource="#chem_compItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>chem_comp.struct_file_name</rdfs:label>
      <rdfs:comment xml:lang="en">

Name of a structure file attached to the entry for a chemical component.
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Chem_comp.Struct_file_name"/>
   </owl:DatatypeProperty>
