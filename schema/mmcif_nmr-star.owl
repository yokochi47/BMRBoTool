   <owl:InverseFunctionalProperty rdf:ID="has_isotope_effectCategory">
      <rdfs:label>isotope_effectCategory</rdfs:label>
      <rdfs:comment xml:lang="en">
	This property indicates that datablock
	has a category holder isotope_effectCategory.
      </rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#hasCategory"/>
      <rdfs:seeAlso rdf:resource="#isotope_effect"/>
   </owl:InverseFunctionalProperty>
   <owl:InverseFunctionalProperty rdf:ID="has_isotope_effect">
      <rdfs:label>isotope_effectCategory</rdfs:label>
      <rdfs:comment xml:lang="en">
	This property indicates that isotope_effectCategory.
	has a category isotope_effect.
      </rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#hasCategoryElement"/>
      <rdfs:seeAlso rdf:resource="#isotope_effect"/>
      <rdfs:domain rdf:resource="#isotope_effectCategory"/>
      <rdfs:range rdf:resource="#isotope_effect"/>
   </owl:InverseFunctionalProperty>
   <owl:DatatypeProperty rdf:ID="isotope_effectItem">
      <rdfs:label>isotope_effectItem</rdfs:label>
