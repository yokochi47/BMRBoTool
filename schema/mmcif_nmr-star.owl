      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Chem_comp_assembly.Assembly_ID"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="chem_comp_assembly.comp_index_id">
