            </owl:oneOf>
         </owl:DataRange>
      </rdfs:range>
      <rdfs:comment xml:lang="en">

The name of the systematic NMR experiment naming system used to name the
NMR experiment.
                     </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_NMR_expt_systematic_name.Naming_system"/>
   </owl:DatatypeProperty>
