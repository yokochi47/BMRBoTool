      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
      <rdfs:label>entity.formula_weight_exptl</rdfs:label>
      <rdfs:comment xml:lang="en">

Experimentally determined formula weight for the molecular entity.
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Entity.Formula_weight_exptl"/>
      <owl:equivalentProperty rdf:resource="PDBo:entity.pdbx_formula_weight_exptl"/>
