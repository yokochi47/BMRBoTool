      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
      <rdfs:label>chem_comp_assembly.comp_index_id</rdfs:label>
      <rdfs:comment xml:lang="en">

Pointer to '_Entity_comp_index.ID'
                     </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Chem_comp_assembly.Comp_index_ID"/>
   </owl:DatatypeProperty>
