      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
      <rdfs:label>atom.assembly_atom_id</rdfs:label>
      <rdfs:comment xml:lang="en">

A value that uniquely identifies the atom from all other atoms in the molecular
assembly.
                     </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Atom.Assembly_atom_ID"/>
   </owl:DatatypeProperty>
