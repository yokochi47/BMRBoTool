      <rdfs:seeAlso rdf:resource="#atom_sites_footnote"/>
      <rdfs:domain rdf:resource="#atom_sites_footnoteCategory"/>
      <rdfs:range rdf:resource="#atom_sites_footnote"/>
   </owl:InverseFunctionalProperty>
