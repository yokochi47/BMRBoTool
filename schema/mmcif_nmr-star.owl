      <rdfs:seeAlso rdf:resource="#pb_char"/>
   </owl:InverseFunctionalProperty>
   <owl:InverseFunctionalProperty rdf:ID="has_pb_char">
      <rdfs:label>pb_charCategory</rdfs:label>
      <rdfs:comment xml:lang="en">
	This property indicates that pb_charCategory.
	has a category pb_char.
      </rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#hasCategoryElement"/>
      <rdfs:seeAlso rdf:resource="#pb_char"/>
      <rdfs:domain rdf:resource="#pb_charCategory"/>
      <rdfs:range rdf:resource="#pb_char"/>
   </owl:InverseFunctionalProperty>
