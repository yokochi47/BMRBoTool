   <owl:InverseFunctionalProperty rdf:ID="has_entity_assemblyCategory">
      <rdfs:label>entity_assemblyCategory</rdfs:label>
      <rdfs:comment xml:lang="en">
	This property indicates that datablock
	has a category holder entity_assemblyCategory.
      </rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#hasCategory"/>
      <rdfs:seeAlso rdf:resource="#entity_assembly"/>
   </owl:InverseFunctionalProperty>
   <owl:InverseFunctionalProperty rdf:ID="has_entity_assembly">
      <rdfs:label>entity_assemblyCategory</rdfs:label>
      <rdfs:comment xml:lang="en">
	This property indicates that entity_assemblyCategory.
	has a category entity_assembly.
      </rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#hasCategoryElement"/>
      <rdfs:seeAlso rdf:resource="#entity_assembly"/>
      <rdfs:domain rdf:resource="#entity_assemblyCategory"/>
      <rdfs:range rdf:resource="#entity_assembly"/>
   </owl:InverseFunctionalProperty>
   <owl:DatatypeProperty rdf:ID="entity_assemblyItem">
      <rdfs:label>entity_assemblyItem</rdfs:label>
      <rdfs:comment xml:lang="en">Abstract datatype property for entity_assembly items.</rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#categoryItem"/>
      <rdfs:domain rdf:resource="#entity_assembly"/>
   </owl:DatatypeProperty>
   <owl:ObjectProperty rdf:ID="reference_to_entity_assembly">
      <rdfs:label>reference_to_entity_assembly</rdfs:label>
      <rdfs:comment xml:lang="en">cross-reference to entity_assembly.</rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#reference_to"/>
      <rdfs:domain rdf:resource="#entity_assembly"/>
   </owl:ObjectProperty>
   <owl:ObjectProperty rdf:ID="referenced_by_entity_assembly">
      <rdfs:label>referenced_by_entity_assembly</rdfs:label>
      <rdfs:comment xml:lang="en">cross-reference from entity_assembly.</rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#referenced_by"/>
      <rdfs:range rdf:resource="#entity_assembly"/>
   </owl:ObjectProperty>
   <owl:DatatypeProperty rdf:ID="entity_assembly.asym_id">
      <rdfs:subPropertyOf rdf:resource="#entity_assemblyItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>entity_assembly.asym_id</rdfs:label>
      <rdfs:comment xml:lang="en">

Pointer to '_Struct_asym.ID'

A
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Entity_assembly.Asym_ID"/>
      <owl:equivalentProperty rdf:resource="PDBo:struct_asym.id"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="entity_assembly.chemical_exchange_state">
      <rdfs:subPropertyOf rdf:resource="#entity_assemblyItem"/>
      <rdfs:domain rdf:resource="#entity_assembly"/>
      <rdfs:range>
         <owl:DataRange>
            <owl:oneOf>
               <rdf:List>
                  <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">yes</rdf:first>
                  <rdf:rest>
                     <rdf:List>
                        <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">no</rdf:first>
                        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                     </rdf:List>
                  </rdf:rest>
               </rdf:List>
            </owl:oneOf>
         </owl:DataRange>
      </rdfs:range>
      <rdfs:comment xml:lang="en">

A flag indicating whether the component of the system is in chemical exchange
with another component of the system.

no
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Entity_assembly.Chemical_exchange_state"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="entity_assembly.conformational_isomer">
      <rdfs:subPropertyOf rdf:resource="#entity_assemblyItem"/>
      <rdfs:domain rdf:resource="#entity_assembly"/>
      <rdfs:range>
         <owl:DataRange>
            <owl:oneOf>
               <rdf:List>
                  <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">yes</rdf:first>
                  <rdf:rest>
                     <rdf:List>
                        <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">no</rdf:first>
                        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                     </rdf:List>
                  </rdf:rest>
               </rdf:List>
            </owl:oneOf>
         </owl:DataRange>
      </rdfs:range>
      <rdfs:comment xml:lang="en">

A flag indicating whether the component of the system is a conformational
isomer of another component of the system.

yes
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Entity_assembly.Conformational_isomer"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="entity_assembly.details">
      <rdfs:subPropertyOf rdf:resource="#entity_assemblyItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>entity_assembly.details</rdfs:label>
      <rdfs:comment xml:lang="en">

Text information describing the component of the assembly that is pertinent
to the component as found in the assembly.  Specific details about the entity
are given in the entity category.

The bound ATP is in slow exchange with the free form
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Entity_assembly.Details"/>
      <owl:equivalentProperty rdf:resource="PDBo:struct_asym.details"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="entity_assembly.entity_assembly_name">
      <rdfs:subPropertyOf rdf:resource="#entity_assemblyItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>entity_assembly.entity_assembly_name</rdfs:label>
      <rdfs:comment xml:lang="en">

Name for this molecular component of the molecular assembly

subunit 1
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Entity_assembly.Entity_assembly_name"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="entity_assembly.entity_id">
      <rdfs:subPropertyOf rdf:resource="#entity_assemblyItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
      <rdfs:label>entity_assembly.entity_id</rdfs:label>
      <rdfs:comment xml:lang="en">

Pointer to '_Entity.ID'
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Entity_assembly.Entity_ID"/>
      <owl:equivalentProperty rdf:resource="PDBo:struct_asym.entity_id"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="entity_assembly.entity_label">
      <rdfs:subPropertyOf rdf:resource="#entity_assemblyItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>entity_assembly.entity_label</rdfs:label>
      <rdfs:comment xml:lang="en">

This value points to the section of the entry where the chemical description
is given for all assembly components of this type.  For a homodimer a chemical
description of the monomer is given only once and is pointed to by this value
although the assembly contains two monomers.

HIV protease polypeptide
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Entity_assembly.Entity_label"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="entity_assembly.experimental_data_reported">
      <rdfs:subPropertyOf rdf:resource="#entity_assemblyItem"/>
      <rdfs:domain rdf:resource="#entity_assembly"/>
      <rdfs:range>
         <owl:DataRange>
            <owl:oneOf>
               <rdf:List>
                  <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">yes</rdf:first>
                  <rdf:rest>
                     <rdf:List>
                        <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">no</rdf:first>
                        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                     </rdf:List>
                  </rdf:rest>
               </rdf:List>
            </owl:oneOf>
         </owl:DataRange>
      </rdfs:range>
      <rdfs:comment xml:lang="en">

A flag indicating whether experimental data for a specific component of
the assembly is reported.

yes
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Entity_assembly.Experimental_data_reported"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="entity_assembly.magnetic_equivalence_group_code">
      <rdfs:subPropertyOf rdf:resource="#entity_assemblyItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>entity_assembly.magnetic_equivalence_group_code</rdfs:label>
      <rdfs:comment xml:lang="en">

Unique identifier for the group of assembly components within the assembly
that are magnetically equivalent in that only one set of NMR peaks are observed
for the group.

1
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Entity_assembly.Magnetic_equivalence_group_code"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="entity_assembly.pdb_chain_id">
      <rdfs:subPropertyOf rdf:resource="#entity_assemblyItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>entity_assembly.pdb_chain_id</rdfs:label>
      <rdfs:comment xml:lang="en">

PDB chain ID.

A
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Entity_assembly.PDB_chain_ID"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="entity_assembly.physical_state">
      <rdfs:subPropertyOf rdf:resource="#entity_assemblyItem"/>
      <rdfs:domain rdf:resource="#entity_assembly"/>
      <rdfs:range>
         <owl:DataRange>
            <owl:oneOf>
               <rdf:List>
                  <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">native</rdf:first>
                  <rdf:rest>
                     <rdf:List>
                        <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">denatured</rdf:first>
                        <rdf:rest>
                           <rdf:List>
                              <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">molten globule</rdf:first>
                              <rdf:rest>
                                 <rdf:List>
                                    <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">unfolded</rdf:first>
                                    <rdf:rest>
                                       <rdf:List>
                                          <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">intrinsically disordered</rdf:first>
                                          <rdf:rest>
                                             <rdf:List>
                                                <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">partially disordered</rdf:first>
                                                <rdf:rest>
                                                   <rdf:List>
                                                      <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">na</rdf:first>
                                                      <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                                   </rdf:List>
                                                </rdf:rest>
                                             </rdf:List>
                                          </rdf:rest>
                                       </rdf:List>
                                    </rdf:rest>
                                 </rdf:List>
                              </rdf:rest>
                           </rdf:List>
                        </rdf:rest>
                     </rdf:List>
                  </rdf:rest>
               </rdf:List>
            </owl:oneOf>
         </owl:DataRange>
      </rdfs:range>
      <rdfs:comment xml:lang="en">

An enumerated list of descriptive terms used to define the conformational
state of the component of the assembly.

native
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Entity_assembly.Physical_state"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="entity_assembly.role">
      <rdfs:subPropertyOf rdf:resource="#entity_assemblyItem"/>
