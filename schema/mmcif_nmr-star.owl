      <rdfs:subPropertyOf rdf:resource="#homonucl_noe_listItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>homonucl_noe_list.details</rdfs:label>
