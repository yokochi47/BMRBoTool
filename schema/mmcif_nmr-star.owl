                                                                                                                                                                                                                                                                                                                                                                     <rdf:List>
                                                                                                                                                                                                                                                                                                                                                                        <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">23Na chemical shifts</rdf:first>
