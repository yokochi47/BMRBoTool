      <rdfs:label>reference_to_dist_constraint</rdfs:label>
      <rdfs:comment xml:lang="en">cross-reference to dist_constraint.</rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#reference_to"/>
      <rdfs:domain rdf:resource="#dist_constraint"/>
   </owl:ObjectProperty>
   <owl:ObjectProperty rdf:ID="referenced_by_dist_constraint">
      <rdfs:label>referenced_by_dist_constraint</rdfs:label>
      <rdfs:comment xml:lang="en">cross-reference from dist_constraint.</rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#referenced_by"/>
      <rdfs:range rdf:resource="#dist_constraint"/>
   </owl:ObjectProperty>
   <owl:DatatypeProperty rdf:ID="dist_constraint.assembly_atom_id">
      <rdfs:subPropertyOf rdf:resource="#dist_constraintItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
      <rdfs:label>dist_constraint.assembly_atom_id</rdfs:label>
      <rdfs:comment xml:lang="en">

Pointer to '_Atom.Assembly_atom_ID'
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Dist_constraint.Assembly_atom_ID"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="dist_constraint.atom_id">
      <rdfs:subPropertyOf rdf:resource="#dist_constraintItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>dist_constraint.atom_id</rdfs:label>
      <rdfs:comment xml:lang="en">

Pointer to '_Chem_comp_atom.Atom_ID'
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Dist_constraint.Atom_ID"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="dist_constraint.atom_isotope_number">
      <rdfs:subPropertyOf rdf:resource="#dist_constraintItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
      <rdfs:label>dist_constraint.atom_isotope_number</rdfs:label>
      <rdfs:comment xml:lang="en">

The mass number for the chemical element defined by the tag '_Atom_type'
or any of its related tags.
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Dist_constraint.Atom_isotope_number"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="dist_constraint.atom_type">
      <rdfs:subPropertyOf rdf:resource="#dist_constraintItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>dist_constraint.atom_type</rdfs:label>
      <rdfs:comment xml:lang="en">

The value for this tag is a standard IUPAC abbreviation for an element
(i.e., H, C, P, etc).
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Dist_constraint.Atom_type"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="dist_constraint.auth_asym_id">
      <rdfs:subPropertyOf rdf:resource="#dist_constraintItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>dist_constraint.auth_asym_id</rdfs:label>
      <rdfs:comment xml:lang="en">

An alternative identifier for Asym_ID that may be provided by an author
in order to match that used in the publication that describes the experimental
data.  Note that the value is not required to be a number and does not need to correspond
to the value for Asym_ID. This item is provided as a place holder for
information extracted from distance constraint files generated by various software
applications.
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Dist_constraint.Auth_asym_ID"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="dist_constraint.auth_atom_id">
      <rdfs:subPropertyOf rdf:resource="#dist_constraintItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>dist_constraint.auth_atom_id</rdfs:label>
      <rdfs:comment xml:lang="en">

An alternative identifier for Atom_ID that may be provided by an author
in order to match that used in the publication that describes the experimental data.

HB1
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Dist_constraint.Auth_atom_ID"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="dist_constraint.auth_comp_id">
      <rdfs:subPropertyOf rdf:resource="#dist_constraintItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>dist_constraint.auth_comp_id</rdfs:label>
      <rdfs:comment xml:lang="en">

An alternative identifier for Comp_ID that may be provided by an author
in order to match that used in the publication that describes the experimental data.

DPN
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Dist_constraint.Auth_comp_ID"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="dist_constraint.auth_entity_assembly_id">
      <rdfs:subPropertyOf rdf:resource="#dist_constraintItem"/>
