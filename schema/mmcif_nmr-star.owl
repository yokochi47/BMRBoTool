      <rdfs:label>chem_comp.subcomponent_list</rdfs:label>
      <rdfs:comment xml:lang="en">

The list of subcomponents contained in this component.

TSM DPH HIS CHF EMR
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Chem_comp.Subcomponent_list"/>
      <owl:equivalentProperty rdf:resource="PDBo:chem_comp.pdbx_subcomponent_list"/>
   </owl:DatatypeProperty>
