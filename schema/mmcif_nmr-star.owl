   <owl:Class rdf:ID="terminal_residueCategory">
      <rdfs:subClassOf>
         <owl:Class>
            <owl:intersectionOf rdf:parseType="Collection">
               <owl:Class rdf:about="#Category"/>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#has_terminal_residue"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
            </owl:intersectionOf>
         </owl:Class>
      </rdfs:subClassOf>
   </owl:Class>
   <owl:Class rdf:ID="terminal_residue">
      <rdfs:label>terminal_residue</rdfs:label>
      <rdfs:comment xml:lang="en">

Items in the terminal_residue category define the terminal residue for each molecular entity in the representative conformer.

         </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tag.php?tagcat=Terminal_residue"/>
      <rdfs:subClassOf>
         <owl:Class>
            <owl:intersectionOf rdf:parseType="Collection">
               <owl:Class rdf:about="#CategoryElement"/>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#terminal_residue.auth_comp_id"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#terminal_residue.auth_comp_id"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#terminal_residue.auth_seq_id"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#terminal_residue.auth_seq_id"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#terminal_residue.comp_id"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#terminal_residue.comp_id"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#terminal_residue.seq_id"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#terminal_residue.seq_id"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#terminal_residue.comp_index_id"/>
                  <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#terminal_residue.entity_id"/>
                  <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#terminal_residue.entry_id"/>
                  <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#terminal_residue.representative_conformer_id"/>
                  <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
               </owl:Restriction>
            </owl:intersectionOf>
         </owl:Class>
      </rdfs:subClassOf>
   </owl:Class>
   <owl:InverseFunctionalProperty rdf:ID="has_terminal_residueCategory">
      <rdfs:label>terminal_residueCategory</rdfs:label>
      <rdfs:comment xml:lang="en">
	This property indicates that datablock
	has a category holder terminal_residueCategory.
      </rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#hasCategory"/>
      <rdfs:seeAlso rdf:resource="#terminal_residue"/>
   </owl:InverseFunctionalProperty>
   <owl:InverseFunctionalProperty rdf:ID="has_terminal_residue">
      <rdfs:label>terminal_residueCategory</rdfs:label>
      <rdfs:comment xml:lang="en">
	This property indicates that terminal_residueCategory.
	has a category terminal_residue.
      </rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#hasCategoryElement"/>
      <rdfs:seeAlso rdf:resource="#terminal_residue"/>
      <rdfs:domain rdf:resource="#terminal_residueCategory"/>
      <rdfs:range rdf:resource="#terminal_residue"/>
   </owl:InverseFunctionalProperty>
   <owl:DatatypeProperty rdf:ID="terminal_residueItem">
      <rdfs:label>terminal_residueItem</rdfs:label>
      <rdfs:comment xml:lang="en">Abstract datatype property for terminal_residue items.</rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#categoryItem"/>
      <rdfs:domain rdf:resource="#terminal_residue"/>
   </owl:DatatypeProperty>
   <owl:ObjectProperty rdf:ID="reference_to_terminal_residue">
      <rdfs:label>reference_to_terminal_residue</rdfs:label>
      <rdfs:comment xml:lang="en">cross-reference to terminal_residue.</rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#reference_to"/>
      <rdfs:domain rdf:resource="#terminal_residue"/>
   </owl:ObjectProperty>
   <owl:ObjectProperty rdf:ID="referenced_by_terminal_residue">
      <rdfs:label>referenced_by_terminal_residue</rdfs:label>
      <rdfs:comment xml:lang="en">cross-reference from terminal_residue.</rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#referenced_by"/>
      <rdfs:range rdf:resource="#terminal_residue"/>
   </owl:ObjectProperty>
   <owl:DatatypeProperty rdf:ID="terminal_residue.auth_comp_id">
      <rdfs:subPropertyOf rdf:resource="#terminal_residueItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>terminal_residue.auth_comp_id</rdfs:label>
      <rdfs:comment xml:lang="en">

An alternative identifier for Comp_ID that may be provided by an author
in order to match that used in the publication that describes the experimental data.

DPN
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Terminal_residue.Auth_comp_ID"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="terminal_residue.auth_seq_id">
      <rdfs:subPropertyOf rdf:resource="#terminal_residueItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>terminal_residue.auth_seq_id</rdfs:label>
      <rdfs:comment xml:lang="en">

An alternative identifier for Seq_ID that may be provided by an author
in order to match that used in the publication that describes the experimental data.
Note that the value is not required to be a number and does not need to correspond
to the value for Seq_ID or Comp_index_ID.

-3
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Terminal_residue.Auth_seq_ID"/>
   </owl:DatatypeProperty>
