      <rdfs:subPropertyOf rdf:resource="#citationItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>citation.thesis_institution_city</rdfs:label>
      <rdfs:comment xml:lang="en">

City where the institution awarding the degree is located.

West Lafayette
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Citation.Thesis_institution_city"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="citation.thesis_institution_country">
      <rdfs:subPropertyOf rdf:resource="#citationItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>citation.thesis_institution_country</rdfs:label>
      <rdfs:comment xml:lang="en">

Country where the institution awarding the degree is located.

USA
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Citation.Thesis_institution_country"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="citation.title">
      <rdfs:subPropertyOf rdf:resource="#citationItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>citation.title</rdfs:label>
      <rdfs:comment xml:lang="en">

Title for the publication.

'1H and 15N Assigned Chemical Shifts for RNase A'
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Citation.Title"/>
      <owl:equivalentProperty rdf:resource="PDBo:citation.title"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="citation.type">
      <rdfs:subPropertyOf rdf:resource="#citationItem"/>
      <rdfs:domain rdf:resource="#citation"/>
      <rdfs:range>
         <owl:DataRange>
            <owl:oneOf>
               <rdf:List>
                  <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">journal</rdf:first>
                  <rdf:rest>
                     <rdf:List>
                        <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">book</rdf:first>
                        <rdf:rest>
                           <rdf:List>
                              <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">book chapter</rdf:first>
                              <rdf:rest>
                                 <rdf:List>
                                    <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">thesis</rdf:first>
                                    <rdf:rest>
                                       <rdf:List>
                                          <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">abstract</rdf:first>
                                          <rdf:rest>
                                             <rdf:List>
                                                <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">personal communication</rdf:first>
                                                <rdf:rest>
                                                   <rdf:List>
                                                      <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">internet</rdf:first>
                                                      <rdf:rest>
                                                         <rdf:List>
                                                            <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">BMRB only</rdf:first>
                                                            <rdf:rest>
                                                               <rdf:List>
                                                                  <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">other publication</rdf:first>
                                                                  <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                                               </rdf:List>
                                                            </rdf:rest>
                                                         </rdf:List>
                                                      </rdf:rest>
                                                   </rdf:List>
                                                </rdf:rest>
                                             </rdf:List>
                                          </rdf:rest>
                                       </rdf:List>
                                    </rdf:rest>
                                 </rdf:List>
                              </rdf:rest>
                           </rdf:List>
                        </rdf:rest>
                     </rdf:List>
                  </rdf:rest>
               </rdf:List>
            </owl:oneOf>
         </owl:DataRange>
      </rdfs:range>
      <rdfs:comment xml:lang="en">

Descriptive word that defines the kind of publication reported (journal;
book; thesis; etc.)

journal
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Citation.Type"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="citation.www_url">
      <rdfs:subPropertyOf rdf:resource="#citationItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>citation.www_url</rdfs:label>
      <rdfs:comment xml:lang="en">

A World Wide Web universal locator that identifies the location of the
cited material on the WWW.
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Citation.WWW_URL"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="citation.year">
      <rdfs:subPropertyOf rdf:resource="#citationItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>citation.year</rdfs:label>
      <rdfs:comment xml:lang="en">

Calendar year when the article was published.

2003
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Citation.Year"/>
      <owl:equivalentProperty rdf:resource="PDBo:citation.year"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="citation.entry_id">
      <rdfs:subPropertyOf rdf:resource="#citationItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>citation.entry_id</rdfs:label>
      <rdfs:comment xml:lang="en">

Pointer to '_Entry.ID'

citation
                     </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Citation.Entry_ID"/>
      <owl:equivalentProperty rdf:resource="PDBo:journal.entry_id"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="citation.id">
      <rdfs:subPropertyOf rdf:resource="#citationItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
      <rdfs:label>citation.id</rdfs:label>
      <rdfs:comment xml:lang="en">

A value that uniquely identifies the citation from all other citations
provided in the entry.
                     </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Citation.ID"/>
      <owl:equivalentProperty rdf:resource="PDBo:citation.id"/>
   </owl:DatatypeProperty>
   <owl:Class rdf:ID="citation_authorCategory">
      <rdfs:subClassOf>
         <owl:Class>
            <owl:intersectionOf rdf:parseType="Collection">
               <owl:Class rdf:about="#Category"/>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#has_citation_author"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
            </owl:intersectionOf>
         </owl:Class>
      </rdfs:subClassOf>
   </owl:Class>
   <owl:Class rdf:ID="citation_author">
      <rdfs:label>citation_author</rdfs:label>
      <rdfs:comment xml:lang="en">

Items in the citation_author category define the authors and the order of the names for a citation.

         </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tag.php?tagcat=Citation_author"/>
      <rdfs:subClassOf>
         <owl:Class>
            <owl:intersectionOf rdf:parseType="Collection">
               <owl:Class rdf:about="#CategoryElement"/>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#citation_author.family_name"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#citation_author.family_name"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#citation_author.family_title"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#citation_author.family_title"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#citation_author.first_initial"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#citation_author.first_initial"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#citation_author.given_name"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#citation_author.given_name"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#citation_author.middle_initials"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#citation_author.middle_initials"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#citation_author.orcid"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#citation_author.orcid"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#citation_author.pdbx_name"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#citation_author.pdbx_name"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#citation_author.citation_id"/>
                  <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#citation_author.entry_id"/>
                  <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#citation_author.ordinal"/>
                  <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
               </owl:Restriction>
            </owl:intersectionOf>
         </owl:Class>
      </rdfs:subClassOf>
   </owl:Class>
   <owl:InverseFunctionalProperty rdf:ID="has_citation_authorCategory">
      <rdfs:label>citation_authorCategory</rdfs:label>
      <rdfs:comment xml:lang="en">
	This property indicates that datablock
	has a category holder citation_authorCategory.
      </rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#hasCategory"/>
      <rdfs:seeAlso rdf:resource="#citation_author"/>
   </owl:InverseFunctionalProperty>
   <owl:InverseFunctionalProperty rdf:ID="has_citation_author">
      <rdfs:label>citation_authorCategory</rdfs:label>
      <rdfs:comment xml:lang="en">
	This property indicates that citation_authorCategory.
	has a category citation_author.
      </rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#hasCategoryElement"/>
      <rdfs:seeAlso rdf:resource="#citation_author"/>
      <rdfs:domain rdf:resource="#citation_authorCategory"/>
      <rdfs:range rdf:resource="#citation_author"/>
   </owl:InverseFunctionalProperty>
   <owl:DatatypeProperty rdf:ID="citation_authorItem">
      <rdfs:label>citation_authorItem</rdfs:label>
      <rdfs:comment xml:lang="en">Abstract datatype property for citation_author items.</rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#categoryItem"/>
      <rdfs:domain rdf:resource="#citation_author"/>
   </owl:DatatypeProperty>
   <owl:ObjectProperty rdf:ID="reference_to_citation_author">
      <rdfs:label>reference_to_citation_author</rdfs:label>
      <rdfs:comment xml:lang="en">cross-reference to citation_author.</rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#reference_to"/>
      <rdfs:domain rdf:resource="#citation_author"/>
   </owl:ObjectProperty>
   <owl:ObjectProperty rdf:ID="referenced_by_citation_author">
      <rdfs:label>referenced_by_citation_author</rdfs:label>
      <rdfs:comment xml:lang="en">cross-reference from citation_author.</rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#referenced_by"/>
      <rdfs:range rdf:resource="#citation_author"/>
   </owl:ObjectProperty>
   <owl:DatatypeProperty rdf:ID="citation_author.family_name">
      <rdfs:subPropertyOf rdf:resource="#citation_authorItem"/>
