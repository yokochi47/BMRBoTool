   <owl:DatatypeProperty rdf:ID="rep_conf_refinement.refine_details">
      <rdfs:subPropertyOf rdf:resource="#rep_conf_refinementItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>rep_conf_refinement.refine_details</rdfs:label>
      <rdfs:comment xml:lang="en">

Additional comments about the NMR refinement methods can be placed here.
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Rep_conf_refinement.Refine_details"/>
      <owl:equivalentProperty rdf:resource="PDBo:pdbx_nmr_refine.details"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="rep_conf_refinement.entry_id">
      <rdfs:subPropertyOf rdf:resource="#rep_conf_refinementItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>rep_conf_refinement.entry_id</rdfs:label>
      <rdfs:comment xml:lang="en">

Pointer to '_Entry.ID'
                     </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Rep_conf_refinement.Entry_ID"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="rep_conf_refinement.refine_method">
      <rdfs:subPropertyOf rdf:resource="#rep_conf_refinementItem"/>
      <rdfs:domain rdf:resource="#rep_conf_refinement"/>
      <rdfs:range>
         <owl:DataRange>
            <owl:oneOf>
               <rdf:List>
                  <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">distance geometry</rdf:first>
                  <rdf:rest>
                     <rdf:List>
                        <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DGSA-distance geometry simulated annealing</rdf:first>
                        <rdf:rest>
                           <rdf:List>
                              <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">simulated annealing</rdf:first>
                              <rdf:rest>
                                 <rdf:List>
                                    <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">molecular dynamics</rdf:first>
                                    <rdf:rest>
                                       <rdf:List>
                                          <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">matrix relaxation</rdf:first>
                                          <rdf:rest>
                                             <rdf:List>
                                                <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">torsion angle dynamics</rdf:first>
                                                <rdf:rest>
                                                   <rdf:List>
                                                      <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">na</rdf:first>
                                                      <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                                   </rdf:List>
                                                </rdf:rest>
                                             </rdf:List>
                                          </rdf:rest>
                                       </rdf:List>
                                    </rdf:rest>
                                 </rdf:List>
                              </rdf:rest>
                           </rdf:List>
                        </rdf:rest>
                     </rdf:List>
                  </rdf:rest>
               </rdf:List>
            </owl:oneOf>
         </owl:DataRange>
      </rdfs:range>
      <rdfs:comment xml:lang="en">

The method used to determine the structure.

simulated annealing
                     </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Rep_conf_refinement.Refine_method"/>
      <owl:equivalentProperty rdf:resource="PDBo:pdbx_nmr_refine.method"/>
   </owl:DatatypeProperty>
