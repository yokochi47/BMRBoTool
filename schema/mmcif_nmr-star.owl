   <owl:Class rdf:ID="decoupling_pulse_sequenceCategory">
      <rdfs:subClassOf>
         <owl:Class>
            <owl:intersectionOf rdf:parseType="Collection">
               <owl:Class rdf:about="#Category"/>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#has_decoupling_pulse_sequence"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
            </owl:intersectionOf>
         </owl:Class>
      </rdfs:subClassOf>
   </owl:Class>
   <owl:Class rdf:ID="decoupling_pulse_sequence">
      <rdfs:label>decoupling_pulse_sequence</rdfs:label>
      <rdfs:comment xml:lang="en">

Items in the decoupling_pulse_sequence category define the parameters of a NMR pulse sequence used to decouple the magnetization between nuclei.

         </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tag.php?tagcat=Decoupling_pulse_sequence"/>
      <rdfs:subClassOf>
         <owl:Class>
            <owl:intersectionOf rdf:parseType="Collection">
               <owl:Class rdf:about="#CategoryElement"/>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#decoupling_pulse_sequence.entry_id"/>
                  <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#decoupling_pulse_sequence.name"/>
                  <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#decoupling_pulse_sequence.nmr_spec_expt_id"/>
                  <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#decoupling_pulse_sequence.time_period"/>
                  <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
               </owl:Restriction>
            </owl:intersectionOf>
         </owl:Class>
      </rdfs:subClassOf>
   </owl:Class>
   <owl:InverseFunctionalProperty rdf:ID="has_decoupling_pulse_sequenceCategory">
      <rdfs:label>decoupling_pulse_sequenceCategory</rdfs:label>
      <rdfs:comment xml:lang="en">
	This property indicates that datablock
	has a category holder decoupling_pulse_sequenceCategory.
      </rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#hasCategory"/>
      <rdfs:seeAlso rdf:resource="#decoupling_pulse_sequence"/>
   </owl:InverseFunctionalProperty>
   <owl:InverseFunctionalProperty rdf:ID="has_decoupling_pulse_sequence">
      <rdfs:label>decoupling_pulse_sequenceCategory</rdfs:label>
      <rdfs:comment xml:lang="en">
	This property indicates that decoupling_pulse_sequenceCategory.
	has a category decoupling_pulse_sequence.
      </rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#hasCategoryElement"/>
      <rdfs:seeAlso rdf:resource="#decoupling_pulse_sequence"/>
      <rdfs:domain rdf:resource="#decoupling_pulse_sequenceCategory"/>
      <rdfs:range rdf:resource="#decoupling_pulse_sequence"/>
   </owl:InverseFunctionalProperty>
