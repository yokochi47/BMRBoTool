   <owl:InverseFunctionalProperty rdf:ID="has_characteristicCategory">
      <rdfs:label>characteristicCategory</rdfs:label>
      <rdfs:comment xml:lang="en">
	This property indicates that datablock
	has a category holder characteristicCategory.
      </rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#hasCategory"/>
      <rdfs:seeAlso rdf:resource="#characteristic"/>
   </owl:InverseFunctionalProperty>
   <owl:InverseFunctionalProperty rdf:ID="has_characteristic">
      <rdfs:label>characteristicCategory</rdfs:label>
      <rdfs:comment xml:lang="en">
	This property indicates that characteristicCategory.
	has a category characteristic.
      </rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#hasCategoryElement"/>
      <rdfs:seeAlso rdf:resource="#characteristic"/>
      <rdfs:domain rdf:resource="#characteristicCategory"/>
      <rdfs:range rdf:resource="#characteristic"/>
   </owl:InverseFunctionalProperty>
   <owl:DatatypeProperty rdf:ID="characteristicItem">
      <rdfs:label>characteristicItem</rdfs:label>
