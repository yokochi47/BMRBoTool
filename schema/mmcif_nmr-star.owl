      <rdfs:comment xml:lang="en">

Unique identifier for the reported footnote.
                     </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Atom_sites_footnote.Footnote_ID"/>
   </owl:DatatypeProperty>
   <owl:Class rdf:ID="atom_typeCategory">
      <rdfs:subClassOf>
         <owl:Class>
            <owl:intersectionOf rdf:parseType="Collection">
               <owl:Class rdf:about="#Category"/>
