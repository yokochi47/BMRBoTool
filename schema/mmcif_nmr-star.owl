   </owl:InverseFunctionalProperty>
   <owl:DatatypeProperty rdf:ID="force_constant_listItem">
      <rdfs:label>force_constant_listItem</rdfs:label>
      <rdfs:comment xml:lang="en">Abstract datatype property for force_constant_list items.</rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#categoryItem"/>
      <rdfs:domain rdf:resource="#force_constant_list"/>
   </owl:DatatypeProperty>
   <owl:ObjectProperty rdf:ID="reference_to_force_constant_list">
      <rdfs:label>reference_to_force_constant_list</rdfs:label>
      <rdfs:comment xml:lang="en">cross-reference to force_constant_list.</rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#reference_to"/>
      <rdfs:domain rdf:resource="#force_constant_list"/>
   </owl:ObjectProperty>
   <owl:ObjectProperty rdf:ID="referenced_by_force_constant_list">
      <rdfs:label>referenced_by_force_constant_list</rdfs:label>
      <rdfs:comment xml:lang="en">cross-reference from force_constant_list.</rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#referenced_by"/>
      <rdfs:range rdf:resource="#force_constant_list"/>
   </owl:ObjectProperty>
   <owl:DatatypeProperty rdf:ID="force_constant_list.default_software_values_used">
      <rdfs:subPropertyOf rdf:resource="#force_constant_listItem"/>
      <rdfs:domain rdf:resource="#force_constant_list"/>
      <rdfs:range>
         <owl:DataRange>
            <owl:oneOf>
               <rdf:List>
                  <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">yes</rdf:first>
                  <rdf:rest>
                     <rdf:List>
                        <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">no</rdf:first>
                        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                     </rdf:List>
                  </rdf:rest>
               </rdf:List>
            </owl:oneOf>
