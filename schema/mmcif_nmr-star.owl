      <rdfs:comment xml:lang="en">

Text providing additional details regarding this entity.
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Entity.Details"/>
      <owl:equivalentProperty rdf:resource="PDBo:entity.details"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="entity.ec_number">
