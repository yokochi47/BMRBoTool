      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>chem_comp.name</rdfs:label>
      <rdfs:comment xml:lang="en">

A common name for the chemical component or monomer.

NADP
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Chem_comp.Name"/>
      <owl:equivalentProperty rdf:resource="PDBo:chem_comp.name"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="chem_comp.number_atoms_all">
