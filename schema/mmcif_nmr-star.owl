   <owl:Class rdf:ID="matched_entriesCategory">
      <rdfs:subClassOf>
         <owl:Class>
            <owl:intersectionOf rdf:parseType="Collection">
               <owl:Class rdf:about="#Category"/>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#has_matched_entries"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
            </owl:intersectionOf>
         </owl:Class>
      </rdfs:subClassOf>
   </owl:Class>
   <owl:Class rdf:ID="matched_entries">
      <rdfs:label>matched_entries</rdfs:label>
      <rdfs:comment xml:lang="en">

Items in the matched_entries category provide a list of entries from databases that are matched representing that the data in the entries came from the same experimental study and the same publication.

         </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tag.php?tagcat=Matched_entries"/>
      <rdfs:subClassOf>
         <owl:Class>
            <owl:intersectionOf rdf:parseType="Collection">
               <owl:Class rdf:about="#CategoryElement"/>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#matched_entries.database_accession_code"/>
                  <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#matched_entries.database_name"/>
                  <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#matched_entries.entry_id"/>
                  <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
               </owl:Restriction>
            </owl:intersectionOf>
         </owl:Class>
      </rdfs:subClassOf>
   </owl:Class>
   <owl:InverseFunctionalProperty rdf:ID="has_matched_entriesCategory">
      <rdfs:label>matched_entriesCategory</rdfs:label>
      <rdfs:comment xml:lang="en">
	This property indicates that datablock
	has a category holder matched_entriesCategory.
      </rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#hasCategory"/>
      <rdfs:seeAlso rdf:resource="#matched_entries"/>
   </owl:InverseFunctionalProperty>
   <owl:InverseFunctionalProperty rdf:ID="has_matched_entries">
      <rdfs:label>matched_entriesCategory</rdfs:label>
      <rdfs:comment xml:lang="en">
	This property indicates that matched_entriesCategory.
	has a category matched_entries.
      </rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#hasCategoryElement"/>
      <rdfs:seeAlso rdf:resource="#matched_entries"/>
      <rdfs:domain rdf:resource="#matched_entriesCategory"/>
      <rdfs:range rdf:resource="#matched_entries"/>
   </owl:InverseFunctionalProperty>
   <owl:DatatypeProperty rdf:ID="matched_entriesItem">
      <rdfs:label>matched_entriesItem</rdfs:label>
      <rdfs:comment xml:lang="en">Abstract datatype property for matched_entries items.</rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#categoryItem"/>
      <rdfs:domain rdf:resource="#matched_entries"/>
   </owl:DatatypeProperty>
   <owl:ObjectProperty rdf:ID="reference_to_matched_entries">
      <rdfs:label>reference_to_matched_entries</rdfs:label>
      <rdfs:comment xml:lang="en">cross-reference to matched_entries.</rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#reference_to"/>
      <rdfs:domain rdf:resource="#matched_entries"/>
   </owl:ObjectProperty>
   <owl:ObjectProperty rdf:ID="referenced_by_matched_entries">
      <rdfs:label>referenced_by_matched_entries</rdfs:label>
      <rdfs:comment xml:lang="en">cross-reference from matched_entries.</rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#referenced_by"/>
      <rdfs:range rdf:resource="#matched_entries"/>
   </owl:ObjectProperty>
   <owl:DatatypeProperty rdf:ID="matched_entries.database_accession_code">
      <rdfs:subPropertyOf rdf:resource="#matched_entriesItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>matched_entries.database_accession_code</rdfs:label>
      <rdfs:comment xml:lang="en">

Entry code for an existing entry from the database defined by the tag '_Matched_entries.Database_name'
that is a direct match to the current BMRB entry.

1BRV
                     </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Matched_entries.Database_accession_code"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="matched_entries.database_name">
      <rdfs:subPropertyOf rdf:resource="#matched_entriesItem"/>
      <rdfs:domain rdf:resource="#matched_entries"/>
      <rdfs:range>
         <owl:DataRange>
            <owl:oneOf>
               <rdf:List>
                  <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PDB</rdf:first>
                  <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
               </rdf:List>
            </owl:oneOf>
         </owl:DataRange>
      </rdfs:range>
      <rdfs:comment xml:lang="en">

Name or acronym for a database that has an entry that is a direct match
(usually a PDB entry) to the current BMRB entry.

PDB
                     </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Matched_entries.Database_name"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="matched_entries.entry_id">
      <rdfs:subPropertyOf rdf:resource="#matched_entriesItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>matched_entries.entry_id</rdfs:label>
      <rdfs:comment xml:lang="en">

Pointer to '_Entry.ID'

16034
                     </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Matched_entries.Entry_ID"/>
   </owl:DatatypeProperty>
   <owl:Class rdf:ID="methodCategory">
      <rdfs:subClassOf>
         <owl:Class>
            <owl:intersectionOf rdf:parseType="Collection">
               <owl:Class rdf:about="#Category"/>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#has_method"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
            </owl:intersectionOf>
         </owl:Class>
      </rdfs:subClassOf>
   </owl:Class>
   <owl:Class rdf:ID="method">
      <rdfs:label>method</rdfs:label>
      <rdfs:comment xml:lang="en">

Items in the method category provide meta data about the reported method.

         </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tag.php?tagcat=Method"/>
      <rdfs:subClassOf>
         <owl:Class>
            <owl:intersectionOf rdf:parseType="Collection">
               <owl:Class rdf:about="#CategoryElement"/>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#method.computer_id"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#method.computer_id"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#method.computer_label"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#method.computer_label"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#method.derivation_type"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#method.derivation_type"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#method.details"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#method.details"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#method.name"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#method.name"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#method.sf_category"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
               </owl:Restriction>
