   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="auto_relaxation_list.spectrometer_frequency_1h">
      <rdfs:subPropertyOf rdf:resource="#auto_relaxation_listItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
      <rdfs:label>auto_relaxation_list.spectrometer_frequency_1h</rdfs:label>
      <rdfs:comment xml:lang="en">

The operating proton frequency in MHz of the NMR spectrometer used to collect
the data.

600.1283731
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Auto_relaxation_list.Spectrometer_frequency_1H"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="auto_relaxation_list.temp_calibration_method">
      <rdfs:subPropertyOf rdf:resource="#auto_relaxation_listItem"/>
      <rdfs:domain rdf:resource="#auto_relaxation_list"/>
      <rdfs:range>
         <owl:DataRange>
            <owl:oneOf>
               <rdf:List>
                  <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">methanol</rdf:first>
                  <rdf:rest>
                     <rdf:List>
                        <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">monoethylene glycol</rdf:first>
                        <rdf:rest>
                           <rdf:List>
                              <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">no calibration applied</rdf:first>
                              <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                           </rdf:List>
                        </rdf:rest>
                     </rdf:List>
                  </rdf:rest>
               </rdf:List>
            </owl:oneOf>
         </owl:DataRange>
      </rdfs:range>
      <rdfs:comment xml:lang="en">

Method used to calibrate the temperature unit on the NMR spectrometer used
to collect the experimental data.
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Auto_relaxation_list.Temp_calibration_method"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="auto_relaxation_list.temp_control_method">
      <rdfs:subPropertyOf rdf:resource="#auto_relaxation_listItem"/>
      <rdfs:domain rdf:resource="#auto_relaxation_list"/>
      <rdfs:range>
         <owl:DataRange>
            <owl:oneOf>
               <rdf:List>
                  <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">single scan interleaving</rdf:first>
                  <rdf:rest>
                     <rdf:List>
                        <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">temperature compensation block</rdf:first>
                        <rdf:rest>
                           <rdf:List>
                              <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">single scan interleaving and temperature compensation block</rdf:first>
                              <rdf:rest>
                                 <rdf:List>
                                    <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">no temperature control applied</rdf:first>
                                    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                 </rdf:List>
                              </rdf:rest>
                           </rdf:List>
                        </rdf:rest>
                     </rdf:List>
                  </rdf:rest>
               </rdf:List>
            </owl:oneOf>
         </owl:DataRange>
      </rdfs:range>
      <rdfs:comment xml:lang="en">

Method used to control the temperature of the sample to eliminate heating
caused by the long spin-lock pulse.
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Auto_relaxation_list.Temp_control_method"/>
   </owl:DatatypeProperty>
