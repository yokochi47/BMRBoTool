      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Fluorescence_instrument.Serial_number"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="fluorescence_instrument.sf_category">
      <rdfs:subPropertyOf rdf:resource="#fluorescence_instrumentItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>fluorescence_instrument.sf_category</rdfs:label>
      <rdfs:comment xml:lang="en">

Category assigned to the information in the saveframe.
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Fluorescence_instrument.Sf_category"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="fluorescence_instrument.sf_framecode">
      <rdfs:subPropertyOf rdf:resource="#fluorescence_instrumentItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>fluorescence_instrument.sf_framecode</rdfs:label>
      <rdfs:comment xml:lang="en">

A label that uniquely identifies the fluorescence instrument from other
Fluorescence instruments listed in the entry.
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Fluorescence_instrument.Sf_framecode"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="fluorescence_instrument.type">
