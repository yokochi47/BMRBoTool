               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#chem_comp_assembly.auth_comp_id"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
