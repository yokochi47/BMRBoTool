      <rdfs:subPropertyOf rdf:resource="#nmr_probeItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>nmr_probe.entry_id</rdfs:label>
      <rdfs:comment xml:lang="en">

Pointer to '_Entry.ID'
                     </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_NMR_probe.Entry_ID"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="nmr_probe.nmr_spectrometer_probe_id">
      <rdfs:subPropertyOf rdf:resource="#nmr_probeItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
      <rdfs:label>nmr_probe.nmr_spectrometer_probe_id</rdfs:label>
      <rdfs:comment xml:lang="en">

Pointer to '_NMR_spectrometer_probe.ID'
                     </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_NMR_probe.NMR_spectrometer_probe_ID"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="nmr_probe.type">
      <rdfs:subPropertyOf rdf:resource="#nmr_probeItem"/>
      <rdfs:domain rdf:resource="#nmr_probe"/>
      <rdfs:range>
         <owl:DataRange>
            <owl:oneOf>
               <rdf:List>
                  <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">transmission line</rdf:first>
                  <rdf:rest>
                     <rdf:List>
                        <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">home built</rdf:first>
                        <rdf:rest>
                           <rdf:List>
                              <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">triple resonance</rdf:first>
                              <rdf:rest>
                                 <rdf:List>
                                    <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">double resonance</rdf:first>
                                    <rdf:rest>
                                       <rdf:List>
                                          <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">inverse coil</rdf:first>
                                          <rdf:rest>
                                             <rdf:List>
