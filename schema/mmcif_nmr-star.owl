   <owl:DatatypeProperty rdf:ID="ph_param_list.name">
      <rdfs:subPropertyOf rdf:resource="#ph_param_listItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>ph_param_list.name</rdfs:label>
      <rdfs:comment xml:lang="en">

A name assigned to the save frame.
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_PH_param_list.Name"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="ph_param_list.observed_nmr_param">
      <rdfs:subPropertyOf rdf:resource="#ph_param_listItem"/>
      <rdfs:domain rdf:resource="#ph_param_list"/>
      <rdfs:range>
         <owl:DataRange>
            <owl:oneOf>
               <rdf:List>
                  <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">chemical shift</rdf:first>
                  <rdf:rest>
                     <rdf:List>
                        <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">coupling constant</rdf:first>
                        <rdf:rest>
                           <rdf:List>
                              <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">peak height</rdf:first>
                              <rdf:rest>
                                 <rdf:List>
                                    <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">peak volume</rdf:first>
                                    <rdf:rest>
                                       <rdf:List>
                                          <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">na</rdf:first>
                                          <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                       </rdf:List>
                                    </rdf:rest>
                                 </rdf:List>
                              </rdf:rest>
                           </rdf:List>
                        </rdf:rest>
                     </rdf:List>
                  </rdf:rest>
               </rdf:List>
            </owl:oneOf>
         </owl:DataRange>
      </rdfs:range>
      <rdfs:comment xml:lang="en">

The spectral parameter or derived parameter measured and used to determine
the effect of pH on the macromolecule.

chemical shift; peak height
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_PH_param_list.Observed_NMR_param"/>
   </owl:DatatypeProperty>
