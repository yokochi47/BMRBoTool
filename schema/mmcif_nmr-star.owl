      <rdfs:comment xml:lang="en">

Pointer to '_Atom.Assembly_atom_ID'
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Tertiary_struct.Assembly_atom_ID"/>
