      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Sample_component.Product_ID"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="sample_component.type">
