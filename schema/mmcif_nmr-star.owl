   <owl:InverseFunctionalProperty rdf:ID="has_chem_comp_atomCategory">
      <rdfs:label>chem_comp_atomCategory</rdfs:label>
      <rdfs:comment xml:lang="en">
	This property indicates that datablock
	has a category holder chem_comp_atomCategory.
      </rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#hasCategory"/>
      <rdfs:seeAlso rdf:resource="#chem_comp_atom"/>
   </owl:InverseFunctionalProperty>
   <owl:InverseFunctionalProperty rdf:ID="has_chem_comp_atom">
      <rdfs:label>chem_comp_atomCategory</rdfs:label>
      <rdfs:comment xml:lang="en">
	This property indicates that chem_comp_atomCategory.
	has a category chem_comp_atom.
      </rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#hasCategoryElement"/>
      <rdfs:seeAlso rdf:resource="#chem_comp_atom"/>
      <rdfs:domain rdf:resource="#chem_comp_atomCategory"/>
      <rdfs:range rdf:resource="#chem_comp_atom"/>
   </owl:InverseFunctionalProperty>
   <owl:DatatypeProperty rdf:ID="chem_comp_atomItem">
      <rdfs:label>chem_comp_atomItem</rdfs:label>
      <rdfs:comment xml:lang="en">Abstract datatype property for chem_comp_atom items.</rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#categoryItem"/>
      <rdfs:domain rdf:resource="#chem_comp_atom"/>
   </owl:DatatypeProperty>
   <owl:ObjectProperty rdf:ID="reference_to_chem_comp_atom">
      <rdfs:label>reference_to_chem_comp_atom</rdfs:label>
      <rdfs:comment xml:lang="en">cross-reference to chem_comp_atom.</rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#reference_to"/>
      <rdfs:domain rdf:resource="#chem_comp_atom"/>
   </owl:ObjectProperty>
   <owl:ObjectProperty rdf:ID="referenced_by_chem_comp_atom">
      <rdfs:label>referenced_by_chem_comp_atom</rdfs:label>
      <rdfs:comment xml:lang="en">cross-reference from chem_comp_atom.</rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#referenced_by"/>
      <rdfs:range rdf:resource="#chem_comp_atom"/>
   </owl:ObjectProperty>
   <owl:DatatypeProperty rdf:ID="chem_comp_atom.align">
      <rdfs:subPropertyOf rdf:resource="#chem_comp_atomItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
      <rdfs:label>chem_comp_atom.align</rdfs:label>
      <rdfs:comment xml:lang="en">

Determines which column the atom name appears within the PDB coordinate
files. The possible values are 0 or 1.
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Chem_comp_atom.Align"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="chem_comp_atom.alt_atom_id">
      <rdfs:subPropertyOf rdf:resource="#chem_comp_atomItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>chem_comp_atom.alt_atom_id</rdfs:label>
      <rdfs:comment xml:lang="en">

An alternative identifier for the atom. This data item would be used in
cases where alternative nomenclatures exist for labelling atoms in a group.
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Chem_comp_atom.Alt_atom_ID"/>
      <owl:equivalentProperty rdf:resource="PDBo:chem_comp_atom.pdbx_alt_atom_id"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="chem_comp_atom.aromatic_flag">
      <rdfs:subPropertyOf rdf:resource="#chem_comp_atomItem"/>
      <rdfs:domain rdf:resource="#chem_comp_atom"/>
      <rdfs:range>
         <owl:DataRange>
            <owl:oneOf>
               <rdf:List>
                  <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">yes</rdf:first>
                  <rdf:rest>
                     <rdf:List>
                        <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">no</rdf:first>
                        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                     </rdf:List>
                  </rdf:rest>
               </rdf:List>
            </owl:oneOf>
         </owl:DataRange>
      </rdfs:range>
      <rdfs:comment xml:lang="en">

A flag indicating an aromatic atom.

yes
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Chem_comp_atom.Aromatic_flag"/>
      <owl:equivalentProperty rdf:resource="PDBo:chem_comp_atom.pdbx_aromatic_flag"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="chem_comp_atom.auth_atom_id">
      <rdfs:subPropertyOf rdf:resource="#chem_comp_atomItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>chem_comp_atom.auth_atom_id</rdfs:label>
      <rdfs:comment xml:lang="en">

An alternative identifier for Atom_ID that may be provided by an author
in order to match that used in the publication that describes the experimental data.

HB1
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Chem_comp_atom.Auth_atom_ID"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="chem_comp_atom.bmrb_code">
      <rdfs:subPropertyOf rdf:resource="#chem_comp_atomItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>chem_comp_atom.bmrb_code</rdfs:label>
      <rdfs:comment xml:lang="en">

A code assigned to the atom by BMRB that is unique within the chemical compound.
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Chem_comp_atom.BMRB_code"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="chem_comp_atom.charge">
      <rdfs:subPropertyOf rdf:resource="#chem_comp_atomItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>chem_comp_atom.charge</rdfs:label>
      <rdfs:comment xml:lang="en">

The net integer charge assigned to this atom. This is the formal charge
assignment normally found in chemical diagrams.
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Chem_comp_atom.Charge"/>
      <owl:equivalentProperty rdf:resource="PDBo:chem_comp_atom.charge"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="chem_comp_atom.chirality">
      <rdfs:subPropertyOf rdf:resource="#chem_comp_atomItem"/>
      <rdfs:domain rdf:resource="#chem_comp_atom"/>
      <rdfs:range>
         <owl:DataRange>
            <owl:oneOf>
               <rdf:List>
                  <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">N</rdf:first>
                  <rdf:rest>
                     <rdf:List>
                        <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">E</rdf:first>
                        <rdf:rest>
                           <rdf:List>
                              <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Z</rdf:first>
                              <rdf:rest>
                                 <rdf:List>
                                    <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R</rdf:first>
                                    <rdf:rest>
                                       <rdf:List>
                                          <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">S</rdf:first>
                                          <rdf:rest>
                                             <rdf:List>
                                                <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">pro-R</rdf:first>
                                                <rdf:rest>
                                                   <rdf:List>
                                                      <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">pro-S</rdf:first>
                                                      <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                                   </rdf:List>
                                                </rdf:rest>
                                             </rdf:List>
                                          </rdf:rest>
                                       </rdf:List>
                                    </rdf:rest>
                                 </rdf:List>
                              </rdf:rest>
                           </rdf:List>
                        </rdf:rest>
                     </rdf:List>
                  </rdf:rest>
               </rdf:List>
            </owl:oneOf>
         </owl:DataRange>
      </rdfs:range>
      <rdfs:comment xml:lang="en">

The chiral or prochiral characteristic of the atom.

R;S;E;Z;pro-R;pro-S
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Chem_comp_atom.Chirality"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="chem_comp_atom.details">
      <rdfs:subPropertyOf rdf:resource="#chem_comp_atomItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>chem_comp_atom.details</rdfs:label>
      <rdfs:comment xml:lang="en">

Text providing additional information about the atom.
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Chem_comp_atom.Details"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="chem_comp_atom.drawing_2d_coord_x">
      <rdfs:subPropertyOf rdf:resource="#chem_comp_atomItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
      <rdfs:label>chem_comp_atom.drawing_2d_coord_x</rdfs:label>
      <rdfs:comment xml:lang="en">

X coordinate of a data point in a two-dimensional drawing of the chemical
compound.
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Chem_comp_atom.Drawing_2D_coord_x"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="chem_comp_atom.drawing_2d_coord_y">
      <rdfs:subPropertyOf rdf:resource="#chem_comp_atomItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
      <rdfs:label>chem_comp_atom.drawing_2d_coord_y</rdfs:label>
      <rdfs:comment xml:lang="en">

Y coordinate of a data point in a two-dimensional drawing of the chemical
compound.
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Chem_comp_atom.Drawing_2D_coord_y"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="chem_comp_atom.ionizable">
      <rdfs:subPropertyOf rdf:resource="#chem_comp_atomItem"/>
      <rdfs:domain rdf:resource="#chem_comp_atom"/>
      <rdfs:range>
         <owl:DataRange>
            <owl:oneOf>
               <rdf:List>
                  <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">yes</rdf:first>
                  <rdf:rest>
                     <rdf:List>
                        <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">no</rdf:first>
                        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                     </rdf:List>
                  </rdf:rest>
               </rdf:List>
            </owl:oneOf>
         </owl:DataRange>
      </rdfs:range>
      <rdfs:comment xml:lang="en">

A code indicating the potential for the atom to be in an ionized state.
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Chem_comp_atom.Ionizable"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="chem_comp_atom.isotope_number">
      <rdfs:subPropertyOf rdf:resource="#chem_comp_atomItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
      <rdfs:label>chem_comp_atom.isotope_number</rdfs:label>
      <rdfs:comment xml:lang="en">

Mass number assigned to the atom.
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Chem_comp_atom.Isotope_number"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="chem_comp_atom.leaving_atom_flag">
      <rdfs:subPropertyOf rdf:resource="#chem_comp_atomItem"/>
      <rdfs:domain rdf:resource="#chem_comp_atom"/>
      <rdfs:range>
         <owl:DataRange>
            <owl:oneOf>
               <rdf:List>
                  <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">yes</rdf:first>
                  <rdf:rest>
                     <rdf:List>
                        <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">no</rdf:first>
                        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                     </rdf:List>
                  </rdf:rest>
               </rdf:List>
            </owl:oneOf>
         </owl:DataRange>
      </rdfs:range>
      <rdfs:comment xml:lang="en">

A flag indicating a leaving atom.
                        </rdfs:comment>
