      </rdfs:range>
      <rdfs:comment xml:lang="en">

Another level of description of the type of constraints in the file (simple,
ambiguous, etc.)

yes
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Constraint_file.Constraint_subsubtype"/>
   </owl:DatatypeProperty>
