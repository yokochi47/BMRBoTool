A name assigned to the save frame.
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Chem_shift_reference.Name"/>
   </owl:DatatypeProperty>
