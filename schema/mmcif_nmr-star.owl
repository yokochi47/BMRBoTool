               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#atom_nomenclature.comp_id"/>
                  <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
               </owl:Restriction>
