   <owl:Class rdf:ID="mass_specCategory">
      <rdfs:subClassOf>
         <owl:Class>
            <owl:intersectionOf rdf:parseType="Collection">
               <owl:Class rdf:about="#Category"/>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#has_mass_spec"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
            </owl:intersectionOf>
         </owl:Class>
      </rdfs:subClassOf>
   </owl:Class>
   <owl:Class rdf:ID="mass_spec">
      <rdfs:label>mass_spec</rdfs:label>
      <rdfs:comment xml:lang="en">

Items in the mass_spec category provide meta information about the mass spectrometer described.

         </rdfs:comment>
