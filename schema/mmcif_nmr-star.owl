      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Chem_comp.Formula_weight"/>
      <owl:equivalentProperty rdf:resource="PDBo:chem_comp.formula_weight"/>
