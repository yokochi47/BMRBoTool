   <owl:DatatypeProperty rdf:ID="deduced_h_bond.donor_atom_id">
      <rdfs:subPropertyOf rdf:resource="#deduced_h_bondItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>deduced_h_bond.donor_atom_id</rdfs:label>
      <rdfs:comment xml:lang="en">

Pointer to '_Chem_comp_atom.Atom_ID'. The atom designated is the one that
is donating the proton in the hydrogen bond.
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Deduced_H_bond.Donor_atom_ID"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="deduced_h_bond.figure_of_merit">
      <rdfs:subPropertyOf rdf:resource="#deduced_h_bondItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
      <rdfs:label>deduced_h_bond.figure_of_merit</rdfs:label>
      <rdfs:comment xml:lang="en">

A value that indicates the certainty with which this hydrogen bond is believed
to exist.
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Deduced_H_bond.Figure_of_merit"/>
   </owl:DatatypeProperty>
