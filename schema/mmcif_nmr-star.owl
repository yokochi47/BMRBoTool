      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Sample.Sf_framecode"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="sample.single_crystal_protocol">
      <rdfs:subPropertyOf rdf:resource="#sampleItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>sample.single_crystal_protocol</rdfs:label>
      <rdfs:comment xml:lang="en">

Text protocol used to prepare single crystals.
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Sample.Single_crystal_protocol"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="sample.solvent_system">
      <rdfs:subPropertyOf rdf:resource="#sampleItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>sample.solvent_system</rdfs:label>
      <rdfs:comment xml:lang="en">

The solvent components of the sample.

95% H2O/5% D2O
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Sample.Solvent_system"/>
      <owl:equivalentProperty rdf:resource="PDBo:pdbx_nmr_sample_details.solvent_system"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="sample.storage_protocol">
      <rdfs:subPropertyOf rdf:resource="#sampleItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>sample.storage_protocol</rdfs:label>
      <rdfs:comment xml:lang="en">

Protocol used for storing sample.
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Sample.Storage_protocol"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="sample.sub_type">
      <rdfs:subPropertyOf rdf:resource="#sampleItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>sample.sub_type</rdfs:label>
      <rdfs:comment xml:lang="en">

Solid and solution NMR samples of different types are often used. Please
select the specific type of sample used.

polycrystalline
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Sample.Sub_type"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="sample.type">
      <rdfs:subPropertyOf rdf:resource="#sampleItem"/>
      <rdfs:domain rdf:resource="#sample"/>
      <rdfs:range>
         <owl:DataRange>
            <owl:oneOf>
               <rdf:List>
                  <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">solution</rdf:first>
                  <rdf:rest>
                     <rdf:List>
                        <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">solid</rdf:first>
                        <rdf:rest>
                           <rdf:List>
                              <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">bicelle</rdf:first>
                              <rdf:rest>
                                 <rdf:List>
                                    <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">emulsion</rdf:first>
                                    <rdf:rest>
                                       <rdf:List>
                                          <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">fiber</rdf:first>
                                          <rdf:rest>
                                             <rdf:List>
                                                <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">filamentous virus</rdf:first>
                                                <rdf:rest>
                                                   <rdf:List>
                                                      <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">gel solution</rdf:first>
                                                      <rdf:rest>
                                                         <rdf:List>
                                                            <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">gel solid</rdf:first>
                                                            <rdf:rest>
                                                               <rdf:List>
                                                                  <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">liposome</rdf:first>
                                                                  <rdf:rest>
                                                                     <rdf:List>
                                                                        <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">membrane</rdf:first>
                                                                        <rdf:rest>
                                                                           <rdf:List>
                                                                              <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">micelle</rdf:first>
                                                                              <rdf:rest>
                                                                                 <rdf:List>
                                                                                    <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">lyophilized powder</rdf:first>
                                                                                    <rdf:rest>
                                                                                       <rdf:List>
                                                                                          <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">oriented membrane film</rdf:first>
                                                                                          <rdf:rest>
                                                                                             <rdf:List>
                                                                                                <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">fibrous protein</rdf:first>
                                                                                                <rdf:rest>
                                                                                                   <rdf:List>
                                                                                                      <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">polycrystalline powder</rdf:first>
                                                                                                      <rdf:rest>
                                                                                                         <rdf:List>
                                                                                                            <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">reverse micelle</rdf:first>
                                                                                                            <rdf:rest>
                                                                                                               <rdf:List>
                                                                                                                  <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">single crystal</rdf:first>
                                                                                                                  <rdf:rest>
                                                                                                                     <rdf:List>
                                                                                                                        <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">microcrystalline</rdf:first>
                                                                                                                        <rdf:rest>
                                                                                                                           <rdf:List>
                                                                                                                              <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">liquid crystal</rdf:first>
                                                                                                                              <rdf:rest>
                                                                                                                                 <rdf:List>
                                                                                                                                    <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">in-cell</rdf:first>
                                                                                                                                    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                                                                                                                 </rdf:List>
                                                                                                                              </rdf:rest>
                                                                                                                           </rdf:List>
                                                                                                                        </rdf:rest>
                                                                                                                     </rdf:List>
                                                                                                                  </rdf:rest>
                                                                                                               </rdf:List>
                                                                                                            </rdf:rest>
                                                                                                         </rdf:List>
                                                                                                      </rdf:rest>
                                                                                                   </rdf:List>
                                                                                                </rdf:rest>
                                                                                             </rdf:List>
                                                                                          </rdf:rest>
                                                                                       </rdf:List>
                                                                                    </rdf:rest>
                                                                                 </rdf:List>
                                                                              </rdf:rest>
                                                                           </rdf:List>
                                                                        </rdf:rest>
                                                                     </rdf:List>
                                                                  </rdf:rest>
                                                               </rdf:List>
                                                            </rdf:rest>
                                                         </rdf:List>
                                                      </rdf:rest>
                                                   </rdf:List>
                                                </rdf:rest>
                                             </rdf:List>
                                          </rdf:rest>
                                       </rdf:List>
                                    </rdf:rest>
                                 </rdf:List>
                              </rdf:rest>
                           </rdf:List>
                        </rdf:rest>
                     </rdf:List>
                  </rdf:rest>
               </rdf:List>
            </owl:oneOf>
         </owl:DataRange>
      </rdfs:range>
      <rdfs:comment xml:lang="en">

A descriptive term for the sample that defines the general physical properties
of the sample.

solution
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Sample.Type"/>
      <owl:equivalentProperty rdf:resource="PDBo:pdbx_nmr_sample_details.type"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="sample.entry_id">
      <rdfs:subPropertyOf rdf:resource="#sampleItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>sample.entry_id</rdfs:label>
      <rdfs:comment xml:lang="en">

Pointer to '_Entry.ID'
                     </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Sample.Entry_ID"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="sample.id">
      <rdfs:subPropertyOf rdf:resource="#sampleItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
      <rdfs:label>sample.id</rdfs:label>
      <rdfs:comment xml:lang="en">

A value that uniquely identifies the sample described from the other samples
listed in the entry.
                     </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Sample.ID"/>
      <owl:equivalentProperty rdf:resource="PDBo:pdbx_nmr_sample_details.solution_id"/>
   </owl:DatatypeProperty>
   <owl:Class rdf:ID="sample_citationCategory">
      <rdfs:subClassOf>
         <owl:Class>
            <owl:intersectionOf rdf:parseType="Collection">
               <owl:Class rdf:about="#Category"/>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#has_sample_citation"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
            </owl:intersectionOf>
         </owl:Class>
      </rdfs:subClassOf>
   </owl:Class>
   <owl:Class rdf:ID="sample_citation">
      <rdfs:label>sample_citation</rdfs:label>
      <rdfs:comment xml:lang="en">

Items in the sample_citation category provide links to the citations category where reference citations with information about a sample or its preparation can be found.

         </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tag.php?tagcat=Sample_citation"/>
      <rdfs:subClassOf>
         <owl:Class>
            <owl:intersectionOf rdf:parseType="Collection">
               <owl:Class rdf:about="#CategoryElement"/>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#sample_citation.citation_label"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#sample_citation.citation_label"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#sample_citation.citation_id"/>
                  <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#sample_citation.entry_id"/>
                  <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#sample_citation.sample_id"/>
                  <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
               </owl:Restriction>
            </owl:intersectionOf>
         </owl:Class>
      </rdfs:subClassOf>
   </owl:Class>
   <owl:InverseFunctionalProperty rdf:ID="has_sample_citationCategory">
      <rdfs:label>sample_citationCategory</rdfs:label>
      <rdfs:comment xml:lang="en">
	This property indicates that datablock
	has a category holder sample_citationCategory.
      </rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#hasCategory"/>
      <rdfs:seeAlso rdf:resource="#sample_citation"/>
   </owl:InverseFunctionalProperty>
   <owl:InverseFunctionalProperty rdf:ID="has_sample_citation">
      <rdfs:label>sample_citationCategory</rdfs:label>
      <rdfs:comment xml:lang="en">
	This property indicates that sample_citationCategory.
	has a category sample_citation.
      </rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#hasCategoryElement"/>
      <rdfs:seeAlso rdf:resource="#sample_citation"/>
      <rdfs:domain rdf:resource="#sample_citationCategory"/>
      <rdfs:range rdf:resource="#sample_citation"/>
   </owl:InverseFunctionalProperty>
   <owl:DatatypeProperty rdf:ID="sample_citationItem">
      <rdfs:label>sample_citationItem</rdfs:label>
