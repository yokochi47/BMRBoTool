Pointer to '_NMR_spec_expt.ID'
                     </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Decoupling_pulse_sequence.NMR_spec_expt_ID"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="decoupling_pulse_sequence.time_period">
      <rdfs:subPropertyOf rdf:resource="#decoupling_pulse_sequenceItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>decoupling_pulse_sequence.time_period</rdfs:label>
      <rdfs:comment xml:lang="en">

Specific time period during the full pulse sequence where the decoupling
pulse sequence is applied.
                     </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Decoupling_pulse_sequence.Time_period"/>
   </owl:DatatypeProperty>
   <owl:Class rdf:ID="deduced_h_bondCategory">
      <rdfs:subClassOf>
         <owl:Class>
            <owl:intersectionOf rdf:parseType="Collection">
               <owl:Class rdf:about="#Category"/>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#has_deduced_h_bond"/>
