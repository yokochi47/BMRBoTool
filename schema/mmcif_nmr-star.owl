The net integer charge assigned to this atom. This is the formal charge
assignment normally found in chemical diagrams.

-1
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Atom_site.PDBX_formal_charge"/>
      <owl:equivalentProperty rdf:resource="PDBo:atom_site.pdbx_formal_charge"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="atom_site.pdbx_label_asym_id">
