Pointer to '_Entry.ID'
                     </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Chem_shift_reference.Entry_ID"/>
      <owl:equivalentProperty rdf:resource="PDBo:pdbx_nmr_chem_shift_reference.entry_id"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="chem_shift_reference.id">
      <rdfs:subPropertyOf rdf:resource="#chem_shift_referenceItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
      <rdfs:label>chem_shift_reference.id</rdfs:label>
