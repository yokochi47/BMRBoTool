	has a category holder chem_comp_assemblyCategory.
      </rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#hasCategory"/>
      <rdfs:seeAlso rdf:resource="#chem_comp_assembly"/>
   </owl:InverseFunctionalProperty>
   <owl:InverseFunctionalProperty rdf:ID="has_chem_comp_assembly">
      <rdfs:label>chem_comp_assemblyCategory</rdfs:label>
      <rdfs:comment xml:lang="en">
	This property indicates that chem_comp_assemblyCategory.
	has a category chem_comp_assembly.
      </rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#hasCategoryElement"/>
      <rdfs:seeAlso rdf:resource="#chem_comp_assembly"/>
      <rdfs:domain rdf:resource="#chem_comp_assemblyCategory"/>
      <rdfs:range rdf:resource="#chem_comp_assembly"/>
   </owl:InverseFunctionalProperty>
