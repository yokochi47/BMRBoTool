                                                                                                                                                                                                                                                                                                                                                                                       <rdf:List>
                                                                                                                                                                                                                                                                                                                                                                                          <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">129Xe chemical shifts</rdf:first>
