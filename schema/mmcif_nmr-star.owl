BMRB
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Chem_comp.Provenance"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="chem_comp.pubchem_code">
