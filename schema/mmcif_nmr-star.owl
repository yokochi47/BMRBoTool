      <rdfs:subPropertyOf rdf:resource="#isotope_label_patternItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
      <rdfs:label>isotope_label_pattern.atom_isotope_number</rdfs:label>
      <rdfs:comment xml:lang="en">

The mass number for the chemical element defined by the tag '_Atom_type'
or any of its related tags.
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Isotope_label_pattern.Atom_isotope_number"/>
   </owl:DatatypeProperty>
