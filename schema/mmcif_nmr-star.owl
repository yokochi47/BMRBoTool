Synonym list for the component.
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Chem_comp.Synonyms"/>
      <owl:equivalentProperty rdf:resource="PDBo:chem_comp.pdbx_synonyms"/>
