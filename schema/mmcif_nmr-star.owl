      <rdfs:comment xml:lang="en">cross-reference to nmr_experiment_file.</rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#reference_to"/>
      <rdfs:domain rdf:resource="#nmr_experiment_file"/>
   </owl:ObjectProperty>
   <owl:ObjectProperty rdf:ID="referenced_by_nmr_experiment_file">
      <rdfs:label>referenced_by_nmr_experiment_file</rdfs:label>
      <rdfs:comment xml:lang="en">cross-reference from nmr_experiment_file.</rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#referenced_by"/>
      <rdfs:range rdf:resource="#nmr_experiment_file"/>
   </owl:ObjectProperty>
   <owl:DatatypeProperty rdf:ID="nmr_experiment_file.byte_order">
      <rdfs:subPropertyOf rdf:resource="#nmr_experiment_fileItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>nmr_experiment_file.byte_order</rdfs:label>
      <rdfs:comment xml:lang="en">

How the bytes (usually 4, but sometimes 3, for example on AM spectrometers)
are arranged.  Depends on the computer platform employed.
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_NMR_experiment_file.Byte_order"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="nmr_experiment_file.bytes_per_data_point">
      <rdfs:subPropertyOf rdf:resource="#nmr_experiment_fileItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
      <rdfs:label>nmr_experiment_file.bytes_per_data_point</rdfs:label>
      <rdfs:comment xml:lang="en">

Number of bytes per data point.  Most Sun, SGI, and Linux systems use 4
bytes ( of 8 bits each yielding a total of 32 bits) per point.
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_NMR_experiment_file.Bytes_per_data_point"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="nmr_experiment_file.compression_algorithm">
      <rdfs:subPropertyOf rdf:resource="#nmr_experiment_fileItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>nmr_experiment_file.compression_algorithm</rdfs:label>
      <rdfs:comment xml:lang="en">

Algorithm used to compress the NMR experiment file.
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_NMR_experiment_file.Compression_algorithm"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="nmr_experiment_file.details">
      <rdfs:subPropertyOf rdf:resource="#nmr_experiment_fileItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>nmr_experiment_file.details</rdfs:label>
      <rdfs:comment xml:lang="en">

Additional information regarding the time-domain (raw) data file for this
NMR experiment.
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_NMR_experiment_file.Details"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="nmr_experiment_file.directory_path">
      <rdfs:subPropertyOf rdf:resource="#nmr_experiment_fileItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>nmr_experiment_file.directory_path</rdfs:label>
      <rdfs:comment xml:lang="en">

The directory path within the BMRB archive that must be followed to locate
listed NMR experiment file.
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_NMR_experiment_file.Directory_path"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="nmr_experiment_file.file_header_size">
      <rdfs:subPropertyOf rdf:resource="#nmr_experiment_fileItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
      <rdfs:label>nmr_experiment_file.file_header_size</rdfs:label>
      <rdfs:comment xml:lang="en">

Size in bytes of the file header associated with the raw unprocessed data.
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_NMR_experiment_file.File_header_size"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="nmr_experiment_file.record_header_size">
      <rdfs:subPropertyOf rdf:resource="#nmr_experiment_fileItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
      <rdfs:label>nmr_experiment_file.record_header_size</rdfs:label>
      <rdfs:comment xml:lang="en">

Size in bytes of the record header within the NMR experiment file.
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_NMR_experiment_file.Record_header_size"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="nmr_experiment_file.record_trailer_size">
      <rdfs:subPropertyOf rdf:resource="#nmr_experiment_fileItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
      <rdfs:label>nmr_experiment_file.record_trailer_size</rdfs:label>
      <rdfs:comment xml:lang="en">

Size in bytes of the record trailer within the NMR experiment file.
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_NMR_experiment_file.Record_trailer_size"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="nmr_experiment_file.type">
      <rdfs:subPropertyOf rdf:resource="#nmr_experiment_fileItem"/>
      <rdfs:domain rdf:resource="#nmr_experiment_file"/>
      <rdfs:range>
         <owl:DataRange>
            <owl:oneOf>
               <rdf:List>
                  <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NMR experiment directory</rdf:first>
                  <rdf:rest>
                     <rdf:List>
                        <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Time-domain (raw spectral data)</rdf:first>
                        <rdf:rest>
                           <rdf:List>
                              <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Pulse sequence image file</rdf:first>
                              <rdf:rest>
                                 <rdf:List>
                                    <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Pulse sequence</rdf:first>
                                    <rdf:rest>
                                       <rdf:List>
                                          <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Pulse field gradient</rdf:first>
                                          <rdf:rest>
                                             <rdf:List>
                                                <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Peak list</rdf:first>
                                                <rdf:rest>
                                                   <rdf:List>
                                                      <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Spectral image</rdf:first>
                                                      <rdf:rest>
                                                         <rdf:List>
                                                            <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Acquisition parameters</rdf:first>
                                                            <rdf:rest>
                                                               <rdf:List>
                                                                  <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Processing parameters</rdf:first>
                                                                  <rdf:rest>
                                                                     <rdf:List>
                                                                        <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">na</rdf:first>
                                                                        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                                                     </rdf:List>
                                                                  </rdf:rest>
                                                               </rdf:List>
                                                            </rdf:rest>
                                                         </rdf:List>
                                                      </rdf:rest>
                                                   </rdf:List>
                                                </rdf:rest>
                                             </rdf:List>
                                          </rdf:rest>
                                       </rdf:List>
                                    </rdf:rest>
                                 </rdf:List>
                              </rdf:rest>
                           </rdf:List>
                        </rdf:rest>
                     </rdf:List>
                  </rdf:rest>
               </rdf:List>
            </owl:oneOf>
         </owl:DataRange>
      </rdfs:range>
      <rdfs:comment xml:lang="en">

The type of time-domain file being deposited.

NMR experiment directory
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_NMR_experiment_file.Type"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="nmr_experiment_file.entry_id">
      <rdfs:subPropertyOf rdf:resource="#nmr_experiment_fileItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>nmr_experiment_file.entry_id</rdfs:label>
      <rdfs:comment xml:lang="en">

Pointer to '_Entry.ID'
                     </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_NMR_experiment_file.Entry_ID"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="nmr_experiment_file.name">
      <rdfs:subPropertyOf rdf:resource="#nmr_experiment_fileItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>nmr_experiment_file.name</rdfs:label>
      <rdfs:comment xml:lang="en">

The name of the file containing information relevant to the NMR experiment.
Multiple files can be listed.  These files might include the time-domain (raw)
data for the NMR experiment, the pulse sequence for the experiment, and parameters
for acquiring and processing the data.

1H15N_HSQC
                     </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_NMR_experiment_file.Name"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="nmr_experiment_file.nmr_spec_expt_id">
      <rdfs:subPropertyOf rdf:resource="#nmr_experiment_fileItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
      <rdfs:label>nmr_experiment_file.nmr_spec_expt_id</rdfs:label>
      <rdfs:comment xml:lang="en">

Pointer to '_NMR_spec_expt.ID'
                     </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_NMR_experiment_file.NMR_spec_expt_ID"/>
   </owl:DatatypeProperty>
