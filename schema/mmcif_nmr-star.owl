   <owl:DatatypeProperty rdf:ID="ms_chromatogram_list.text_data">
      <rdfs:subPropertyOf rdf:resource="#ms_chromatogram_listItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>ms_chromatogram_list.text_data</rdfs:label>
      <rdfs:comment xml:lang="en">

A set of MZ ratio data formatted as ASCII text.
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_MS_chromatogram_list.Text_data"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="ms_chromatogram_list.text_data_format">
      <rdfs:subPropertyOf rdf:resource="#ms_chromatogram_listItem"/>
      <rdfs:domain rdf:resource="#ms_chromatogram_list"/>
      <rdfs:range>
         <owl:DataRange>
            <owl:oneOf>
               <rdf:List>
                  <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">mzML</rdf:first>
                  <rdf:rest>
                     <rdf:List>
                        <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">mzDAta</rdf:first>
                        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                     </rdf:List>
                  </rdf:rest>
               </rdf:List>
            </owl:oneOf>
         </owl:DataRange>
      </rdfs:range>
      <rdfs:comment xml:lang="en">

The data format used to represent the MZ ratio data as ASCII text in the
text block that is the value to the '_MS_chromatogram_list.Text_data' tag.
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_MS_chromatogram_list.Text_data_format"/>
   </owl:DatatypeProperty>
