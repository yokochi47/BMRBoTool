1
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Conformer_stat_list.Representative_conformer"/>
      <owl:equivalentProperty rdf:resource="PDBo:pdbx_nmr_ensemble.representative_conformer"/>
   </owl:DatatypeProperty>
