   <owl:InverseFunctionalProperty rdf:ID="has_entity_db_linkCategory">
      <rdfs:label>entity_db_linkCategory</rdfs:label>
      <rdfs:comment xml:lang="en">
	This property indicates that datablock
	has a category holder entity_db_linkCategory.
      </rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#hasCategory"/>
      <rdfs:seeAlso rdf:resource="#entity_db_link"/>
   </owl:InverseFunctionalProperty>
   <owl:InverseFunctionalProperty rdf:ID="has_entity_db_link">
      <rdfs:label>entity_db_linkCategory</rdfs:label>
      <rdfs:comment xml:lang="en">
	This property indicates that entity_db_linkCategory.
	has a category entity_db_link.
      </rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#hasCategoryElement"/>
      <rdfs:seeAlso rdf:resource="#entity_db_link"/>
      <rdfs:domain rdf:resource="#entity_db_linkCategory"/>
      <rdfs:range rdf:resource="#entity_db_link"/>
   </owl:InverseFunctionalProperty>
   <owl:DatatypeProperty rdf:ID="entity_db_linkItem">
      <rdfs:label>entity_db_linkItem</rdfs:label>
      <rdfs:comment xml:lang="en">Abstract datatype property for entity_db_link items.</rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#categoryItem"/>
      <rdfs:domain rdf:resource="#entity_db_link"/>
   </owl:DatatypeProperty>
   <owl:ObjectProperty rdf:ID="reference_to_entity_db_link">
      <rdfs:label>reference_to_entity_db_link</rdfs:label>
      <rdfs:comment xml:lang="en">cross-reference to entity_db_link.</rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#reference_to"/>
      <rdfs:domain rdf:resource="#entity_db_link"/>
   </owl:ObjectProperty>
   <owl:ObjectProperty rdf:ID="referenced_by_entity_db_link">
      <rdfs:label>referenced_by_entity_db_link</rdfs:label>
      <rdfs:comment xml:lang="en">cross-reference from entity_db_link.</rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#referenced_by"/>
      <rdfs:range rdf:resource="#entity_db_link"/>
   </owl:ObjectProperty>
   <owl:DatatypeProperty rdf:ID="entity_db_link.author_supplied">
      <rdfs:subPropertyOf rdf:resource="#entity_db_linkItem"/>
      <rdfs:domain rdf:resource="#entity_db_link"/>
      <rdfs:range>
         <owl:DataRange>
            <owl:oneOf>
               <rdf:List>
                  <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">yes</rdf:first>
                  <rdf:rest>
                     <rdf:List>
                        <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">no</rdf:first>
                        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                     </rdf:List>
                  </rdf:rest>
               </rdf:List>
            </owl:oneOf>
         </owl:DataRange>
      </rdfs:range>
      <rdfs:comment xml:lang="en">

A code indicating that the link to a related database was provided by an
author (yes) or obtained through another method (no).

yes
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Entity_db_link.Author_supplied"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="entity_db_link.chimera_segment_id">
      <rdfs:subPropertyOf rdf:resource="#entity_db_linkItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
      <rdfs:label>entity_db_link.chimera_segment_id</rdfs:label>
      <rdfs:comment xml:lang="en">

Code indicating if the listed database link is specific to the fragment
of the entity described by the tag '_Entity.Fragment'.
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Entity_db_link.Chimera_segment_ID"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="entity_db_link.entry_details">
      <rdfs:subPropertyOf rdf:resource="#entity_db_linkItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>entity_db_link.entry_details</rdfs:label>
      <rdfs:comment xml:lang="en">

Text providing additional information about the matching entry.
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Entity_db_link.Entry_details"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="entity_db_link.entry_experimental_method">
      <rdfs:subPropertyOf rdf:resource="#entity_db_linkItem"/>
      <rdfs:domain rdf:resource="#entity_db_link"/>
      <rdfs:range>
         <owl:DataRange>
            <owl:oneOf>
               <rdf:List>
                  <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">solution NMR</rdf:first>
                  <rdf:rest>
                     <rdf:List>
                        <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">solid-state NMR</rdf:first>
                        <rdf:rest>
                           <rdf:List>
                              <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">X-ray crystallography</rdf:first>
                              <rdf:rest>
                                 <rdf:List>
                                    <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">na</rdf:first>
                                    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                 </rdf:List>
                              </rdf:rest>
                           </rdf:List>
                        </rdf:rest>
                     </rdf:List>
                  </rdf:rest>
               </rdf:List>
            </owl:oneOf>
         </owl:DataRange>
      </rdfs:range>
      <rdfs:comment xml:lang="en">

For structural databases, the method used to determine the structure.
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Entity_db_link.Entry_experimental_method"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="entity_db_link.entry_mol_code">
      <rdfs:subPropertyOf rdf:resource="#entity_db_linkItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>entity_db_link.entry_mol_code</rdfs:label>
      <rdfs:comment xml:lang="en">

Code assigned by the database to the molecule in the database entry.
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Entity_db_link.Entry_mol_code"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="entity_db_link.entry_mol_name">
      <rdfs:subPropertyOf rdf:resource="#entity_db_linkItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>entity_db_link.entry_mol_name</rdfs:label>
      <rdfs:comment xml:lang="en">

Name of the molecular entity in the database entry.

Cyt c
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Entity_db_link.Entry_mol_name"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="entity_db_link.entry_relation_type">
      <rdfs:subPropertyOf rdf:resource="#entity_db_linkItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>entity_db_link.entry_relation_type</rdfs:label>
      <rdfs:comment xml:lang="en">

A brief description of how the database entry is related to the molecular
entity.
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Entity_db_link.Entry_relation_type"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="entity_db_link.entry_structure_resolution">
      <rdfs:subPropertyOf rdf:resource="#entity_db_linkItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
      <rdfs:label>entity_db_link.entry_structure_resolution</rdfs:label>
      <rdfs:comment xml:lang="en">

A value taken from the database that is a measure of the quality of the
structure.
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Entity_db_link.Entry_structure_resolution"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="entity_db_link.ordinal">
      <rdfs:subPropertyOf rdf:resource="#entity_db_linkItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
      <rdfs:label>entity_db_link.ordinal</rdfs:label>
      <rdfs:comment xml:lang="en">

An integer value used to maintain the order of the rows in the entity DB
loop when reading and writing NMR-STAR files.
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Entity_db_link.Ordinal"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="entity_db_link.seq_align_begin">
      <rdfs:subPropertyOf rdf:resource="#entity_db_linkItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>entity_db_link.seq_align_begin</rdfs:label>
      <rdfs:comment xml:lang="en">

The sequence position in the database sequence at which the alignment with
the sequence of the biopolymer studied begins.

10
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Entity_db_link.Seq_align_begin"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="entity_db_link.seq_align_end">
      <rdfs:subPropertyOf rdf:resource="#entity_db_linkItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>entity_db_link.seq_align_end</rdfs:label>
      <rdfs:comment xml:lang="en">

The sequence position in the database sequence at which the alignment with
the sequence of the biopolymer studied.

95
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Entity_db_link.Seq_align_end"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="entity_db_link.seq_alignment_details">
      <rdfs:subPropertyOf rdf:resource="#entity_db_linkItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>entity_db_link.seq_alignment_details</rdfs:label>
      <rdfs:comment xml:lang="en">

Text describing the alignment between the matched polymer sequences.
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Entity_db_link.Seq_alignment_details"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="entity_db_link.seq_difference_details">
      <rdfs:subPropertyOf rdf:resource="#entity_db_linkItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>entity_db_link.seq_difference_details</rdfs:label>
      <rdfs:comment xml:lang="en">

Text describing the differences in the sequences for the matched polymers.
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Entity_db_link.Seq_difference_details"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="entity_db_link.seq_homology_expectation_val">
      <rdfs:subPropertyOf rdf:resource="#entity_db_linkItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
      <rdfs:label>entity_db_link.seq_homology_expectation_val</rdfs:label>
      <rdfs:comment xml:lang="en">

The BLAST expectation value for the homology between the retrieved polymer
and the molecular entity.
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Entity_db_link.Seq_homology_expectation_val"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="entity_db_link.seq_identity">
      <rdfs:subPropertyOf rdf:resource="#entity_db_linkItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
      <rdfs:label>entity_db_link.seq_identity</rdfs:label>
      <rdfs:comment xml:lang="en">

Number of residues in the retrieved sequence that have identical positions
in the molecular entity determined by a homology alignment method.
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Entity_db_link.Seq_identity"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="entity_db_link.seq_positive">
      <rdfs:subPropertyOf rdf:resource="#entity_db_linkItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
      <rdfs:label>entity_db_link.seq_positive</rdfs:label>
      <rdfs:comment xml:lang="en">

Number of residues in the retrieved sequence where the corresponding residue
in the molecular entity sequence has similar physical characteristics (hydrophobicity,
charge, etc.)
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Entity_db_link.Seq_positive"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="entity_db_link.seq_query_to_submitted_percent">
      <rdfs:subPropertyOf rdf:resource="#entity_db_linkItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
      <rdfs:label>entity_db_link.seq_query_to_submitted_percent</rdfs:label>
      <rdfs:comment xml:lang="en">

In percent, the ratio of the length of retrieve sequence to the length
of the sequence of the molecular entity. This value can be used to determine if
the retrieved sequence is a subset or superset of the molecular entity.
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Entity_db_link.Seq_query_to_submitted_percent"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="entity_db_link.seq_subject_length">
      <rdfs:subPropertyOf rdf:resource="#entity_db_linkItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
      <rdfs:label>entity_db_link.seq_subject_length</rdfs:label>
      <rdfs:comment xml:lang="en">

Length of the polymer sequence retrieve from the database.
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Entity_db_link.Seq_subject_length"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="entity_db_link.accession_code">
