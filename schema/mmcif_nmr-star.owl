      <rdfs:label>other_data.entity_id</rdfs:label>
      <rdfs:comment xml:lang="en">

Pointer to '_Entity.ID'
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Other_data.Entity_ID"/>
