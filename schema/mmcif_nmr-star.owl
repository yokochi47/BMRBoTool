Pointer to '_Struct_asym.ID'
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Atom_site.PDBX_label_asym_ID"/>
      <owl:equivalentProperty rdf:resource="PDBo:atom_site.label_asym_id"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="atom_site.pdbx_label_atom_id">
