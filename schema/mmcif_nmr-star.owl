   <owl:InverseFunctionalProperty rdf:ID="has_other_dataCategory">
      <rdfs:label>other_dataCategory</rdfs:label>
      <rdfs:comment xml:lang="en">
	This property indicates that datablock
	has a category holder other_dataCategory.
      </rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#hasCategory"/>
      <rdfs:seeAlso rdf:resource="#other_data"/>
   </owl:InverseFunctionalProperty>
   <owl:InverseFunctionalProperty rdf:ID="has_other_data">
      <rdfs:label>other_dataCategory</rdfs:label>
      <rdfs:comment xml:lang="en">
	This property indicates that other_dataCategory.
	has a category other_data.
      </rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#hasCategoryElement"/>
      <rdfs:seeAlso rdf:resource="#other_data"/>
      <rdfs:domain rdf:resource="#other_dataCategory"/>
      <rdfs:range rdf:resource="#other_data"/>
   </owl:InverseFunctionalProperty>
   <owl:DatatypeProperty rdf:ID="other_dataItem">
      <rdfs:label>other_dataItem</rdfs:label>
