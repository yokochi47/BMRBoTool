               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#cross_correlation_d_csa_experiment.experiment_id"/>
                  <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
               </owl:Restriction>
            </owl:intersectionOf>
         </owl:Class>
      </rdfs:subClassOf>
