	has a category conformer_stat_list.
      </rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#hasCategoryElement"/>
      <rdfs:seeAlso rdf:resource="#conformer_stat_list"/>
      <rdfs:domain rdf:resource="#conformer_stat_listCategory"/>
      <rdfs:range rdf:resource="#conformer_stat_list"/>
   </owl:InverseFunctionalProperty>
