   <owl:DatatypeProperty rdf:ID="torsion_angle_constraint_list.constraint_type">
      <rdfs:subPropertyOf rdf:resource="#torsion_angle_constraint_listItem"/>
      <rdfs:domain rdf:resource="#torsion_angle_constraint_list"/>
      <rdfs:range>
         <owl:DataRange>
            <owl:oneOf>
               <rdf:List>
                  <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">J-couplings</rdf:first>
                  <rdf:rest>
                     <rdf:List>
                        <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">backbone chemical shifts</rdf:first>
                        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                     </rdf:List>
                  </rdf:rest>
               </rdf:List>
            </owl:oneOf>
         </owl:DataRange>
      </rdfs:range>
