               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#sample_condition_variable.entry_id"/>
                  <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#sample_condition_variable.sample_condition_list_id"/>
