               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#ambiguous_atom_chem_shift.ambiguous_shift_set_id"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
