   <owl:InverseFunctionalProperty rdf:ID="has_pb_listCategory">
      <rdfs:label>pb_listCategory</rdfs:label>
      <rdfs:comment xml:lang="en">
	This property indicates that datablock
	has a category holder pb_listCategory.
      </rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#hasCategory"/>
      <rdfs:seeAlso rdf:resource="#pb_list"/>
   </owl:InverseFunctionalProperty>
   <owl:InverseFunctionalProperty rdf:ID="has_pb_list">
      <rdfs:label>pb_listCategory</rdfs:label>
      <rdfs:comment xml:lang="en">
	This property indicates that pb_listCategory.
	has a category pb_list.
      </rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#hasCategoryElement"/>
      <rdfs:seeAlso rdf:resource="#pb_list"/>
      <rdfs:domain rdf:resource="#pb_listCategory"/>
      <rdfs:range rdf:resource="#pb_list"/>
   </owl:InverseFunctionalProperty>
   <owl:DatatypeProperty rdf:ID="pb_listItem">
      <rdfs:label>pb_listItem</rdfs:label>
      <rdfs:comment xml:lang="en">Abstract datatype property for pb_list items.</rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#categoryItem"/>
      <rdfs:domain rdf:resource="#pb_list"/>
   </owl:DatatypeProperty>
   <owl:ObjectProperty rdf:ID="reference_to_pb_list">
      <rdfs:label>reference_to_pb_list</rdfs:label>
      <rdfs:comment xml:lang="en">cross-reference to pb_list.</rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#reference_to"/>
      <rdfs:domain rdf:resource="#pb_list"/>
   </owl:ObjectProperty>
   <owl:ObjectProperty rdf:ID="referenced_by_pb_list">
      <rdfs:label>referenced_by_pb_list</rdfs:label>
      <rdfs:comment xml:lang="en">cross-reference from pb_list.</rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#referenced_by"/>
      <rdfs:range rdf:resource="#pb_list"/>
   </owl:ObjectProperty>
   <owl:DatatypeProperty rdf:ID="pb_list.aa_seq_one_letter_code">
      <rdfs:subPropertyOf rdf:resource="#pb_listItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>pb_list.aa_seq_one_letter_code</rdfs:label>
      <rdfs:comment xml:lang="en">

The sequence of a polymer entity of PDB coordinate expressed using only
the standard one-letter code for chemical components.
                        </rdfs:comment>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="pb_list.electronic_address">
      <rdfs:subPropertyOf rdf:resource="#pb_listItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>pb_list.electronic_address</rdfs:label>
      <rdfs:comment xml:lang="en">

URL, email, or other electronic address from which the PB annotation
was extracted.
                        </rdfs:comment>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="pb_list.input_file_name">
      <rdfs:subPropertyOf rdf:resource="#pb_listItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>pb_list.input_file_name</rdfs:label>
      <rdfs:comment xml:lang="en">

Name of the file that conteins PDB coordinates used as source data for the PB annotation.
                        </rdfs:comment>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="pb_list.output_file_name">
      <rdfs:subPropertyOf rdf:resource="#pb_listItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>pb_list.output_file_name</rdfs:label>
      <rdfs:comment xml:lang="en">

Name of the file that conteins the PB annotation.
                        </rdfs:comment>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="pb_list.pb_seq_code">
      <rdfs:subPropertyOf rdf:resource="#pb_listItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>pb_list.pb_seq_code</rdfs:label>
      <rdfs:comment xml:lang="en">

The sequence of a polymer entity of PDB coordinate expressed using
Protein Block codes.
                        </rdfs:comment>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="pb_list.pdb_id">
      <rdfs:subPropertyOf rdf:resource="#pb_listItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>pb_list.pdb_id</rdfs:label>
      <rdfs:comment xml:lang="en">

PDB accession number used for the PB annotation.

2JM0
                        </rdfs:comment>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="pb_list.pdbx_exptl_method">
      <rdfs:subPropertyOf rdf:resource="#pb_listItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>pb_list.pdbx_exptl_method</rdfs:label>
      <rdfs:comment xml:lang="en">

The method used in the experiment for structure determination.
Hybrid methods are concatenated by commas.

Pointer to '__exptl.method' of PDBx/mmCIF Dictionary.

SOLUTION NMR
                        </rdfs:comment>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="pb_list.pdbx_nmr_refine_method">
      <rdfs:subPropertyOf rdf:resource="#pb_listItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>pb_list.pdbx_nmr_refine_method</rdfs:label>
      <rdfs:comment xml:lang="en">

Describe the method and details of the refinement of the deposited structure.

Pointer to '_pdbx_nmr_refine.method' of PDBx/mmCIF Dictionary.

DISTANCE GEOMETRY, SIMULATED ANNEALING
                        </rdfs:comment>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="pb_list.pdbx_refine_ls_d_res_high">
      <rdfs:subPropertyOf rdf:resource="#pb_listItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
      <rdfs:label>pb_list.pdbx_refine_ls_d_res_high</rdfs:label>
      <rdfs:comment xml:lang="en">

The smallest value for the interplanar spacings for the
reflection data used in the refinement in angstroms. This is
called the highest resolution.

Pointer to '_refine.ls_d_res_high' of PDBx/mmCIF Dictionary.
                        </rdfs:comment>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="pb_list.pdbx_refine_ls_d_res_low">
      <rdfs:subPropertyOf rdf:resource="#pb_listItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
      <rdfs:label>pb_list.pdbx_refine_ls_d_res_low</rdfs:label>
      <rdfs:comment xml:lang="en">

The largest value for the interplanar spacings for
the reflection data used in the refinement in angstroms.
This is called the lowest resolution.

Pointer to '_refine.ls_d_res_low' of PDBx/mmCIF Dictionary.
                        </rdfs:comment>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="pb_list.pdbx_refine_ls_r_factor_r_free">
      <rdfs:subPropertyOf rdf:resource="#pb_listItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
      <rdfs:label>pb_list.pdbx_refine_ls_r_factor_r_free</rdfs:label>
      <rdfs:comment xml:lang="en">

Pointer to '_refine.ls_R_factor_R_free' of PDBx/mmCIF Dictionary.
                        </rdfs:comment>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="pb_list.pdbx_refine_ls_r_factor_r_work">
      <rdfs:subPropertyOf rdf:resource="#pb_listItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
      <rdfs:label>pb_list.pdbx_refine_ls_r_factor_r_work</rdfs:label>
      <rdfs:comment xml:lang="en">

Pointer to '_refine.ls_R_factor_R_work' of PDBx/mmCIF Dictionary.
                        </rdfs:comment>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="pb_list.queried_date">
      <rdfs:subPropertyOf rdf:resource="#pb_listItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
      <rdfs:label>pb_list.queried_date</rdfs:label>
      <rdfs:comment xml:lang="en">

Date the file from which the PB annotation was extracted was
last queried for new information.
                        </rdfs:comment>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="pb_list.query_id">
      <rdfs:subPropertyOf rdf:resource="#pb_listItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>pb_list.query_id</rdfs:label>
      <rdfs:comment xml:lang="en">

Unique query ID which was assigned for PB annotation by the PB annotation server
(Protein Blocks Expert 2.0).
                        </rdfs:comment>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="pb_list.sf_category">
      <rdfs:subPropertyOf rdf:resource="#pb_listItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>pb_list.sf_category</rdfs:label>
      <rdfs:comment xml:lang="en">

Category definition for the information content of the saveframe
                        </rdfs:comment>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="pb_list.sf_framecode">
      <rdfs:subPropertyOf rdf:resource="#pb_listItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>pb_list.sf_framecode</rdfs:label>
      <rdfs:comment xml:lang="en">

A label for the saveframe that describes in very brief terms the information
contained in the saveframe.
                        </rdfs:comment>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="pb_list.sf_id">
      <rdfs:subPropertyOf rdf:resource="#pb_listItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
      <rdfs:label>pb_list.sf_id</rdfs:label>
      <rdfs:comment xml:lang="en">

An interger value that is the unique identifier for the saveframe that
applies across the archive.  This value is not stable and may be reassigned each
time the data are loaded into a database system.
                        </rdfs:comment>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="pb_list.entry_id">
      <rdfs:subPropertyOf rdf:resource="#pb_listItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>pb_list.entry_id</rdfs:label>
      <rdfs:comment xml:lang="en">

Pointer to '_Entry.ID'
                     </rdfs:comment>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="pb_list.id">
      <rdfs:subPropertyOf rdf:resource="#pb_listItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
      <rdfs:label>pb_list.id</rdfs:label>
      <rdfs:comment xml:lang="en">

Unique identifier for the list of reported Protain Block annotation.
                     </rdfs:comment>
