                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Other_data.Comp_ID"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="other_data.comp_index_id">
