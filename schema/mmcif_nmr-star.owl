                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#assembly.molecules_in_chemical_exchange"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#assembly.molecules_in_chemical_exchange"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#assembly.name"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#assembly.name"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#assembly.non_standard_bonds"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#assembly.non_standard_bonds"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#assembly.number_of_components"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#assembly.number_of_components"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#assembly.organic_ligands"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#assembly.organic_ligands"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#assembly.paramagnetic"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#assembly.paramagnetic"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#assembly.sf_category"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#assembly.sf_category"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#assembly.sf_framecode"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#assembly.sf_framecode"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#assembly.thiol_state"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#assembly.thiol_state"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#assembly.entry_id"/>
                  <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#assembly.id"/>
                  <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
               </owl:Restriction>
            </owl:intersectionOf>
         </owl:Class>
      </rdfs:subClassOf>
   </owl:Class>
   <owl:InverseFunctionalProperty rdf:ID="has_assemblyCategory">
      <rdfs:label>assemblyCategory</rdfs:label>
      <rdfs:comment xml:lang="en">
	This property indicates that datablock
	has a category holder assemblyCategory.
      </rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#hasCategory"/>
      <rdfs:seeAlso rdf:resource="#assembly"/>
   </owl:InverseFunctionalProperty>
   <owl:InverseFunctionalProperty rdf:ID="has_assembly">
      <rdfs:label>assemblyCategory</rdfs:label>
      <rdfs:comment xml:lang="en">
	This property indicates that assemblyCategory.
	has a category assembly.
      </rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#hasCategoryElement"/>
      <rdfs:seeAlso rdf:resource="#assembly"/>
      <rdfs:domain rdf:resource="#assemblyCategory"/>
      <rdfs:range rdf:resource="#assembly"/>
   </owl:InverseFunctionalProperty>
   <owl:DatatypeProperty rdf:ID="assemblyItem">
      <rdfs:label>assemblyItem</rdfs:label>
      <rdfs:comment xml:lang="en">Abstract datatype property for assembly items.</rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#categoryItem"/>
      <rdfs:domain rdf:resource="#assembly"/>
   </owl:DatatypeProperty>
   <owl:ObjectProperty rdf:ID="reference_to_assembly">
      <rdfs:label>reference_to_assembly</rdfs:label>
      <rdfs:comment xml:lang="en">cross-reference to assembly.</rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#reference_to"/>
      <rdfs:domain rdf:resource="#assembly"/>
   </owl:ObjectProperty>
   <owl:ObjectProperty rdf:ID="referenced_by_assembly">
      <rdfs:label>referenced_by_assembly</rdfs:label>
      <rdfs:comment xml:lang="en">cross-reference from assembly.</rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#referenced_by"/>
      <rdfs:range rdf:resource="#assembly"/>
   </owl:ObjectProperty>
   <owl:DatatypeProperty rdf:ID="assembly.ambiguous_chem_comp_sites">
      <rdfs:subPropertyOf rdf:resource="#assemblyItem"/>
      <rdfs:domain rdf:resource="#assembly"/>
      <rdfs:range>
         <owl:DataRange>
            <owl:oneOf>
               <rdf:List>
                  <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">yes</rdf:first>
                  <rdf:rest>
                     <rdf:List>
                        <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">no</rdf:first>
                        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                     </rdf:List>
                  </rdf:rest>
               </rdf:List>
            </owl:oneOf>
         </owl:DataRange>
      </rdfs:range>
      <rdfs:comment xml:lang="en">

A yes/no flag automatically filled in by BMRB software on the basis of
information (tag _Mol_ambiguous_moiety_sites) provided in the saveframes used to
described the molecules in the system.

yes
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Assembly.Ambiguous_chem_comp_sites"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="assembly.ambiguous_conformational_states">
      <rdfs:subPropertyOf rdf:resource="#assemblyItem"/>
      <rdfs:domain rdf:resource="#assembly"/>
      <rdfs:range>
         <owl:DataRange>
            <owl:oneOf>
               <rdf:List>
                  <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">yes</rdf:first>
                  <rdf:rest>
                     <rdf:List>
                        <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">no</rdf:first>
                        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                     </rdf:List>
                  </rdf:rest>
               </rdf:List>
            </owl:oneOf>
         </owl:DataRange>
      </rdfs:range>
      <rdfs:comment xml:lang="en">

A yes/no flag automatically filled in by BMRB software on the basis of
the information (tag _Molecule_ambiguous conformational_states) provided in the
saveframes used to described the molecules in the system.

yes
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Assembly.Ambiguous_conformational_states"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="assembly.bmrb_code">
      <rdfs:subPropertyOf rdf:resource="#assemblyItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>assembly.bmrb_code</rdfs:label>
      <rdfs:comment xml:lang="en">

Unique identifier for the molecular system in the BMRB library of molecular
system definitions.
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Assembly.BMRB_code"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="assembly.db_query_date">
      <rdfs:subPropertyOf rdf:resource="#assemblyItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
      <rdfs:label>assembly.db_query_date</rdfs:label>
      <rdfs:comment xml:lang="en">

Date the database was queried to derive links to the molecular assembly
studied.  GenBank is the database queried for these links.
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Assembly.DB_query_date"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="assembly.db_query_revised_last_date">
      <rdfs:subPropertyOf rdf:resource="#assemblyItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
      <rdfs:label>assembly.db_query_revised_last_date</rdfs:label>
      <rdfs:comment xml:lang="en">

The last date when new links to the molecular assembly were found through
the database query.
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Assembly.DB_query_revised_last_date"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="assembly.details">
      <rdfs:subPropertyOf rdf:resource="#assemblyItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>assembly.details</rdfs:label>
      <rdfs:comment xml:lang="en">

Text description for the molecular system studied.
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Assembly.Details"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="assembly.enzyme_commission_number">
      <rdfs:subPropertyOf rdf:resource="#assemblyItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>assembly.enzyme_commission_number</rdfs:label>
      <rdfs:comment xml:lang="en">

The Enzyme Commission decimal code (number) assigned to the protein or
molecular assembly, if available.

2.1.5.8.2
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Assembly.Enzyme_commission_number"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="assembly.metal_ions">
      <rdfs:subPropertyOf rdf:resource="#assemblyItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
      <rdfs:label>assembly.metal_ions</rdfs:label>
      <rdfs:comment xml:lang="en">

Total number of metal ions known to exist in the molecular system

1
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Assembly.Metal_ions"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="assembly.molecular_mass">
      <rdfs:subPropertyOf rdf:resource="#assemblyItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
      <rdfs:label>assembly.molecular_mass</rdfs:label>
      <rdfs:comment xml:lang="en">

Mass of the molecular system in Daltons.  This value may be approximate.

17600
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Assembly.Molecular_mass"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="assembly.molecules_in_chemical_exchange">
      <rdfs:subPropertyOf rdf:resource="#assemblyItem"/>
      <rdfs:domain rdf:resource="#assembly"/>
      <rdfs:range>
         <owl:DataRange>
            <owl:oneOf>
               <rdf:List>
                  <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">yes</rdf:first>
                  <rdf:rest>
                     <rdf:List>
                        <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">no</rdf:first>
                        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                     </rdf:List>
                  </rdf:rest>
               </rdf:List>
            </owl:oneOf>
         </owl:DataRange>
      </rdfs:range>
      <rdfs:comment xml:lang="en">

A yes/no flag that indicates when two molecular components in the system
are in chemical exchange (I.e. a ligand that exists in both the free and bound state).

yes
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Assembly.Molecules_in_chemical_exchange"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="assembly.name">
      <rdfs:subPropertyOf rdf:resource="#assemblyItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>assembly.name</rdfs:label>
      <rdfs:comment xml:lang="en">

Brief descriptive name for the molecular assembly studied.

'p53 tetramer'
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Assembly.Name"/>
      <owl:equivalentProperty rdf:resource="PDBo:struct.pdbx_descriptor"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="assembly.non_standard_bonds">
      <rdfs:subPropertyOf rdf:resource="#assemblyItem"/>
      <rdfs:domain rdf:resource="#assembly"/>
      <rdfs:range>
         <owl:DataRange>
            <owl:oneOf>
               <rdf:List>
                  <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">yes</rdf:first>
                  <rdf:rest>
                     <rdf:List>
                        <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">no</rdf:first>
                        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                     </rdf:List>
                  </rdf:rest>
               </rdf:List>
            </owl:oneOf>
         </owl:DataRange>
      </rdfs:range>
      <rdfs:comment xml:lang="en">

The molecular assembly contains covalent bonds such as cross-linking disulfide
bonds; non-standard residue-residue bonds; ligand-residue bonds; or metal
coordination bonds.

yes
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Assembly.Non_standard_bonds"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="assembly.number_of_components">
      <rdfs:subPropertyOf rdf:resource="#assemblyItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
      <rdfs:label>assembly.number_of_components</rdfs:label>
      <rdfs:comment xml:lang="en">

An integer that represents the total number of molecular components that
comprise the molecular system.

4
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Assembly.Number_of_components"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="assembly.organic_ligands">
      <rdfs:subPropertyOf rdf:resource="#assemblyItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
      <rdfs:label>assembly.organic_ligands</rdfs:label>
      <rdfs:comment xml:lang="en">

Total number of organic ligands known to exist in the full molecular system.

1
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Assembly.Organic_ligands"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="assembly.paramagnetic">
      <rdfs:subPropertyOf rdf:resource="#assemblyItem"/>
      <rdfs:domain rdf:resource="#assembly"/>
      <rdfs:range>
         <owl:DataRange>
            <owl:oneOf>
               <rdf:List>
                  <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">yes</rdf:first>
                  <rdf:rest>
                     <rdf:List>
                        <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">no</rdf:first>
                        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                     </rdf:List>
                  </rdf:rest>
               </rdf:List>
            </owl:oneOf>
         </owl:DataRange>
      </rdfs:range>
      <rdfs:comment xml:lang="en">

A Yes or No flag used to describe whether the system is paramagnetic.

yes
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Assembly.Paramagnetic"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="assembly.sf_category">
      <rdfs:subPropertyOf rdf:resource="#assemblyItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>assembly.sf_category</rdfs:label>
      <rdfs:comment xml:lang="en">

Category assigned to the information in the saveframe.
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Assembly.Sf_category"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="assembly.sf_framecode">
      <rdfs:subPropertyOf rdf:resource="#assemblyItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>assembly.sf_framecode</rdfs:label>
      <rdfs:comment xml:lang="en">

A descriptive label for the molecular assembly studied.
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Assembly.Sf_framecode"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="assembly.thiol_state">
      <rdfs:subPropertyOf rdf:resource="#assemblyItem"/>
      <rdfs:domain rdf:resource="#assembly"/>
      <rdfs:range>
         <owl:DataRange>
            <owl:oneOf>
               <rdf:List>
                  <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">all disulfide bound</rdf:first>
                  <rdf:rest>
                     <rdf:List>
                        <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">all other bound</rdf:first>
                        <rdf:rest>
                           <rdf:List>
                              <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">all free</rdf:first>
                              <rdf:rest>
                                 <rdf:List>
                                    <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">not present</rdf:first>
                                    <rdf:rest>
                                       <rdf:List>
                                          <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">not available</rdf:first>
                                          <rdf:rest>
                                             <rdf:List>
                                                <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">unknown</rdf:first>
                                                <rdf:rest>
                                                   <rdf:List>
                                                      <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">not reported</rdf:first>
                                                      <rdf:rest>
                                                         <rdf:List>
                                                            <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">free and disulfide bound</rdf:first>
                                                            <rdf:rest>
                                                               <rdf:List>
                                                                  <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">free and other bound</rdf:first>
                                                                  <rdf:rest>
                                                                     <rdf:List>
                                                                        <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">free disulfide and other bound</rdf:first>
                                                                        <rdf:rest>
                                                                           <rdf:List>
                                                                              <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">disulfide and other bound</rdf:first>
                                                                              <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                                                           </rdf:List>
                                                                        </rdf:rest>
                                                                     </rdf:List>
                                                                  </rdf:rest>
                                                               </rdf:List>
                                                            </rdf:rest>
                                                         </rdf:List>
                                                      </rdf:rest>
                                                   </rdf:List>
                                                </rdf:rest>
                                             </rdf:List>
                                          </rdf:rest>
                                       </rdf:List>
                                    </rdf:rest>
                                 </rdf:List>
                              </rdf:rest>
                           </rdf:List>
                        </rdf:rest>
                     </rdf:List>
                  </rdf:rest>
               </rdf:List>
            </owl:oneOf>
         </owl:DataRange>
      </rdfs:range>
      <rdfs:comment xml:lang="en">

Description of the state of the thiol groups in the molecular system.

all disulfide bound
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Assembly.Thiol_state"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="assembly.entry_id">
      <rdfs:subPropertyOf rdf:resource="#assemblyItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>assembly.entry_id</rdfs:label>
      <rdfs:comment xml:lang="en">

Pointer to '_Entry.ID'
                     </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Assembly.Entry_ID"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="assembly.id">
      <rdfs:subPropertyOf rdf:resource="#assemblyItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
      <rdfs:label>assembly.id</rdfs:label>
      <rdfs:comment xml:lang="en">

A code that uniquely identifies the molecular assembly described in the
saveframe.
                     </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Assembly.ID"/>
   </owl:DatatypeProperty>
   <owl:Class rdf:ID="assembly_annotation_listCategory">
      <rdfs:subClassOf>
         <owl:Class>
            <owl:intersectionOf rdf:parseType="Collection">
               <owl:Class rdf:about="#Category"/>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#has_assembly_annotation_list"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
            </owl:intersectionOf>
         </owl:Class>
      </rdfs:subClassOf>
   </owl:Class>
   <owl:Class rdf:ID="assembly_annotation_list">
      <rdfs:label>assembly_annotation_list</rdfs:label>
