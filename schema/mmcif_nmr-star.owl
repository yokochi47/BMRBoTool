   <owl:DatatypeProperty rdf:ID="citation.cas_abstract_code">
      <rdfs:subPropertyOf rdf:resource="#citationItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>citation.cas_abstract_code</rdfs:label>
      <rdfs:comment xml:lang="en">

Code from the Chemical Abstract Services assigned to this citation.
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Citation.CAS_abstract_code"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="citation.class">
      <rdfs:subPropertyOf rdf:resource="#citationItem"/>
      <rdfs:domain rdf:resource="#citation"/>
      <rdfs:range>
         <owl:DataRange>
            <owl:oneOf>
               <rdf:List>
                  <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">entry citation</rdf:first>
                  <rdf:rest>
                     <rdf:List>
                        <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">reference citation</rdf:first>
                        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                     </rdf:List>
                  </rdf:rest>
               </rdf:List>
            </owl:oneOf>
         </owl:DataRange>
      </rdfs:range>
      <rdfs:comment xml:lang="en">

Keyword defining the citation as the key citation for the entry or a citation
used as a referenece in the entry.

entry citation
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Citation.Class"/>
   </owl:DatatypeProperty>
