      <rdfs:label>chem_comp_assembly.entity_assembly_id</rdfs:label>
      <rdfs:comment xml:lang="en">

Pointer to '_Entity_assembly.ID'
                     </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Chem_comp_assembly.Entity_assembly_ID"/>
