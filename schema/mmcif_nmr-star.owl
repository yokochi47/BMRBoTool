      <rdfs:label>studyCategory</rdfs:label>
      <rdfs:comment xml:lang="en">
	This property indicates that studyCategory.
	has a category study.
      </rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#hasCategoryElement"/>
      <rdfs:seeAlso rdf:resource="#study"/>
