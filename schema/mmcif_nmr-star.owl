      <owl:equivalentProperty rdf:resource="PDBo:pdbx_nmr_chem_shift_reference.id"/>
   </owl:DatatypeProperty>
   <owl:Class rdf:ID="chem_shift_softwareCategory">
      <rdfs:subClassOf>
         <owl:Class>
            <owl:intersectionOf rdf:parseType="Collection">
