      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>nmr_expt_systematic_name.entry_id</rdfs:label>
      <rdfs:comment xml:lang="en">

Pointer to '_Entry.ID'
                     </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_NMR_expt_systematic_name.Entry_ID"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="nmr_expt_systematic_name.name">
      <rdfs:subPropertyOf rdf:resource="#nmr_expt_systematic_nameItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>nmr_expt_systematic_name.name</rdfs:label>
      <rdfs:comment xml:lang="en">

Name for the NMR experiment as defined by a systematic naming system.
                     </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_NMR_expt_systematic_name.Name"/>
