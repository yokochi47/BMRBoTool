      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
      <rdfs:label>entity.db_query_revised_last_date</rdfs:label>
      <rdfs:comment xml:lang="en">

Last date that the table of related database entries was last updated.
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Entity.DB_query_revised_last_date"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="entity.details">
