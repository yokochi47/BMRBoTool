      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>entity.name</rdfs:label>
      <rdfs:comment xml:lang="en">

A brief name commonly used for the entity.
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Entity.Name"/>
      <owl:equivalentProperty rdf:resource="PDBo:chem_comp.id"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="entity.nonpolymer_comp_id">
