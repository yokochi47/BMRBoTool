                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Chem_comp.Stereochem_param_file_name"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="chem_comp.struct_file_format">
      <rdfs:subPropertyOf rdf:resource="#chem_compItem"/>
