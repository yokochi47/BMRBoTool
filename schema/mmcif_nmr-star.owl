                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Sample_component.Isotopic_labeling"/>
      <owl:equivalentProperty rdf:resource="PDBo:pdbx_nmr_exptl_sample.isotopic_labeling"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="sample_component.mol_common_name">
