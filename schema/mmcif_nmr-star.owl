The data format used to represent the chemical shift data for molecular
interaction observations as ASCII text in the text block that is the value to the
'_Chem_shift_perturbation_list.Text_data' tag.
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Chem_shift_perturbation_list.Text_data_format"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="chem_shift_perturbation_list.type">
      <rdfs:subPropertyOf rdf:resource="#chem_shift_perturbation_listItem"/>
      <rdfs:domain rdf:resource="#chem_shift_perturbation_list"/>
      <rdfs:range>
         <owl:DataRange>
            <owl:oneOf>
               <rdf:List>
                  <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">macromolecular binding</rdf:first>
                  <rdf:rest>
                     <rdf:List>
                        <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ligand binding</rdf:first>
                        <rdf:rest>
                           <rdf:List>
                              <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ligand fragment binding</rdf:first>
                              <rdf:rest>
                                 <rdf:List>
                                    <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">paramagnetic ligand binding</rdf:first>
                                    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                 </rdf:List>
                              </rdf:rest>
                           </rdf:List>
                        </rdf:rest>
                     </rdf:List>
                  </rdf:rest>
               </rdf:List>
            </owl:oneOf>
         </owl:DataRange>
      </rdfs:range>
      <rdfs:comment xml:lang="en">

The type of chemical shift perturbation reported.
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Chem_shift_perturbation_list.Type"/>
   </owl:DatatypeProperty>
