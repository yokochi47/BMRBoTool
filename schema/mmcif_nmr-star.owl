Pointer to '_Conformer_family_coord_set.ID'
                     </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Atom_site.Conformer_family_coord_set_ID"/>
   </owl:DatatypeProperty>
