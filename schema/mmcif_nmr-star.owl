      <rdfs:label>atom_site.pdbx_label_entity_id</rdfs:label>
      <rdfs:comment xml:lang="en">

This data item is provided as a place holder for the label_entity_ID value
extracted from a pdbx file.

1
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Atom_site.PDBX_label_entity_ID"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="atom_site.pdbx_label_seq_id">
      <rdfs:subPropertyOf rdf:resource="#atom_siteItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
      <rdfs:label>atom_site.pdbx_label_seq_id</rdfs:label>
      <rdfs:comment xml:lang="en">

Residue sequence number assigned by the PDB and extracted from the PDB entry.

1
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Atom_site.PDBX_label_seq_ID"/>
      <owl:equivalentProperty rdf:resource="PDBo:atom_site.pdbx_pdb_residue_no"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="atom_site.type_symbol">
      <rdfs:subPropertyOf rdf:resource="#atom_siteItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>atom_site.type_symbol</rdfs:label>
      <rdfs:comment xml:lang="en">

The value for this tag is a standard IUPAC abbreviation for an element
(i.e., H, C, P, etc).
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Atom_site.Type_symbol"/>
      <owl:equivalentProperty rdf:resource="PDBo:atom_site.type_symbol"/>
   </owl:DatatypeProperty>
