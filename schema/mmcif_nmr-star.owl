      <rdfs:label>cs_anisotropyItem</rdfs:label>
      <rdfs:comment xml:lang="en">Abstract datatype property for cs_anisotropy items.</rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#categoryItem"/>
      <rdfs:domain rdf:resource="#cs_anisotropy"/>
   </owl:DatatypeProperty>
