      <rdfs:subClassOf>
         <owl:Class>
            <owl:intersectionOf rdf:parseType="Collection">
               <owl:Class rdf:about="#Category"/>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#has_conformer_stat_list_ens"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
            </owl:intersectionOf>
         </owl:Class>
      </rdfs:subClassOf>
   </owl:Class>
   <owl:Class rdf:ID="conformer_stat_list_ens">
      <rdfs:label>conformer_stat_list_ens</rdfs:label>
      <rdfs:comment xml:lang="en">

Items in the conformer_stat_list_ens category provide statistical measures describing the characteristics and quality of the ensemble of conformers provided in the entry.

         </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tag.php?tagcat=Conformer_stat_list_ens"/>
      <rdfs:subClassOf>
