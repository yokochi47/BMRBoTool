      <rdfs:label>pb_char.pdb_residue_name</rdfs:label>
      <rdfs:comment xml:lang="en">

PDB residue name.

TYR
                        </rdfs:comment>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="pb_char.pdb_residue_no">
      <rdfs:subPropertyOf rdf:resource="#pb_charItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>pb_char.pdb_residue_no</rdfs:label>
      <rdfs:comment xml:lang="en">

PDB residue number.

6
                        </rdfs:comment>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="pb_char.pdb_strand_id">
      <rdfs:subPropertyOf rdf:resource="#pb_charItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>pb_char.pdb_strand_id</rdfs:label>
      <rdfs:comment xml:lang="en">

PDB strand id.

A
                        </rdfs:comment>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="pb_char.sf_id">
      <rdfs:subPropertyOf rdf:resource="#pb_charItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
      <rdfs:label>pb_char.sf_id</rdfs:label>
      <rdfs:comment xml:lang="en">

Pointer to '_PB_annotation.Sf_ID'
                        </rdfs:comment>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="pb_char.entry_id">
      <rdfs:subPropertyOf rdf:resource="#pb_charItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>pb_char.entry_id</rdfs:label>
      <rdfs:comment xml:lang="en">

Pointer to '_Entry.ID'
                     </rdfs:comment>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="pb_char.id">
      <rdfs:subPropertyOf rdf:resource="#pb_charItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
      <rdfs:label>pb_char.id</rdfs:label>
      <rdfs:comment xml:lang="en">

Unique identifier for each calculated Protein Blocks code.
                     </rdfs:comment>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="pb_char.pb_list_id">
      <rdfs:subPropertyOf rdf:resource="#pb_charItem"/>
