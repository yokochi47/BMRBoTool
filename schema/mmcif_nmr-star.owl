A descriptive name that uniquely identifies this set of sample conditions
within the entry.
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Sample_condition_list.Name"/>
   </owl:DatatypeProperty>
