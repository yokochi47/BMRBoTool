         <owl:DataRange>
            <owl:oneOf>
               <rdf:List>
                  <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">RDC</rdf:first>
                  <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
               </rdf:List>
            </owl:oneOf>
         </owl:DataRange>
      </rdfs:range>
      <rdfs:comment xml:lang="en">

The source of the restraints (e.g. 'noe', 'hbond', 'measured'.
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_RDC_constraint_list.Constraint_type"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="rdc_constraint_list.data_file_format">
      <rdfs:subPropertyOf rdf:resource="#rdc_constraint_listItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>rdc_constraint_list.data_file_format</rdfs:label>
      <rdfs:comment xml:lang="en">

File format for the deposited residual dipolar coupling restraints.

XPLOR
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_RDC_constraint_list.Data_file_format"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="rdc_constraint_list.details">
      <rdfs:subPropertyOf rdf:resource="#rdc_constraint_listItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>rdc_constraint_list.details</rdfs:label>
      <rdfs:comment xml:lang="en">

Text description providing additional information about the reported residual
dipolar coupling constraints.
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_RDC_constraint_list.Details"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="rdc_constraint_list.dipolar_constraint_calib_method">
      <rdfs:subPropertyOf rdf:resource="#rdc_constraint_listItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>rdc_constraint_list.dipolar_constraint_calib_method</rdfs:label>
      <rdfs:comment xml:lang="en">

Method used to calibrate the values for the residual dipolar coupling constraints.
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_RDC_constraint_list.Dipolar_constraint_calib_method"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="rdc_constraint_list.general_order_param_int_motions">
      <rdfs:subPropertyOf rdf:resource="#rdc_constraint_listItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
      <rdfs:label>rdc_constraint_list.general_order_param_int_motions</rdfs:label>
      <rdfs:comment xml:lang="en">

The residual dipolar coupling provides geometric information relative to
a common alignment frame. The value for the item General_order_param_int_motions
is S, the local order parameter for internal motions.
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_RDC_constraint_list.General_order_param_int_motions"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="rdc_constraint_list.mol_align_tensor_axial_sym_mol">
      <rdfs:subPropertyOf rdf:resource="#rdc_constraint_listItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
      <rdfs:label>rdc_constraint_list.mol_align_tensor_axial_sym_mol</rdfs:label>
      <rdfs:comment xml:lang="en">

The residual dipolar coupling provides geometric information relative to
a common alignment frame. The value for the item Mol_align_tensor_axial_sym_mol
is the axial symmetric component of the alignment tensor (1/3(Azz-(Axx+Ayy)/2).
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_RDC_constraint_list.Mol_align_tensor_axial_sym_mol"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="rdc_constraint_list.mol_align_tensor_rhombic_mol">
      <rdfs:subPropertyOf rdf:resource="#rdc_constraint_listItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
      <rdfs:label>rdc_constraint_list.mol_align_tensor_rhombic_mol</rdfs:label>
      <rdfs:comment xml:lang="en">

The residual dipolar coupling provides geometric information relative to
a common alignment frame. The value for the item Mol_align_tensor_rhombic_mol
is the rhombic component of the alignment tensor (1/3(Axx-Ayy)).
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_RDC_constraint_list.Mol_align_tensor_rhombic_mol"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="rdc_constraint_list.name">
      <rdfs:subPropertyOf rdf:resource="#rdc_constraint_listItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>rdc_constraint_list.name</rdfs:label>
      <rdfs:comment xml:lang="en">

A name assigned to the save frame.
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_RDC_constraint_list.Name"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="rdc_constraint_list.potential_type">
      <rdfs:subPropertyOf rdf:resource="#rdc_constraint_listItem"/>
      <rdfs:domain rdf:resource="#rdc_constraint_list"/>
      <rdfs:range>
         <owl:DataRange>
            <owl:oneOf>
               <rdf:List>
                  <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">log-harmonic</rdf:first>
                  <rdf:rest>
                     <rdf:List>
                        <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">parabolic</rdf:first>
                        <rdf:rest>
                           <rdf:List>
                              <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">square-well-parabolic</rdf:first>
                              <rdf:rest>
                                 <rdf:List>
                                    <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">square-well-parabolic-linear</rdf:first>
                                    <rdf:rest>
                                       <rdf:List>
                                          <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">upper-bound-parabolic</rdf:first>
                                          <rdf:rest>
                                             <rdf:List>
                                                <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">lower-bound-parabolic</rdf:first>
                                                <rdf:rest>
                                                   <rdf:List>
                                                      <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">upper-bound-parabolic-linear</rdf:first>
                                                      <rdf:rest>
                                                         <rdf:List>
                                                            <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">lower-bound-parabolic-linear</rdf:first>
                                                            <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                                         </rdf:List>
                                                      </rdf:rest>
                                                   </rdf:List>
                                                </rdf:rest>
                                             </rdf:List>
                                          </rdf:rest>
                                       </rdf:List>
                                    </rdf:rest>
                                 </rdf:List>
                              </rdf:rest>
                           </rdf:List>
                        </rdf:rest>
                     </rdf:List>
                  </rdf:rest>
               </rdf:List>
            </owl:oneOf>
         </owl:DataRange>
      </rdfs:range>
      <rdfs:comment xml:lang="en">

The potential type used to model the residual dipolar coupling restraints.
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_RDC_constraint_list.Potential_type"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="rdc_constraint_list.sf_category">
      <rdfs:subPropertyOf rdf:resource="#rdc_constraint_listItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>rdc_constraint_list.sf_category</rdfs:label>
      <rdfs:comment xml:lang="en">

Category definition for the information content of the saveframe
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_RDC_constraint_list.Sf_category"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="rdc_constraint_list.sf_framecode">
      <rdfs:subPropertyOf rdf:resource="#rdc_constraint_listItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>rdc_constraint_list.sf_framecode</rdfs:label>
      <rdfs:comment xml:lang="en">

A label for the saveframe that describes in very brief terms the information
contained in the saveframe.
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_RDC_constraint_list.Sf_framecode"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="rdc_constraint_list.tensor_auth_asym_id">
      <rdfs:subPropertyOf rdf:resource="#rdc_constraint_listItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>rdc_constraint_list.tensor_auth_asym_id</rdfs:label>
      <rdfs:comment xml:lang="en">

An alternative identifier for Asym_ID that may be provided by an author.
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_RDC_constraint_list.Tensor_auth_asym_ID"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="rdc_constraint_list.tensor_auth_comp_id">
      <rdfs:subPropertyOf rdf:resource="#rdc_constraint_listItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>rdc_constraint_list.tensor_auth_comp_id</rdfs:label>
      <rdfs:comment xml:lang="en">

An alternative identifier for Comp_ID that may be provided by an author
in order to match that used in the publication that describes the experimental data.
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_RDC_constraint_list.Tensor_auth_comp_ID"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="rdc_constraint_list.tensor_auth_entity_assembly_id">
      <rdfs:subPropertyOf rdf:resource="#rdc_constraint_listItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>rdc_constraint_list.tensor_auth_entity_assembly_id</rdfs:label>
      <rdfs:comment xml:lang="en">

An alternative identifier for Entity_assembly_ID that may be provided by
an author in order to match that used in the publication that describes the experimental
data.  Note that the value is not required to be a number.
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_RDC_constraint_list.Tensor_auth_entity_assembly_ID"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="rdc_constraint_list.tensor_auth_seq_id">
      <rdfs:subPropertyOf rdf:resource="#rdc_constraint_listItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>rdc_constraint_list.tensor_auth_seq_id</rdfs:label>
      <rdfs:comment xml:lang="en">

An alternative identifier for Seq_ID that may be provided by an author
in order to match that used in the publication that describes the experimental data.
Note that the value is not required to be a number and does not need to correspond
to the value for Seq_ID or Comp_index_ID.
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_RDC_constraint_list.Tensor_auth_seq_ID"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="rdc_constraint_list.tensor_comp_id">
      <rdfs:subPropertyOf rdf:resource="#rdc_constraint_listItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>rdc_constraint_list.tensor_comp_id</rdfs:label>
      <rdfs:comment xml:lang="en">

Pointer to '_Chem_comp.ID'
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_RDC_constraint_list.Tensor_comp_ID"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="rdc_constraint_list.tensor_comp_index_id">
      <rdfs:subPropertyOf rdf:resource="#rdc_constraint_listItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
      <rdfs:label>rdc_constraint_list.tensor_comp_index_id</rdfs:label>
      <rdfs:comment xml:lang="en">

Pointer to '_Entity_comp_index.ID'
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_RDC_constraint_list.Tensor_comp_index_ID"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="rdc_constraint_list.tensor_entity_assembly_id">
      <rdfs:subPropertyOf rdf:resource="#rdc_constraint_listItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
      <rdfs:label>rdc_constraint_list.tensor_entity_assembly_id</rdfs:label>
      <rdfs:comment xml:lang="en">

Pointer to '_Entity_assembly.ID'
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_RDC_constraint_list.Tensor_entity_assembly_ID"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="rdc_constraint_list.tensor_magnitude">
      <rdfs:subPropertyOf rdf:resource="#rdc_constraint_listItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
      <rdfs:label>rdc_constraint_list.tensor_magnitude</rdfs:label>
      <rdfs:comment xml:lang="en">

The magnitude orientational parameter for the tensor.
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_RDC_constraint_list.Tensor_magnitude"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="rdc_constraint_list.tensor_rhombicity">
      <rdfs:subPropertyOf rdf:resource="#rdc_constraint_listItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
      <rdfs:label>rdc_constraint_list.tensor_rhombicity</rdfs:label>
      <rdfs:comment xml:lang="en">

The rhombicity orientational parameter for the tensor.
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_RDC_constraint_list.Tensor_rhombicity"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="rdc_constraint_list.tensor_seq_id">
      <rdfs:subPropertyOf rdf:resource="#rdc_constraint_listItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
      <rdfs:label>rdc_constraint_list.tensor_seq_id</rdfs:label>
      <rdfs:comment xml:lang="en">

Pointer to '_Entity_poly_seq.Num'
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_RDC_constraint_list.Tensor_seq_ID"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="rdc_constraint_list.text_data">
      <rdfs:subPropertyOf rdf:resource="#rdc_constraint_listItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>rdc_constraint_list.text_data</rdfs:label>
      <rdfs:comment xml:lang="en">

A set of residual dipolar coupling data formatted as ASCII text.
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_RDC_constraint_list.Text_data"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="rdc_constraint_list.text_data_format">
      <rdfs:subPropertyOf rdf:resource="#rdc_constraint_listItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>rdc_constraint_list.text_data_format</rdfs:label>
      <rdfs:comment xml:lang="en">

The data format used to represent the residual dipolar coupling data as
ASCII text in the text block that is the value to the '_RDC_constraint_list.Text_data'
tag.
                        </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_RDC_constraint_list.Text_data_format"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="rdc_constraint_list.entry_id">
      <rdfs:subPropertyOf rdf:resource="#rdc_constraint_listItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <rdfs:label>rdc_constraint_list.entry_id</rdfs:label>
      <rdfs:comment xml:lang="en">

Pointer to '_Entry.ID'
                     </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_RDC_constraint_list.Entry_ID"/>
   </owl:DatatypeProperty>
   <owl:DatatypeProperty rdf:ID="rdc_constraint_list.id">
      <rdfs:subPropertyOf rdf:resource="#rdc_constraint_listItem"/>
      <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
      <rdfs:label>rdc_constraint_list.id</rdfs:label>
      <rdfs:comment xml:lang="en">

Unique identifier for the list of reported residual dipolar coupling constraints.
                     </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_RDC_constraint_list.ID"/>
   </owl:DatatypeProperty>
   <owl:Class rdf:ID="rdc_constraint_parse_errCategory">
      <rdfs:subClassOf>
         <owl:Class>
            <owl:intersectionOf rdf:parseType="Collection">
               <owl:Class rdf:about="#Category"/>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#has_rdc_constraint_parse_err"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
            </owl:intersectionOf>
         </owl:Class>
      </rdfs:subClassOf>
   </owl:Class>
   <owl:Class rdf:ID="rdc_constraint_parse_err">
      <rdfs:label>rdc_constraint_parse_err</rdfs:label>
      <rdfs:comment xml:lang="en">

Items in the RDC_constraint_parse_err category define the content and position of a segment of a residual dipolar coupling constraint file that could not be parsed into NMR-STAR format.

         </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tag.php?tagcat=RDC_constraint_parse_err"/>
      <rdfs:subClassOf>
         <owl:Class>
            <owl:intersectionOf rdf:parseType="Collection">
               <owl:Class rdf:about="#CategoryElement"/>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#rdc_constraint_parse_err.begin_column"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#rdc_constraint_parse_err.begin_column"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#rdc_constraint_parse_err.begin_line"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#rdc_constraint_parse_err.begin_line"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#rdc_constraint_parse_err.content"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#rdc_constraint_parse_err.content"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#rdc_constraint_parse_err.end_column"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#rdc_constraint_parse_err.end_column"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#rdc_constraint_parse_err.end_line"/>
                  <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#rdc_constraint_parse_err.end_line"/>
                  <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#rdc_constraint_parse_err.entry_id"/>
                  <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#rdc_constraint_parse_err.id"/>
                  <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
               </owl:Restriction>
               <owl:Restriction>
                  <owl:onProperty rdf:resource="#rdc_constraint_parse_err.rdc_constraint_list_id"/>
                  <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
               </owl:Restriction>
            </owl:intersectionOf>
         </owl:Class>
      </rdfs:subClassOf>
   </owl:Class>
   <owl:InverseFunctionalProperty rdf:ID="has_rdc_constraint_parse_errCategory">
      <rdfs:label>rdc_constraint_parse_errCategory</rdfs:label>
      <rdfs:comment xml:lang="en">
	This property indicates that datablock
	has a category holder rdc_constraint_parse_errCategory.
      </rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#hasCategory"/>
      <rdfs:seeAlso rdf:resource="#rdc_constraint_parse_err"/>
   </owl:InverseFunctionalProperty>
   <owl:InverseFunctionalProperty rdf:ID="has_rdc_constraint_parse_err">
      <rdfs:label>rdc_constraint_parse_errCategory</rdfs:label>
      <rdfs:comment xml:lang="en">
	This property indicates that rdc_constraint_parse_errCategory.
	has a category rdc_constraint_parse_err.
      </rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#hasCategoryElement"/>
      <rdfs:seeAlso rdf:resource="#rdc_constraint_parse_err"/>
      <rdfs:domain rdf:resource="#rdc_constraint_parse_errCategory"/>
      <rdfs:range rdf:resource="#rdc_constraint_parse_err"/>
   </owl:InverseFunctionalProperty>
   <owl:DatatypeProperty rdf:ID="rdc_constraint_parse_errItem">
      <rdfs:label>rdc_constraint_parse_errItem</rdfs:label>
      <rdfs:comment xml:lang="en">Abstract datatype property for rdc_constraint_parse_err items.</rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#categoryItem"/>
      <rdfs:domain rdf:resource="#rdc_constraint_parse_err"/>
   </owl:DatatypeProperty>
   <owl:ObjectProperty rdf:ID="reference_to_rdc_constraint_parse_err">
      <rdfs:label>reference_to_rdc_constraint_parse_err</rdfs:label>
      <rdfs:comment xml:lang="en">cross-reference to rdc_constraint_parse_err.</rdfs:comment>
      <rdfs:subPropertyOf rdf:resource="#reference_to"/>
