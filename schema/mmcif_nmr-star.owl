      <rdfs:label>chem_shift_ref.chem_shift_reference_id</rdfs:label>
      <rdfs:comment xml:lang="en">

Pointer to '_Chem_shift_reference.ID'
                     </rdfs:comment>
      <rdfs:seeAlso rdf:resource="https://bmrb.io/dictionary/tagdetail.php?tag=_Chem_shift_ref.Chem_shift_reference_ID"/>
